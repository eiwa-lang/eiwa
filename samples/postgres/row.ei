// postgres/row.ei — PgRow: concrete row type.
//
// Fields are stored as Eiwa strings (copied eagerly from the PGresult*).
// Column access is by name via linear search — acceptable for the typical
// number of columns in a result set.

import { Row } from "std.db"

type PgRow(
    val columnNames: List<String>,
    val values: List<String>,
    val nullFlags: List<Bool>
) : Row {

    fun indexOf(name: String): Int {
        var i = 0
        while (i < columnNames.size()) {
            if (columnNames.get(i) == name) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    implement fun string(name: String): String {
        val idx = indexOf(name)
        if (idx < 0) { return "" }
        return values.get(idx)
    }

    implement fun int(name: String): Int {
        val s = string(name)
        if (s.length == 0) { return 0 }
        var result = 0
        var i = 0
        var neg = false
        if (s.length > 0 && s.substring(0, 1) == "-") {
            neg = true
            i = 1
        }
        while (i < s.length) {
            val ch = s.substring(i, i + 1)
            if (ch == "0") { result = result * 10 + 0 }
            else if (ch == "1") { result = result * 10 + 1 }
            else if (ch == "2") { result = result * 10 + 2 }
            else if (ch == "3") { result = result * 10 + 3 }
            else if (ch == "4") { result = result * 10 + 4 }
            else if (ch == "5") { result = result * 10 + 5 }
            else if (ch == "6") { result = result * 10 + 6 }
            else if (ch == "7") { result = result * 10 + 7 }
            else if (ch == "8") { result = result * 10 + 8 }
            else if (ch == "9") { result = result * 10 + 9 }
            i = i + 1
        }
        if (neg) {
            return -result
        } else {
            return result
        }
    }

    implement fun double(name: String): Double {
        val s = string(name)
        if (s.length == 0) { return 0.0 }
        return s.toDouble()
    }

    implement fun bool(name: String): Bool {
        val s = string(name)
        return s == "t" || s == "true" || s == "1" || s == "yes" || s == "on"
    }

    implement fun isNull(name: String): Bool {
        val idx = indexOf(name)
        if (idx < 0) { return true }
        return nullFlags.get(idx)
    }
}
