// postgres/connection.ei — PgConnection: concrete database connection.
//
// Uses libpq async API for no-param queries:
//   PQsendQuery → PQsocket → EventLoop.waitReadable(fd) → PQconsumeInput → PQgetResult
//
// Parameterized queries use the synchronous wrapper eiwa_pq_exec_params
// which converts List<String> to char** and calls PQexecParams.

import { Standard, NativeString } from "std.core"
import { DbError, Connection, Statement, Result } from "std.db"
import { NativePg, PgStatus } from "./native"
import { EventLoop } from "std.coroutines"
import { PgResult } from "./result"
import { PgStatement } from "./statement"
import { Log } from "std.log"

type PgConnection(val conn: Pointer, var closed: Bool = false): Connection, Closeable {

    fun checkOpen() {
        if (closed) {
            throw DbError("Connection is closed")
        }
    }

    // Async path for no-param queries: yields the fiber until socket is ready.
    fun asyncQuery(sql: String): Pointer {
        checkOpen()
        val fd = NativePg.socket(conn)
        NativePg.sendQuery(conn, sql.ptr)
        EventLoop.waitReadable(fd)
        NativePg.consumeInput(conn)
        while (NativePg.isBusy(conn) != 0) {
            EventLoop.waitReadable(fd)
            NativePg.consumeInput(conn)
        }
        var raw = NativePg.getResult(conn)
        var extra = NativePg.getResult(conn)
        while (extra != null) {
            NativePg.clear(extra)
            extra = NativePg.getResult(conn)
        }
        return raw
    }

    implement fun execute(sql: String, params: List<String> = []): Result {
        checkOpen()
        if (params.size() == 0) {
            return PgResult.fromNative(asyncQuery(sql), conn)
        }
        return PgResult.fromNative(NativePg.execParams(conn, sql.ptr, params), conn)
    }

    implement fun query(sql: String, params: List<String> = []): Result {
        checkOpen()
        if (params.size() == 0) {
            return PgResult.fromNative(asyncQuery(sql), conn)
        }
        return PgResult.fromNative(NativePg.execParams(conn, sql.ptr, params), conn)
    }

    // Count $1 .. $N parameters in a SQL string for PQprepare/PQexecPrepared.
    fun countSqlParams(sql: String): Int {
        var count = 0
        var i = 0
        val len = sql.length
        while (i < len) {
            val c = NativeMemory.readByte(sql.ptr, i)
            if (c == 36) { // '$' = ASCII 36
                i = i + 1
                // Skip any following digits
                var skip = true
                while (skip && i < len) {
                    val d = NativeMemory.readByte(sql.ptr, i)
                    if (d >= 48 && d <= 57) { // '0'..'9'
                        i = i + 1
                    } else {
                        skip = false
                    }
                }
                count = count + 1
            } else {
                i = i + 1
            }
        }
        return count
    }

    implement fun prepare(sql: String): Statement {
        checkOpen()
        val stmtName = "eiwa_stmt_" + sql.hashCode().toString()
        val nparams = countSqlParams(sql)
        val raw = NativePg.prepare(conn, stmtName.ptr, sql.ptr, nparams, null)
        if (raw != null) {
            if (NativePg.resultStatus(raw) == PgStatus.PGRES_FATAL_ERROR) {
                val errPtr = NativePg.errorMessage(conn)
                val errMsg = String(errPtr, 256)
                NativePg.clear(raw)
                throw DbError(errMsg)
            }
            NativePg.clear(raw)
        }
        return PgStatement(conn, stmtName)
    }

    implement fun close() {
        if (closed) {
            return
        }
        closed = true
        Log.debug {"Closing connection"}
        NativePg.finish(conn)
    }
}
