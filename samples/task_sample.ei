fun fetchUsers(): List<String> {
    return ["Alice", "Bob", "Charlie"]
}

fun fetchConfig(): Map<String, String> {
    return [
        "host" of "localhost",
        "port" of "8080"
    ]
}

fun main() {
    echo("--- Task Sample ---")

    val usersTask = task { 
        fetchUsers()
    }
    val configTask = task { 
        fetchConfig()
    }

    val users = usersTask.await()
    val config = configTask.await()

    echo("Users: " + users.toString())
    echo("Config: " + config.toString())

    // Nested tasks
    val nestedTask = task {
        val inner = task { 42 }
        inner.await() * 2
    }

    val result = nestedTask.await()
    assert(result == 84)

    echo("All tasks completed successfully.")
}
