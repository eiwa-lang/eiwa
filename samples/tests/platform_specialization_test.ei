// Test platform specialization and fallback behavior

contract Greeting {
    fun greet(): String
}

object("windows") Greeter : Greeting {
    implement fun greet(): String = "Hello from Windows"
}

object("posix") Greeter : Greeting {
    implement fun greet(): String = "Hello from POSIX"
}

contract PlatformConfig {
    fun platformName(): String
}

object("windows") PlatformSpecificConfig : PlatformConfig {
    implement fun platformName(): String = "Win32"
}

// Fallback universal for non-Windows
object PlatformSpecificConfig : PlatformConfig {
    implement fun platformName(): String = "Universal/Default"
}

contract ExpectedPlatformContract {
    fun greeting(): String
    fun config(): String
}

object("windows") ExpectedPlatform : ExpectedPlatformContract {
    implement fun greeting(): String = "Hello from Windows"
    implement fun config(): String = "Win32"
}

object("posix") ExpectedPlatform : ExpectedPlatformContract {
    implement fun greeting(): String = "Hello from POSIX"
    implement fun config(): String = "Universal/Default"
}

object ExpectedPlatform : ExpectedPlatformContract {
    implement fun greeting(): String = "Hello from POSIX"
    implement fun config(): String = "Universal/Default"
}

test "platform specialized object resolution" {
    val greeting = Greeter.greet()
    assert(greeting == ExpectedPlatform.greeting(), "Should resolve platform specialized object")
}

test "platform fallback resolution" {
    val name = PlatformSpecificConfig.platformName()
    assert(name == ExpectedPlatform.config(), "Should resolve platform config or universal fallback")
}
