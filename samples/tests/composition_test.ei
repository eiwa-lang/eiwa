// Composition Type System Tests (Phase 41 / ADR 25)

contract Drawable {
    fun draw(): String
}

skill Shadow : Drawable {

    fun render(): String {
        return draw() + " + shadow"
    }

}

skill MouseInput {

    fun click(): String {
        return "mouse click"
    }

}

skill TouchInput {

    fun click(): String {
        return "touch click"
    }

}

type Button(val label: String)
    : Drawable
    + Shadow
    + MouseInput
    + TouchInput {

    implement fun draw(): String {
        return "draw " + label
    }

    // Explicit conflict resolution between MouseInput and TouchInput
    implement fun click(): String {
        return MouseInput.click()
    }

}

type BoomException(val text: String) : Throwable {

    implement fun message(): String {
        return text
    }

}

fun fail(): Int {
    throw BoomException("boom")
}

test "composition: type implements contract" {
    val button = Button("OK")
    assert(button.draw() == "draw OK")
}

test "composition: skill uses consumer type contract" {
    val button = Button("OK")
    assert(button.render() == "draw OK + shadow")
}

test "composition: skill method conflict resolved explicitly" {
    val button = Button("OK")
    assert(button.click() == "mouse click")
}

test "composition: polymorphism via contract" {
    val d: Drawable = Button("Save")
    assert(d.draw() == "draw Save")
}

contract Transformer<T, R> {
    fun transform(value: T): R
}

skill IntToStringTransformer : Transformer<Int, String> {
    implement fun transform(value: Int): String {
        return "Value: " + value.toString()
    }
}

type NumberFormatter : Transformer<Int, String> + IntToStringTransformer

contract ValueHolder<T> {
    fun getValue(): T
}

skill FormattedHolderSkill : ValueHolder<String> {
    fun getFormatted(): String {
        return "Formatted(" + getValue() + ")"
    }
}

type StringHolder(val content: String) : ValueHolder<String> + FormattedHolderSkill {
    implement fun getValue(): String {
        return content
    }
}

contract Awaitable<T> {
    fun await(): T
}

skill TaskLibaco<T> : Awaitable<T> {
}

test "generic contract with multiple type parameters" {
    val formatter = NumberFormatter()
    val res = formatter.transform(42)
    assert(res == "Value: 42")
}

test "skill requiring generic contract instantiated with concrete type" {
    val holder = StringHolder("eiwa")
    assert(holder.getValue() == "eiwa")
    assert(holder.getFormatted() == "Formatted(eiwa)")
}

test "composition: exception handling via Throwable contract" {
    var caught = ""
    try {
        fail()
    }
    catch (e: Throwable) {
        caught = e.message()
    }
    assert(caught == "boom")
}
