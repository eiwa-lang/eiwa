import { assert } from "std.core"
import { List, MutableList, Map, MutableMap, Set, MutableSet } from "std.collections"

test "List.mut() should return MutableList" {
    val list = [10, 20]
    val mlist = list.mut()
    mlist.add(30)
    assert(mlist.size() == 3)
    assert(mlist[2] == 30)
}

test "MutableList.freeze() should return List" {
    val list = [1, 2, 3]
    val mlist = list.mut()
    mlist.add(4)
    val frozen = mlist.freeze()
    assert(frozen.size() == 4)
    assert(frozen[3] == 4)
}

test "Map.mut() should return MutableMap" {
    val map = ["a" of 1, "b" of 2]
    val mmap = map.mut()
    mmap.put("c", 3)
    assert(mmap.size() == 3)
    assert(mmap["c"] == 3)
}

test "MutableMap.freeze() should return Map" {
    val map = ["a" of 1, "b" of 2]
    val mmap = map.mut()
    mmap.put("c", 3)
    val frozen = mmap.freeze()
    assert(frozen.size() == 3)
    assert(frozen["c"] == 3)
}

test "Set.mut() should return MutableSet" {
    val s = MutableSet<Int>()
    s.add(1)
    s.add(2)
    val frozenSet = s.freeze()
    val mset = frozenSet.mut()
    mset.add(3)
    assert(mset.size() == 3)
    assert(mset.contains(3) == true)
}

test "MutableSet.freeze() should return Set" {
    val mset = MutableSet<Int>()
    mset.add(10)
    mset.add(20)
    val frozen = mset.freeze()
    assert(frozen.size() == 2)
    assert(frozen.contains(10) == true)
    assert(frozen.contains(20) == true)
}