import { assert } from "std.core"

// The stackless coroutine scheduler (Eiwa-pure, intrusive linked-list queue).
// A `Continuation` is a state machine; the compiler will generate these from
// suspend functions (Fase C). Here they are hand-written to prove the runtime.

object Order {
    var log: String = ""

    fun record(s: String) {
        Order.log = Order.log + s
    }

    fun reset() {
        Order.log = ""
    }
}

type PC(val name: String, var step: Int) : Continuation {
    implement fun resume() {
        if (this.step == 0) {
            Order.record("${this.name}A;")
            this.step = 1
            Dispatchers.Single.scheduler.schedule(this)
        } else {
            Order.record("${this.name}B;")
            this.step = 2
        }
    }

    implement fun isDone(): Bool = this.step >= 2
}

test "scheduler runs a continuation to completion" {
    Order.reset()
    Dispatchers.Single.scheduler.schedule(PC("x", 0))
    Dispatchers.Single.scheduler.run()
    assert(Order.log == "xA;xB;")
}

test "scheduler interleaves continuations cooperatively (FIFO)" {
    Order.reset()
    Dispatchers.Single.scheduler.schedule(PC("1", 0))
    Dispatchers.Single.scheduler.schedule(PC("2", 0))
    Dispatchers.Single.scheduler.run()
    assert(Order.log == "1A;2A;1B;2B;")
}

test "scheduler drains a queue left non-empty from a prior run" {
    // Scheduler state is a singleton; ensure no leftover items leak between runs.
    Order.reset()
    Dispatchers.Single.scheduler.schedule(PC("a", 0))
    Dispatchers.Single.scheduler.run()
    Dispatchers.Single.scheduler.run()
    assert(Order.log == "aA;aB;")
}
