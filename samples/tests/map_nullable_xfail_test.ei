// Phase 84 (RED / XFAIL): `MutableMap.contains` conflates a stored `null`
// value with a missing key (`get(key) != null`). `put`/`get` with nullable
// values work (Phase 80 heap-boxing); only key-presence is wrong.
// NOTE: compiling this file prints two scary-but-NON-FATAL checker
// diagnostics (member call on `Int?` in the monomorphized `put` path and a
// `null`-vs-`Node` arg mismatch); the build continues and runs anyway.
// Run: ./bin/eiwac test <this file>
import { assert } from "std.core"
import { MutableMap } from "std.collections"

test "map with nullable value type accepts put" {
    val mp = MutableMap<String, Int?>()
    mp.put("a", 0)
    assert(mp.get("a") == 0)
}

test "map with nullable value type stores null distinctly" {
    val mp = MutableMap<String, Int?>()
    mp.put("a", 0)
    mp.put("b", null)
    assert(mp.get("a") == 0)
    assert(mp.get("b") == null)
    assert(mp.contains("b"))
}
