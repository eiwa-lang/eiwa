import { AssertionException } from "std.core"
import { NativeExc } from "std.thread"

// Custom exceptions via the Throwable contract (no hierarchy)
type CustomException(val text: String) : Throwable {
    implement fun message(): String {
        return this.text
    }
}

type AnotherException(val text: String) : Throwable {
    implement fun message(): String {
        return this.text
    }
}

type ThirdException(val text: String) : Throwable {
    implement fun message(): String {
        return this.text
    }
}

fun throwError(shouldThrow: Bool) {
    if (shouldThrow) {
        throw CustomException("Custom error thrown")
    }
}

fun intermediateFunction(shouldThrow: Bool) {
    throwError(shouldThrow)
}

test "exception: basic throw and catch" {
    var caught = false
    var msg = ""
    try {
        throwError(true)
    } catch (e: CustomException) {
        caught = true
        msg = e.message()
    }

    assert(caught == true)
    assert(msg == "Custom error thrown")
}

test "exception: stack propagation" {
    var caught = false
    try {
        intermediateFunction(true)
    } catch (e: CustomException) {
        caught = true
    }
    assert(caught == true)
}

test "exception: generic catch-all" {
    var caught = false
    try {
        throw AnotherException("oops")
    } catch {
        caught = true
    }
    assert(caught == true)
}

test "exception: multi-catch with union types" {
    var count = 0

    // Test catch of the first type
    try {
        throw CustomException("error 1")
    } catch (e: CustomException | AnotherException) {
        count = count + 1
        assert(e.message() == "error 1")
        assert(e is CustomException)
        assert(e !is AnotherException)
    }

    // Test catch of the second type in the same block
    try {
        throw AnotherException("error 2")
    } catch (e: CustomException | AnotherException) {
        count = count + 1
        assert(e.message() == "error 2")
        assert(e is AnotherException)
        assert(e !is CustomException)
    }

    assert(count == 2)
}

test "exception: rethrow of uncaught error" {
    var caughtLevel2 = false
    try {
        try {
            throw AnotherException("should propagate")
        } catch (e: CustomException) {
            // Should not catch AnotherException
            assert(false)
        }
    } catch (e: Throwable) {
        caughtLevel2 = true
        assert(e.message() == "should propagate")
    }
    assert(caughtLevel2 == true)
}

test "exception: try without catch swallows exceptions" {
    var executed = false
    try {
        throwError(true)
    }
    executed = true
    assert(executed == true)
}

test "exception: catching failed assertions" {
    var caught = false
    try {
        assert(1 == 2)
    } catch (e: AssertionException) {
        caught = true
        assert(e.message() == "Assertion failed")
    }
    assert(caught == true)
}

test "exception: multiple typed catch blocks dispatch correctly" {
    var branchTaken = 0

    // 1. Should be caught by the 1st catch block
    try {
        throw CustomException("first")
    } catch (e: CustomException) {
        branchTaken = 1
        assert(e.message() == "first")
    } catch (e: AnotherException) {
        branchTaken = 2
    } catch (e: ThirdException) {
        branchTaken = 3
    }
    assert(branchTaken == 1)

    // 2. Should skip 1st and be caught by 2nd catch block
    try {
        throw AnotherException("second")
    } catch (e: CustomException) {
        branchTaken = 1
    } catch (e: AnotherException) {
        branchTaken = 2
        assert(e.message() == "second")
    } catch (e: ThirdException) {
        branchTaken = 3
    }
    assert(branchTaken == 2)

    // 3. Should skip 1st and 2nd, caught by 3rd catch block
    try {
        throw ThirdException("third")
    } catch (e: CustomException) {
        branchTaken = 1
    } catch (e: AnotherException) {
        branchTaken = 2
    } catch (e: ThirdException) {
        branchTaken = 3
        assert(e.message() == "third")
    }
    assert(branchTaken == 3)
}

test "exception: multiple catch blocks with union types and generic fallback" {
    var step = 0

    // Matched by union in 1st block
    try {
        throw AnotherException("union match")
    } catch (e: CustomException | AnotherException) {
        step = 1
        assert(e.message() == "union match")
    } catch (e: ThirdException) {
        step = 2
    } catch {
        step = 3
    }
    assert(step == 1)

    // Matched by 2nd block
    try {
        throw ThirdException("second block match")
    } catch (e: CustomException | AnotherException) {
        step = 1
    } catch (e: ThirdException) {
        step = 2
        assert(e.message() == "second block match")
    } catch {
        step = 3
    }
    assert(step == 2)
}


fun earlyReturn(x: Int): Int {
    try {
        if (x > 0) {
            return 1
        }
        return 0
    } catch (e: Throwable) {
        return -1
    }
}

fun nestedReturn(x: Int): Int {
    try {
        try {
            if (x > 0) {
                return 10
            }
            return 20
        } catch (e: Throwable) {
            return 30
        }
    } catch (e: Throwable) {
        return 40
    }
}

fun catchReturn(): Int {
    try {
        throw CustomException("boom")
    } catch (e: CustomException) {
        return 7
    }
}

test "exception: return inside try unwinds the handler frame" {
    val before = NativeExc.excTopGet()
    assert(earlyReturn(5) == 1)
    assert(earlyReturn(-3) == 0)
    assert(NativeExc.excTopGet() == before, "handler frame must be popped on return")
    // A later throw must still reach the nearest live handler (a leaked
    // frame would longjmp into dead stack and segfault instead).
    var caught = false
    try {
        throw CustomException("after-return")
    } catch (e: CustomException) {
        caught = true
        assert(e.message() == "after-return")
    }
    assert(caught == true)
    assert(NativeExc.excTopGet() == before, "handler stack balanced after catch")
}

test "exception: return inside nested try unwinds both frames" {
    val before = NativeExc.excTopGet()
    assert(nestedReturn(5) == 10)
    assert(nestedReturn(-5) == 20)
    assert(NativeExc.excTopGet() == before, "both frames must be popped on return")
    var caught = false
    try {
        throw AnotherException("after-nested-return")
    } catch (e: AnotherException) {
        caught = true
    }
    assert(caught == true)
}

test "exception: return inside catch body stays balanced" {
    val before = NativeExc.excTopGet()
    assert(catchReturn() == 7)
    assert(NativeExc.excTopGet() == before, "catch-entry pop covers return")
}

fun leaveOutOfTry(n: Int): Int {
    var i = 0
    while (i < n) {
        try {
            if (i == 2) {
                leave
            }
            i = i + 1
        } catch (e: Throwable) {
            return -1
        }
    }
    return i
}

fun leaveInsideTry(n: Int): Int {
    var i = 0
    while (i < n) {
        try {
            var j = 0
            while (j < 10) {
                if (j == 3) {
                    leave
                }
                j = j + 1
            }
            i = i + 1
        } catch (e: Throwable) {
            return -1
        }
    }
    return i
}

test "exception: leave out of try unwinds the handler frame" {
    val before = NativeExc.excTopGet()
    assert(leaveOutOfTry(10) == 2)
    assert(NativeExc.excTopGet() == before, "handler frame must be popped on leave")
    var caught = false
    try {
        throw CustomException("after-leave")
    } catch (e: CustomException) {
        caught = true
        assert(e.message() == "after-leave")
    }
    assert(caught == true)
    assert(NativeExc.excTopGet() == before, "handler stack balanced after catch")
}

test "exception: leave inside try keeps the frame" {
    val before = NativeExc.excTopGet()
    assert(leaveInsideTry(10) == 10)
    assert(NativeExc.excTopGet() == before, "no pop when leave stays inside try")
}
