import { assert } from "std.core"
import { MutableMap } from "std.collections"

fun sumToLeave(): Int {
    var total = 0
    var i = 0
    while (i < 10) {
        if (i == 3) {
            leave
        }
        total = total + i
        i = i + 1
    }
    return total
}

test "while with leave stops at limit" {
    assert(sumToLeave() == 3)
}

test "for with leave stops early" {
    val nums = [1, 2, 3, 4, 5]
    var total = 0
    for (nums) { n ->
        if (n == 4) {
            leave
        }
        total = total + n
    }
    assert(total == 6)
}

test "for with leave and implicit it" {
    val nums = [1, 2, 3, 4, 5]
    var total = 0
    for (nums) {
        if (it == 4) {
            leave
        }
        total = total + it
    }
    assert(total == 6)
}

test "for with index stops via leave" {
    val nums = [10, 20, 30, 40]
    var seen = 0
    for (nums) { i, n ->
        if (i == 2) {
            leave
        }
        seen = seen + n
    }
    assert(seen == 30)
}

test "leave exits only the innermost loop" {
    var count = 0
    var i = 0
    while (i < 3) {
        var j = 0
        while (j < 5) {
            if (j == 2) {
                leave
            }
            count = count + 1
            j = j + 1
        }
        i = i + 1
    }
    assert(count == 6)
}

test "lambda leave v returns early value" {
    val f: (Int) -> Int = { x ->
        if (x < 0) {
            leave 0
        }
        x * 2
    }
    assert(f(5) == 10)
    assert(f(-3) == 0)
}

test "lambda trailing expression still works" {
    val g: (Int) -> Int = { x ->
        val base = 10
        base + x
    }
    assert(g(5) == 15)
}

test "leave with value in loop statement exits loop" {
    val nums = [1, 2, 3]
    var total = 0
    for (nums) { n ->
        if (n == 2) {
            leave -1
        }
        total = total + n
    }
    assert(total == 1)
}

test "for over map supports leave" {
    val map = MutableMap<String, Int>()
    map.put("a", 1)
    map.put("b", 2)
    var count = 0
    var sum = 0
    for (map) { entry ->
        if (entry.value != 2) {
            sum = sum + entry.value
            count = count + 1
            if (count == 1) {
                leave
            }
        }
    }
    assert(sum == 1)
    assert(count == 1)
}

fun callLambda(f: () -> Void) {
    f()
}

test "lambda bare leave exits Void lambda early" {
    var executed = false
    callLambda {
        if (true) {
            leave
        }
        executed = true
        assert(true)
    }
    assert(executed == false)
}

test "lambda bare leave not taken falls through" {
    var executed = false
    callLambda {
        if (false) {
            leave
        }
        executed = true
        assert(true)
    }
    assert(executed == true)
}

test "hard break: break is a valid identifier again" {
    val break = 1
    assert(break == 1)
}
