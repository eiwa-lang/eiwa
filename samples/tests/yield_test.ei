import { assert } from "std.core"
import { AtomicInt } from "std.atomic"

test "yield cooperatively interleaves two tasks" {
    val countA = AtomicInt.create(0)
    val countB = AtomicInt.create(0)

    val t1 = task {
        countA.incrementAndGet()
        yield()
        countA.incrementAndGet()
    }
    val t2 = task {
        countB.incrementAndGet()
        yield()
        countB.incrementAndGet()
    }
    t1.await()
    t2.await()
    assert(countA.get() == 2)
    assert(countB.get() == 2)
}

// A task with a suspension point AND a return value: the state-machine path
// must still capture the trailing expression into `task.result` (not just run
// for side effects like a Void task).
fun valueTaskSleep(): Int {
    val t = task {
        var acc = 2
        sleepMs(1)
        acc + 40
    }
    return t.await()
}

test "task with return value and suspension delivers the result" {
    assert(valueTaskSleep() == 42)
}

test "two value-returning tasks interleave and deliver results" {
    val tVal = task {
        yield()
        40 + 1
    }
    val tVal2 = task {
        yield()
        40 + 2
    }
    val r = tVal.await()
    val r2 = tVal2.await()
    assert(r == 41)
    assert(r2 == 42)
}
