import { assert } from "std.core"

test "Int64 boundaries" {
    assert(9223372036854775807.toString() == "9223372036854775807")
    val min = -9223372036854775807 - 1
    assert(min.toString() == "-9223372036854775808")
    assert((-9223372036854775808).toString() == "-9223372036854775808")
    assert(min + 1 == 0 - 9223372036854775807)
    assert(0 - min - 1 == 9223372036854775807)
}
