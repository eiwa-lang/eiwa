// Run: ./bin/eiwac test samples/tests/fs_dir_test.ei
//
// Dir.names lists directory entries (no . / ..) and returns empty
// for unreadable directories instead of throwing.
import { assert } from "std.core"
import { Dir, File } from "std.fs"

test "fs: dir names lists entries" {
    val names = Dir.names("samples/tests")
    assert(names.size() > 10, "many")
    assert(names.contains("serde_defaults_test.ei"), "known-file")
    assert(names.contains(".") == false, "no-dot")
    assert(names.contains("..") == false, "no-dotdot")
}

test "fs: dir names missing dir is empty" {
    assert(Dir.names("no-such-dir").size() == 0, "empty")
}

test "fs: dir mkdir creates single level" {
    val probe = "samples/tests/tmp_mkdir_probe"
    if (Dir.exists(probe)) {
        Dir.delete(probe)
    }
    if (File.exists(probe)) {
        File.delete(probe)
    }
    assert(Dir.mkdir(probe), "created")
    assert(Dir.exists(probe), "exists-after-mkdir")
    assert(Dir.mkdir(probe) == false, "existing-is-false")
    assert(Dir.delete(probe), "cleanup")
    assert(Dir.exists(probe) == false, "gone-after-cleanup")
}
