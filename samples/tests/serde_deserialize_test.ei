import { assert } from "std.core"
import { Serializable } from "std.serde"
import { fromJson, serializeJson } from "std.json"

type User(val id: Int, val name: String, val avatar: String?, val active: Bool) : Serializable
type Team(val name: String, val tags: List<String>, val scores: List<Int>, val members: List<User>) : Serializable

test "serde: automatic static deserialization from json" {
    val jsonStr = "{\"id\": 42, \"name\": \"Alice\", \"active\": true}"
    val user = fromJson<User>(jsonStr)
    assert(user.id == 42)
    assert(user.name != null)
    assert(user.name == "Alice")
    assert(user.active == true)
    assert(user.avatar == null)

    val reencoded = serializeJson(user)
    val user2 = fromJson<User>(reencoded)
    assert(user2.id == user.id)
    assert(user2.name == user.name)
    assert(user2.active == user.active)
    assert(user2.avatar == user.avatar)
}

test "serde: automatic static deserialization from json explicit null" {
    val jsonStr = "{\"id\": 42, \"name\": \"Alice\", \"avatar\": null, \"active\": true}"
    val user = fromJson<User>(jsonStr)
    assert(user.id == 42)
    assert(user.name != null)
    assert(user.name == "Alice")
    assert(user.active == true)
    assert(user.avatar == null)
}

test "serde: collection deserialization and serialization round-trip" {
    val teamJson = "{\"name\": \"CoreTeam\", \"tags\": [\"compiler\", \"systems\"], \"scores\": [10, 20], \"members\": [{\"id\": 1, \"name\": \"Alice\", \"active\": true}, {\"id\": 2, \"name\": \"Bob\", \"active\": false}]}"
    val team = fromJson<Team>(teamJson)
    assert(team.name == "CoreTeam")
    assert(team.tags.size() == 2)
    assert(team.tags[0] == "compiler")
    assert(team.tags[1] == "systems")
    assert(team.scores.size() == 2)
    assert(team.scores[0] == 10)
    assert(team.scores[1] == 20)
    assert(team.members.size() == 2)
    assert(team.members[0].id == 1)
    assert(team.members[0].name == "Alice")
    assert(team.members[0].active == true)
    assert(team.members[1].id == 2)
    assert(team.members[1].name == "Bob")
    assert(team.members[1].active == false)

    val encoded = serializeJson(team)
    val team2 = fromJson<Team>(encoded)
    assert(team2.name == team.name)
    assert(team2.tags.size() == 2)
    assert(team2.tags[0] == "compiler")
    assert(team2.tags[1] == "systems")
    assert(team2.scores.size() == 2)
    assert(team2.scores[0] == 10)
    assert(team2.scores[1] == 20)
    assert(team2.members.size() == 2)
    assert(team2.members[0].name == "Alice")
    assert(team2.members[1].name == "Bob")
}

test "serde: automatic static deserialization from json list" {
    val jsonStr = "[{\"id\": 42, \"name\": \"Alice\", \"active\": true}, {\"id\": 43, \"name\": \"Bob\", \"active\": false}]"
    val users = fromJson<List<User>>(jsonStr)
    assert(users[0].id == 42)
    assert(users[0].name == "Alice")
    assert(users[0].active == true)
    assert(users[1].id == 43)
    assert(users[1].name == "Bob")
    assert(users[1].active == false)

    val reencoded = serializeJson(users)
    val users2 = fromJson<List<User>>(reencoded)
    assert(users2[0].id == users[0].id)
    assert(users2[0].name == users[0].name)
    assert(users2[0].active == users[0].active)
    assert(users2[1].id == users[1].id)
    assert(users2[1].name == users[1].name)
    assert(users2[1].active == users[1].active)
}

test "serde: automatic static deserialization empty json list" {
    val jsonStr = "[]"
    val users = fromJson<List<User>>(jsonStr)
    assert(users.size() == 0)

    val reencoded = serializeJson(users)
    val users2 = fromJson<List<User>>(reencoded)
    assert(users2.size() == 0)
}