import { assert } from "std.core"
import { List } from "std.collections"
import { sleepMs } from "std.system"
import { Process, Shell } from "std.process"

// TDD: background spawn with alive/terminate/wait. Platform split lives
// in `Shell` (specialized objects), so tests carry no OS branches.

test "process: missing binary fails with -1" {
    val noArgs: List<String> = []
    assert(Process.spawn("eiwa-definitely-missing-binary-xyz", noArgs) == -1)
}

test "process: spawn runs detached, terminate stops it" {
    val sleep = Shell.sleep(30)
    val pid = Process.spawn(sleep.exe, sleep.args)
    assert(pid > 0)
    sleepMs(200)
    assert(Process.alive(pid))
    assert(Process.terminate(pid))
    assert(Process.alive(pid) == false)
    assert(Process.terminate(pid))
    assert(Process.terminate(-1) == false)
}

test "process: wait returns the exit code" {
    val done = Shell.exit(3)
    val pid = Process.spawn(done.exe, done.args)
    assert(pid > 0)
    assert(Process.wait(pid) == 3)
}
