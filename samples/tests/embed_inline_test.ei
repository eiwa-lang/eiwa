import { assert } from "std.core"

@Embed
fun each3(n: Int, block: (Int) -> Void) {
    var i = 0
    while (i < n) {
        block(i)
        i = i + 1
    }
}

test "@Embed driver break counts like a loop" {
    var total = 0
    each3(3) { k ->
        if (k == 1) {
            leave
        }
        total = total + 1
    }
    assert(total == 1)
}

test "@Embed keeps caller and driver locals apart" {
    var i = 100
    var total = 0
    each3(3) { k ->
        if (k == 1) {
            leave
        }
        i = k
        total = total + 1
    }
    assert(total == 1)
    assert(i == 0)
}
