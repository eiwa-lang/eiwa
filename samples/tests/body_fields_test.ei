import { assert } from "std.core"

// Body fields: `var`/`val` declared in the type body (outside the primary
// constructor) are NOT constructor arguments — their initializers run at
// construction, Kotlin-style. `val` requires an initializer; a nullable `var`
// may omit it and default to null.

type Counter(val base: Int) {
    var count: Int = 0
    val label: String = "counter"
    var doubled: Int = this.base * 2
    var note: String?

    fun inc() {
        this.count = this.count + 1
    }

    fun describe(): String {
        return this.label + "#" + this.count.toString()
    }
}

test "body var field starts at its initializer and mutates" {
    val c = Counter(10)
    assert(c.count == 0)
    c.inc()
    c.inc()
    assert(c.count == 2)
}

test "body val field is initialized and readable (not a ctor arg)" {
    val c = Counter(1)
    assert(c.label == "counter")
    assert(c.describe() == "counter#0")
}

test "body field initializer can reference constructor fields via this" {
    val c = Counter(21)
    assert(c.doubled == 42)
}

test "nullable var body field defaults to null when initializer is omitted" {
    val c = Counter(1)
    assert(c.note == null)
}

test "body fields are per-instance, not shared" {
    val a = Counter(1)
    val b = Counter(2)
    a.inc()
    assert(a.count == 1)
    assert(b.count == 0)
}
