import { assert } from "std.core"
import { MutableList } from "std.collections"

// Tests contract (fat pointer) value storage inside generic collections and generic struct fields.

contract Val {
    fun value(): Int
}

type One : Val {
    implement fun value(): Int = 1
}

test "contract stored in MutableList is retrievable and dispatchable" {
    val list = MutableList<Val>()
    list.add(One())
    assert(list.size() == 1)
    assert(list[0].value() == 1)
}

type CNode<T>(val item: T, var next: CNode<T>?)

test "contract stored in generic struct field dispatches" {
    val n = CNode<Val>(One(), null)
    assert(n.item.value() == 1)
}
