import { Scheduler, Dispatchers } from "std.coroutines"
import { AtomicBool } from "std.atomic"

test "bare task statement is scheduled and runs" {
    val ran = AtomicBool.create(false)
    task(Dispatchers.Single) {
        ran.set(true)
    }
    Dispatchers.Single.scheduler.run()
    assert(ran.get())
}

test "task with await returns its value" {
    val t = task {
        42
    }
    val res = t.await()
    assert(res == 42)
}
