import { assert } from "std.exceptions"

enum TaskState {
    IDLE,
    RUNNING,
    SUCCESS,
    ERROR
}

test "Enum variant name and ordinal properties" {
    val s0 = TaskState.IDLE
    val s1 = TaskState.RUNNING
    val s2 = TaskState.SUCCESS
    val s3 = TaskState.ERROR

    assert(s0.ordinal == 0)
    assert(s0.name == "IDLE")

    assert(s1.ordinal == 1)
    assert(s1.name == "RUNNING")

    assert(s2.ordinal == 2)
    assert(s2.name == "SUCCESS")

    assert(s3.ordinal == 3)
    assert(s3.name == "ERROR")
}

test "Enum variant equality and comparison" {
    val a = TaskState.RUNNING
    val b = TaskState.RUNNING
    val c = TaskState.SUCCESS

    assert(a == b)
    assert(a != c)
}

test "Enum pattern matching via when" {
    val state = TaskState.SUCCESS
    val result = when (state) {
        TaskState.IDLE -> 0
        TaskState.RUNNING -> 1
        TaskState.SUCCESS -> 2
        TaskState.ERROR -> 3
        else -> -1
    }
    assert(result == 2)
}

test "Enum static lookup byName" {
    val s0 = TaskState.byName("IDLE")
    assert(s0 != null)
    assert(s0?.name == "IDLE")
    assert(s0!!.ordinal == 0)

    val s1 = TaskState.byName("RUNNING")
    assert(s1 != null)
    assert(s1?.name == "RUNNING")
    assert(s1!!.ordinal == 1)

    val sUnknown = TaskState.byName("UNKNOWN")
    assert(sUnknown == null)

    val sEmpty = TaskState.byName("")
    assert(sEmpty == null)
}

test "Enum static lookup byOrdinal" {
    val s0 = TaskState.byOrdinal(0)
    assert(s0 != null)
    assert(s0?.name == "IDLE")

    val s3 = TaskState.byOrdinal(3)
    assert(s3 != null)
    assert(s3?.name == "ERROR")

    val sOOB = TaskState.byOrdinal(4)
    assert(sOOB == null)

    val sNeg = TaskState.byOrdinal(-1)
    assert(sNeg == null)
}

test "Enum static list and iteration" {
    val all = TaskState.list()
    assert(all.size() == 4)
    assert(all[0].name == "IDLE")
    assert(all[1].name == "RUNNING")
    assert(all[2].name == "SUCCESS")
    assert(all[3].name == "ERROR")

    val vals = TaskState.values()
    assert(vals.size() == 4)

    var count = 0
    for (all) { item ->
        count = count + 1
    }
    assert(count == 4)
}
