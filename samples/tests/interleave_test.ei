import { assert } from "std.core"
import { AtomicInt } from "std.atomic"

test "two loops with sleep interleave (Kotlin-style cooperative suspension)" {
    val countA = AtomicInt.create(0)
    val countB = AtomicInt.create(0)

    val t1 = task {
        var i = 0
        while (i < 3) {
            countA.incrementAndGet()
            yield()
            i = i + 1
        }
    }
    val t2 = task {
        var i = 0
        while (i < 3) {
            countB.incrementAndGet()
            yield()
            i = i + 1
        }
    }
    t1.await()
    t2.await()

    assert(countA.get() == 3)
    assert(countB.get() == 3)
}
