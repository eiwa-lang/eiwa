import { File } from "std.fs"

test "fs.ae: should write and read file correctly" {
    val path = "temp_test.txt"
    val content = "Hello, Eiwa Filesystem!"
    assert(File.write(path, content))

    val result = File.read(path)
    assert(result == content)

    File.delete(path)
}

test "fs.ae: should support pointer types" {
    val ptr: Pointer = Standard.gcMalloc(4)
    val ptr2: Pointer = ptr
    assert(ptr == ptr2)
}