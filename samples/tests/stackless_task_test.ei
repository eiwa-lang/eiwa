import { assert } from "std.core"

// Target semantics for the stackless task/await mechanism (what the Fase C
// transform will GENERATE). Hand-written here as a spec + regression test.
// Design notes (emitter constraints discovered):
//   - Waiters are an intrusive linked list of structs (WaiterNode). A NULLABLE
//     CONTRACT field (`Continuation?`) is broken (silent no-op dispatch), so we
//     never use one here.
//   - No zero-field sentinel continuation (segfaults when stored in a field).
//
// NOTE: names are Spec-prefixed because std.coroutines (implicitly imported)
// already declares `WaiterNode`/`StackTask` — the real machinery the transform
// generates. These local copies keep the emitter-constraint regression honest.

type SpecWaiterNode(val cont: Continuation, var next: SpecWaiterNode?)

type SpecIntTask(
    var done: Bool,
    var result: Int,
    var waiters: SpecWaiterNode?
)

type SpecBlockCont(val task: SpecIntTask) : Continuation {
    implement fun resume() {
        this.task.result = 40 + 2
        this.task.done = true
        var node = this.task.waiters
        while (node != null) {
            Dispatchers.Single.scheduler.schedule(node!!.cont)
            node = node!!.next
        }
        this.task.waiters = null
    }

    implement fun isDone(): Bool = this.task.done
}

type SpecMainCont(var label: Int, val task: SpecIntTask, var result: Int) : Continuation {
    implement fun resume() {
        if (this.label == 0) {
            Dispatchers.Single.scheduler.schedule(SpecBlockCont(this.task))
            this.label = 1
            if (!this.task.done) {
                this.task.waiters = SpecWaiterNode(this, this.task.waiters)
                return
            }
        }
        if (this.label == 1) {
            this.result = this.task.result
            this.label = 2
        }
    }

    implement fun isDone(): Bool = this.label >= 2
}

test "stackless task + await delivers the block result to the suspended main" {
    val task = SpecIntTask(false, 0, null)
    val main = SpecMainCont(0, task, 0)
    Dispatchers.Single.scheduler.schedule(main)
    Dispatchers.Single.scheduler.run()
    assert(main.result == 42)
}

test "await does not suspend when the task is already done" {
    val task = SpecIntTask(true, 7, null)
    val main = SpecMainCont(0, task, 0)
    Dispatchers.Single.scheduler.schedule(main)
    Dispatchers.Single.scheduler.run()
    assert(main.result == 7)
    assert(main.label == 2)
}

type SpecWaiterCont(val name: String, val task: SpecIntTask, var observed: Int) : Continuation {
    implement fun resume() {
        this.observed = this.task.result
    }

    implement fun isDone(): Bool = this.observed == this.task.result
}

test "multiple waiters all get resumed when the task completes" {
    val task = SpecIntTask(false, 0, null)
    val w1 = SpecWaiterCont("w1", task, 0)
    val w2 = SpecWaiterCont("w2", task, 0)
    task.waiters = SpecWaiterNode(w1, SpecWaiterNode(w2, null))

    Dispatchers.Single.scheduler.schedule(SpecBlockCont(task))
    Dispatchers.Single.scheduler.run()

    assert(w1.observed == 42)
    assert(w2.observed == 42)
}