import { Client, Response, HttpPerformer } from "std.http"

// Stub transport: proves Client delegates to the injected performer
// instead of hardcoding curl. No network involved.
type StubPerformer() : HttpPerformer {
    implement fun get(url: String): Response {
        return Response(200, "stub-get:" + url)
    }

    implement fun post(url: String, body: String): Response {
        return Response(201, "stub-post:" + body)
    }
}

test "http engine: client delegates get to injected performer" {
    val client = Client(StubPerformer())
    val res = client.get("https://example.com/x")

    assert(res.status == 200)
    assert(res.body == "stub-get:https://example.com/x")
}

test "http engine: client delegates post to injected performer" {
    val client = Client(StubPerformer())
    val res = client.post("https://example.com/x", "a=1")

    assert(res.status == 201)
    assert(res.body == "stub-post:a=1")
}

test "http engine: default client still constructs (curl motor)" {
    val client = Client()

    assert(client != null)
}
