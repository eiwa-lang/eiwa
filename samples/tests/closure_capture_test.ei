test "closure: assignment-only capture should box the variable" {
    var flag = false
    val setFlag = { flag = true }
    setFlag()
    assert(flag)
}

test "closure: assignment-only capture should persist across multiple calls" {
    var count = 0
    val bump = { count = count + 1 }
    bump()
    bump()
    bump()
    assert(count == 3)
}

test "closure: two closures should share the same captured variable" {
    var shared = 0
    val inc = { shared = shared + 1 }
    val dec = { shared = shared - 1 }
    inc()
    inc()
    inc()
    dec()
    assert(shared == 2)
}

test "closure: write-only captured var should be visible after closure runs" {
    var result = 0
    val compute = { result = 6 * 7 }
    assert(result == 0)
    compute()
    assert(result == 42)
}

type CaptureGroup(val id: String)

test "closure: should capture outer field access inside map literal" {
    val group = CaptureGroup(id = "abc123")
    val get = {
        val attrs = ["hx-get" of "/ui/carousel/${group.id}", "hx-target" of "body"]
        attrs["hx-get"] ?: ""
    }
    assert(get() == "/ui/carousel/abc123")
}

test "closure: should capture outer field access inside array literal" {
    val group = CaptureGroup(id = "g99")
    val get = {
        val arr = ["/ui/carousel/${group.id}"]
        arr[0] ?: ""
    }
    assert(get() == "/ui/carousel/g99")
}
