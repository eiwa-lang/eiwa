import { assert } from "std.core"

// A closure/function value stored as a struct field is callable: `obj.run()`
// invokes the closure stored in the field (via the dynamic fat-pointer path)
// instead of any same-named skill-composed method (e.g. `Scope.run`).
// Relevant to alternative continuation designs for the stackless scheduler.

type Cont(val run: () -> Int)

test "closure stored in struct field is callable" {
    val c = Cont({ 42 })
    assert(c.run() == 42)
}
