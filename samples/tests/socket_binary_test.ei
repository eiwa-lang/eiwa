import { assert } from "std.core"
import { NativeMemory } from "std.core"
import { SocketClient, TCPServer } from "std.net"
import { sleepMs } from "std.time"

// TDD: socket reads must preserve bytes after the first NUL ([65,0,66]
// arrived as [65,0,0] via strncpy-style copy). Split in granular tests
// so CI pinpoints the failing step by test name.

fun nulServer(port: Int): String {
    val server = TCPServer()
    if (server.bind(port) == false) {
        return "bind-fail"
    }
    val conn = server.accept()
    if (conn == null) {
        server.close()
        return "accept-fail"
    }
    val buf = Standard.gcMalloc(4)
    NativeMemory.writeByte(buf, 0, 65)
    NativeMemory.writeByte(buf, 1, 0)
    NativeMemory.writeByte(buf, 2, 66)
    NativeMemory.writeByte(buf, 3, 0)
    val data = String(buf, 3)
    var sent = 0
    while (sent < data.length) {
        val n = conn.write(data.substring(sent, data.length))
        if (n <= 0) {
            conn.close()
            server.close()
            return "write-fail"
        }
        sent = sent + n
    }
    conn.close()
    server.close()
    return "ok"
}

fun readNul(port: Int): String? {
    val server = task {
        nulServer(port)
    }
    sleepMs(150)
    var sock = SocketClient.connect("127.0.0.1", port)
    var tries = 0
    while (sock == null && tries < 50) {
        sleepMs(100)
        tries = tries + 1
        sock = SocketClient.connect("127.0.0.1", port)
    }
    if (sock == null) {
        return null
    }
    val s = sock!!
    val r1 = s.read(10)
    s.close()
    return r1
}

test "socket: client connects to the server" {
    assert(readNul(19884) != null)
}

test "socket: read length survives NUL" {
    val r1 = readNul(19885)!!
    assert(r1.length == 3)
}

test "socket: byte after NUL survives" {
    val r1 = readNul(19886)!!
    assert(NativeMemory.readByte(r1.ptr!!, 0) == 65)
    assert(NativeMemory.readByte(r1.ptr!!, 1) == 0)
    assert(NativeMemory.readByte(r1.ptr!!, 2) == 66)
}
