import { assert } from "std.core"
import { NativeMemory } from "std.core"
import { Socket, SocketClient, TCPServer } from "std.net"
import { sleepMs } from "std.system"

// TDD: socket reads must preserve bytes after the first NUL ([65,0,66]
// arrived as [65,0,0] via strncpy-style copy). Bind happens synchronously
// in the test thread (no bind/connect race); a small port range absorbs
// anything else on the runner. Accept retries like coop_io_test: CI runs
// one test child per core (each compiling LLVM), so a single 250ms accept
// window can be missed on loaded/slow runners (darwin-x86).

fun pickPort(): Int {
    var p = 19884
    while (p < 19894) {
        val probe = TCPServer()
        if (probe.bind(p)) {
            probe.close()
            return p
        }
        p = p + 1
    }
    return -1
}

fun serveNulOnce(server: TCPServer): String {
    var conn: Socket? = null
    var acceptAttempts = 0
    while (conn == null && acceptAttempts < 20) {
        conn = server.accept()
        acceptAttempts = acceptAttempts + 1
    }
    if (conn == null) {
        server.close()
        return "accept-fail"
    }
    val liveConn: Socket = conn!!
    val buf = Standard.gcMalloc(4)
    NativeMemory.writeByte(buf, 0, 65)
    NativeMemory.writeByte(buf, 1, 0)
    NativeMemory.writeByte(buf, 2, 66)
    NativeMemory.writeByte(buf, 3, 0)
    val data = String(buf, 3)
    var sent = 0
    while (sent < data.length) {
        val n = liveConn.write(data.substring(sent, data.length))
        if (n <= 0) {
            liveConn.close()
            server.close()
            return "write-fail"
        }
        sent = sent + n
    }
    liveConn.close()
    server.close()
    return "ok"
}

fun readNul(): String? {
    val port = pickPort()
    if (port < 0) {
        return null
    }
    val server = TCPServer()
    if (server.bind(port) == false) {
        return null
    }
    val serving = task {
        serveNulOnce(server)
    }
    sleepMs(150)
    var sock = SocketClient.connect("127.0.0.1", port)
    var tries = 0
    while (sock == null && tries < 50) {
        sleepMs(100)
        tries = tries + 1
        sock = SocketClient.connect("127.0.0.1", port)
    }
    if (sock == null) {
        return null
    }
    val s = sock!!
    val r1 = s.read(10)
    s.close()
    if (serving.await() != "ok") {
        return null
    }
    return r1
}

test "socket: client connects to the server" {
    assert(readNul() != null)
}

test "socket: read length survives NUL" {
    val r1 = readNul()
    assert(r1 != null)
    if (r1 != null) {
        assert(r1.length == 3)
    }
}

test "socket: byte after NUL survives" {
    val r1 = readNul()
    assert(r1 != null)
    if (r1 != null) {
        assert(NativeMemory.readByte(r1.ptr, 0) == 65)
        assert(NativeMemory.readByte(r1.ptr, 1) == 0)
        assert(NativeMemory.readByte(r1.ptr, 2) == 66)
    }
}
