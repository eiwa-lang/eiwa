import { assert } from "std.core"
import { TCPServer, Socket, SocketClient } from "std.net"
import { sleepMs } from "std.system"

// TDD: eiwa_tcp_connect resolved only literal IPs (inet_pton) —
// hostnames failed. The runtime must resolve via getaddrinfo so
// "localhost" (and any DNS name) connects like a literal IP.
// Loopback only: deterministic on Linux/macOS/Windows, no network.

fun acceptOne(server: TCPServer): String {
    // Single-shot accept misses under loaded CI (same class as coop_io):
    // the client connect can land after the 250ms accept window.
    var conn: Socket? = null
    var attempts = 0
    while (conn == null && attempts < 20) {
        conn = server.accept()
        attempts = attempts + 1
    }
    if (conn == null) {
        server.close()
        return "accept-fail"
    }
    val live: Socket = conn!!
    live.close()
    server.close()
    return "ok"
}

test "net: connect resolves localhost like a literal ip" {
    val server = TCPServer()
    server.bind(19790)
    val worker = task {
        acceptOne(server)
    }
    // Fixed startup delays flake under loaded CI runners (same class as
    // coop_io): retry the connect with a cap instead of assuming timing.
    var attempts = 0
    var sock = SocketClient.connect("localhost", 19790)
    while (sock == null && attempts < 40) {
        sleepMs(50)
        sock = SocketClient.connect("localhost", 19790)
        attempts = attempts + 1
    }
    assert(sock != null, "localhost-connect")
    sock!!.close()
    assert(worker.await() == "ok", "accepted")
}
