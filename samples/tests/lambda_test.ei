fun makeAdder(x: Int): (Int) -> Int {
    return { y: Int -> x + y }
}

object LambdaRunner {
    fun twice(block: (Int) -> Int): Int {
        return block(21) * 2
    }
}

test "lambdas: implicit 'it' as direct argument to an object method call" {
    assert(LambdaRunner.twice { it * 2 } == 84)
}

test "lambdas: should execute basic function types" {
    val add: (Int, Int) -> Int = { x: Int, y: Int -> x + y }
    assert(add(1, 2) == 3)
}

test "lambdas: should support implicit 'it' parameter" {
    val twice: (Int) -> Int = { it * 2 }
    assert(twice(10) == 20)
}

test "lambdas: should capture val variable from outer scope" {
    val threshold = 10
    val isAboveThreshold: (Int) -> Bool = { it > threshold }
    assert(isAboveThreshold(15) == true)
    assert(isAboveThreshold(5) == false)
}

test "lambdas: should capture and mutate var variable (closure)" {
    var total = 0
    val accumulate = { value: Int ->
        total = total + value
        total
    }

    assert(accumulate(5) == 5)
    assert(accumulate(10) == 15)
    assert(total == 15)
}

test "lambdas: higher order function return and nested capturing" {
    val add5 = makeAdder(5)
    assert(add5(10) == 15)
}

type HTMLBuilder(var content: String = "") {
    fun body(init: () -> String) {
        this.content = "${this.content}<body>${init()}</body>"
    }
}

fun html(init: HTMLBuilder.() -> Void): String {
    val builder = HTMLBuilder()
    init(builder)
    return "<html>${builder.content}</html>"
}

test "lambdas: simple HTML builder DSL" {
    val result = html {
        body {
            "Hello Eiwa DSL!"
        }
    }
    assert(result == "<html><body>Hello Eiwa DSL!</body></html>")
}

test "Lambdas: change var in outer scope" {
    var executed = false
    val myFun = {
        executed = true
    }
    myFun()
    assert(executed == true)
}

fun lambdaReturnVoid(block: () -> Void) {
    block()
}

test "Lambdas: return type Void" {
    val myFun = {
    }
    val result = lambdaReturnVoid(myFun)
    assert(result is Void)
}

test "lambdas: 4-level transitive capture of outer variable" {
    val outerMessage = "Deep 4-Level Eiwa Closure"
    var capturedResult = ""

    val l1 = {
        val l2 = {
            val l3 = {
                val l4 = {
                    capturedResult = outerMessage
                }
                l4()
            }
            l3()
        }
        l2()
    }
    l1()

    assert(capturedResult == "Deep 4-Level Eiwa Closure")
}
