contract Shape<T> {
    fun build(): Shape<T>
}

type Box<T>(val item: T): Shape<T> {
    fun get(): T = item

    implement fun build(): Shape<T> {
        return this
    }
}

test "should create generic classes" {
    val boxInt: Box<Int> = Box(10)
    assert(boxInt.get() == 10)

    val boxString = Box("Eiwa")
    assert(boxString.get() == "Eiwa")
}

test "should build generic contract" {
    val shape = Box("Eiwa")
    assert(shape.build() is Box<String>)
    val box = shape.build()
    when (box) {
        is Box<String> -> assert(box.get() == "Eiwa")
    }
}
