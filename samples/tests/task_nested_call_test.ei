type CaptureBox(var n: Int = 0)

test "tasks capturing loop variable complete" {
    val boxes = [CaptureBox(), CaptureBox()]
    val pending = MutableList<StackTask<Int>>([])
    for (boxes) { b ->
        pending.add(task {
            sleep(1)
            b.n = 1
            0
        })
    }
    val t0 = pending.get(0)
    val t1 = pending.get(1)
    t0.await()
    t1.await()
    for (boxes) { assert(it.n == 1) }
}
