import { assert } from "std.core"

contract Calculator {
    fun calc(a: Int, b: Int): Int
}

type Adder : Calculator {
    implement fun calc(a: Int, b: Int): Int {
        return a + b
    }
}

test "llvm backend contract implementation and polymorphic call" {
    val adder = Adder()
    val res = adder.calc(20, 22)
    assert(res == 42)
}
