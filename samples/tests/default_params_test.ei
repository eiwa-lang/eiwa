fun greet(name: String, greeting: String = "Hello") = greeting + ", " + name + "!"

fun compute(a: Int, b: Int = 10, c: Int = 5) = a + b + c

type Box(val value: Int = 42)

type Vector3D(val x: Int, val y: Int = 0, val z: Int = 0)

type SiblingType(val first: Int, val second: Int = first * 2)

fun computeWithSibling(a: Int, b: Int = a + 5) = a + b

type Child(val a: Int = 1)

test "default_params: should use default arguments in top-level functions" {
    assert(greet("Alice") == "Hello, Alice!")
    assert(greet("Bob", "Hi") == "Hi, Bob!")
    
    assert(compute(1) == 16)         // 1 + 10 + 5
    assert(compute(1, 2) == 8)       // 1 + 2 + 5
    assert(compute(1, 2, 3) == 6)    // 1 + 2 + 3
}

test "default_params: should use default constructor properties" {
    val b1 = Box()
    assert(b1.value == 42)
    
    val b2 = Box(100)
    assert(b2.value == 100)
}

test "default_params: should mix provided and default constructor properties" {
    val v1 = Vector3D(5)
    assert(v1.x == 5)
    assert(v1.y == 0)
    assert(v1.z == 0)
    
    val v2 = Vector3D(5, 2)
    assert(v2.x == 5)
    assert(v2.y == 2)
    assert(v2.z == 0)
    
    val v3 = Vector3D(5, 2, 3)
    assert(v3.x == 5)
    assert(v3.y == 2)
    assert(v3.z == 3)
}

test "default_params: should use default constructor arguments" {
    val c = Child()
    assert(c.a == 1)

    val s1 = SiblingType(10)
    assert(s1.first == 10)
    assert(s1.second == 20)

    val s2 = SiblingType(10, 99)
    assert(s2.first == 10)
    assert(s2.second == 99)

    assert(computeWithSibling(10) == 25)
    assert(computeWithSibling(10, 3) == 13)
}

type Calculator {
    fun calculate(a: Int, b: Int = a * 2, c: Int = b + 1): Int {
        return a + b + c
    }
}

test "default_params: should resolve sibling default parameters in type methods" {
    val calc = Calculator()
    assert(calc.calculate(5) == 26) // a=5, b=10, c=11 -> 5+10+11 = 26
    assert(calc.calculate(5, 20) == 46) // a=5, b=20, c=21 -> 5+20+21 = 46
    assert(calc.calculate(5, 20, 100) == 125)
}

fun multiSibling(x: Int, y: Int = x * 2, z: Int = y + 3): Int = x + y + z

test "default_params: should resolve chained sibling defaults in top-level functions" {
    assert(multiSibling(4) == 23) // 4 + 8 + 11 = 23
    assert(multiSibling(4, 10) == 27) // 4 + 10 + 13 = 27
    assert(multiSibling(4, 10, 50) == 64)
}

