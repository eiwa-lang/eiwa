import { combine } from ".samples.string_ops"

test "string_ops.ae: should concatenate two strings correctly" {
    val a = "Hello, "
    val b = "World!"
    val full: String = combine(a, b)
}

test "string.substring with start only defaults end to length" {
    val text = "a1b22c"
    assert(text.substring(2) == "b22c", "substring(2) to end")
    assert(text.substring(0) == text, "substring(0) is whole string")
    assert(text.substring(1, 3) == "1b", "two-arg form unchanged")
    assert(text.substring(6) == "", "start at length is empty")

    var lastIndex = 0
    var tail = ""
    for (Regex("[0-9]+").findAll(text)) { m ->
        tail = tail + text.substring(lastIndex, m.start)
        lastIndex = m.end
    }
    tail = tail + text.substring(lastIndex)
    assert(tail == "abc", "kotlin-style split loop with single-arg tail")
}
