// First cooperative program: two tasks alternate prints with sleeps,
// driven by the single-threaded scheduler (one RTOS worker on ESP32).
init {
    val a = task {
        var i = 0
        while (i < 3) {
            print("task A blink $i")
            sleepMs(100)
            i = i + 1
        }
    }
    val b = task {
        var i = 0
        while (i < 3) {
            print("task B blink $i")
            sleepMs(150)
            i = i + 1
        }
    }
    a.await()
    b.await()
    print("done")
}
