import { Postgres } from "./postgres/postgres"

fun main() {
    // --- Basic connect & execute ---
    val db = Postgres.connect("postgres://leodouglas@localhost/eiwa")

    val noParams: List<String> = []
    
    db.execute("CREATE TABLE IF NOT EXISTS users (id SERIAL PRIMARY KEY, name TEXT NOT NULL)", noParams)
    
    db.execute("INSERT INTO users(name) VALUES($1)", ["Alice"])
    db.execute("INSERT INTO users(name) VALUES($1)", ["Bob"])
    
    // --- Query and iterate rows ---
    
    val result = db.query("SELECT id, name FROM users", noParams)
    
    for (row in result.rows()) {
        println(row.int("id").toString() + ": " + row.string("name"))
    }
    
    // --- Prepared statement ---
    
    val stmt = db.prepare("SELECT id, name FROM users WHERE id = $1")
    val found = stmt.query(["1"])
    
    for (row in found.rows()) {
        println("Found: " + row.string("name"))
    }
    
    // --- Transaction (inline block syntax) ---
    db.execute("UPDATE users SET name = $1 WHERE id = $2", ["Alice Updated", "1"])
    db.execute("DELETE FROM users WHERE id = $1", ["2"])
    
    println("Done.")
    db.close()
}
