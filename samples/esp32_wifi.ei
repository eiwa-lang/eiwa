// WiFi station + HTTP on the device: connects (creds from the IDF build
// config, never hardcoded), proves loopback, then serves /health and
// /blink (onboard LED) on port 80 for the lab network (HIL).
import { Wifi } from "std.wifi"
import { Led } from "std.gpio"
import { Server, RequestTooLarge, HttpStatus } from "std.http"
import { SocketClient } from "std.net"
import { task } from "std.coroutines"

fun bigBody(n: Int): String {
    var s = ""
    var i = 0
    while (i < n) {
        s = s + "a"
        i = i + 1
    }
    return s
}

init {
    Led.init(8)
    var connected = Wifi.connect()
    var guard = 0
    while (!connected && guard < 3) {
        print("wifi: retrying...")
        sleepMs(5000)
        connected = Wifi.connect()
        guard = guard + 1
    }
    if (connected) {
        print("wifi: connected")
    } else {
        print("wifi: not configured (see main/Kconfig.projbuild)")
    }

    // Loopback self-test: works with or without a radio.
    val srv = Server()
    srv.bind(18080)
    val t = task {
        val health = SocketClient.connect("127.0.0.1", 18080)!!
        health.write("GET /health HTTP/1.1\r\n\r\n")
        print(health.read(4096))
        health.close()
        val big = SocketClient.connect("127.0.0.1", 18080)!!
        big.write("POST /big HTTP/1.1\r\nContent-Length: 9000\r\n\r\n" + bigBody(9000))
        print(big.read(4096))
        big.close()
        0
    }
    var i = 0
    while (i < 2) {
        val c = srv.accept()
        if (c != null) {
            try {
                val req = c.readRequest()
                if (req.path == "/health") {
                    c.writeResponse(HttpStatus.OK, "text/plain", "ok")
                } else {
                    c.writeResponse(HttpStatus.NOT_FOUND, "text/plain", "nf")
                }
            } catch (e: RequestTooLarge) {
                c.writeResponse(HttpStatus.PAYLOAD_TOO_LARGE, "text/plain", "too big")
            }
            c.close()
        }
        i = i + 1
    }
    t.await()
    srv.close()

    // Real network service for the lab (HIL): /blink toggles the LED.
    if (connected) {
        print("serving :80")
        Led.on(8)
        val pub = Server()
        pub.bind(80)
        var on = true
        loop {
            val c = pub.accept()
            if (c != null) {
                try {
                    val req = c.readRequest()
                    if (req.path == "/blink") {
                        if (on) { Led.off(8) } else { Led.on(8) }
                        on = !on
                        c.writeResponse(HttpStatus.OK, "text/plain", "blink")
                    } else {
                        c.writeResponse(HttpStatus.NOT_FOUND, "text/plain", "nf")
                    }
                } catch (e: RequestTooLarge) {
                    c.writeResponse(HttpStatus.PAYLOAD_TOO_LARGE, "text/plain", "too big")
                }
                c.close()
            }
        }
    }
    print("done")
}
