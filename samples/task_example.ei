type TaskImplExample<T>(val taskId: Int = 0, var done: Bool = false, var result: T?) {

    fun id(): Int = taskId

    fun result(): T? = result

    fun isDone(): Bool = done

    fun end(): Void {
        done = true
    }

    fun start(block: () -> String) {
        block()
        end()
    }
}

fun main() {
    TaskImplExample(0, false, null)
}
    