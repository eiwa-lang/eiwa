contract Awaitable<T> {
    fun await(): T
}

contract TaskExample<T> {
    fun start()

    fun run()

    fun handle(): T
}

skill TaskNeco<T> : TaskExample<T>, Awaitable<T> {

    implement fun run() {
        echo("Task " + taskId.toString() + " running")
        // to-do: add the suspend call here
    }

    implement fun await(): T {
        // to-do: add the resume call here
        return handle()
    }
}   

type TaskImplExample<T>(val taskId: Int = 0, var done: Bool = false, val block: () -> T) : TaskExample<T>, Awaitable<T> + TaskNeco<T> {

    implement fun start(): Void {
        echo("Task " + taskId.toString() + " started")
        this.run()
    }

    implement fun handle(): T {
        val r = block()
        done = true
        echo("Task " + taskId.toString() + " done")
        return r
    }
}

// Factory function
fun taskExample<T>(block: () -> T) : TaskImplExample<T> {
    val task = TaskImplExample<T>(0, false, block)
    task.start()
    return task
}

fun main() {
    taskExample {
        echo("coisas que ecoavam no vazio...  ")
    }.await()
}