type HTMLBuilder(var content: String = "") {

    fun title(init: () -> String) {
        content = content + "<title>" + init() + "</title>"
    }

    fun basicStyle() {
        content = content + "<style>" +
        "*{margin:0;padding:0;box-sizing:border-box}" +
        "body{background:#0f172a;color:#f8fafc;font:16px/1.6 system-ui,sans-serif;display:flex;flex-direction:column;justify-content:center;align-items:center;min-height:100vh;padding:48px;text-align:center}" +
        "h1{font-size:3rem;margin-bottom:16px}" +
        "h2{margin:24px 0 12px;color:#cbd5e1}" +
        "p{max-width:640px;color:#94a3b8;margin-bottom:24px}" +
        "a{display:inline-block;padding:12px 24px;background:#2563eb;color:#fff;text-decoration:none;border-radius:10px;transition:.2s}" +
        "a:hover{background:#3b82f6;transform:translateY(-1px)}" +
        "</style>"
    }

    fun body(init: BodyBuilder.() -> Void) {
        val builder = BodyBuilder()
        init(builder)
        content = content + "<body>" + builder.content + "</body>"
    }
}

type BodyBuilder(var content: String = "") {

    fun h1(init: () -> String) {
        content = content + "<h1>" + init() + "</h1>"
    }

    fun h2(init: () -> String) {
        content = content + "<h2>" + init() + "</h2>"
    }

    fun p(init: () -> String) {
        content = content + "<p>" + init() + "</p>"
    }

    fun a(href: String, init: () -> String) {
        content = content + "<a href=\"" + href + "\">" + init() + "</a>"
    }
}

fun html(init: HTMLBuilder.() -> Void): String {
    val builder = HTMLBuilder()
    init(builder)
    return "<html>" + builder.content + "</html>"
}
