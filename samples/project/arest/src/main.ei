import { arest } from "arest"

import { date, now, Time } from "std.time"
import { List, MutableList, MutableMap } from "std.collections"
import { Serializable } from "std.serde"
import { Json } from "std.json"
import { Yaml } from "std.yaml"

import { Log } from "std.log"
import { Postgres } from "postgres"
import { html } from "html"

import { brl } from "std.money"

type Address(val city: String, val zip: String) : Serializable
type Person(
    val name: String,
    val age: Int,
    val address: Address,
    val birthday: Time,
    val tags: List<String>
) : Serializable + Json + Yaml
type User(val id: Int, val name: String) : Serializable + Json + Yaml

fun main() {
    printWelcome()
    val pool = Postgres.pool("postgres://leodouglas@localhost/eiwa", maxConnections = 10)

    arest(8082) {
        routing {
            get("/") {
                respond(200, "text/html", html {
                    head {
                        title("Arest — Eiwa Web Framework")
                        meta(charset = "UTF-8")
                        script(src = "https://cdn.tailwindcss.com")
                    }
                    body(class = "bg-blue-950 text-gray-100 flex items-center justify-center min-h-screen p-6 font-sans antialiased") {
                        div(class = "max-w-2xl w-full bg-gray-900 border border-gray-800 rounded-3xl p-10 shadow-2xl text-center") {
                            span(class = "inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-blue-950 text-blue-400 border border-blue-800 mb-6", text = "⚡ Arest Web Framework v1.0")
                            h1("Eiwa Programming Language", class = "text-4xl font-extrabold text-white tracking-tight mb-3")
                            h2("Natively compiled systems language with Kotlin-inspired syntax.", class = "text-base text-gray-400 mb-8")

                            div(class = "grid grid-cols-3 gap-4 mb-8 text-left") {
                                div(class = "bg-gray-950 p-4 rounded-xl border border-gray-800") {
                                    h3("Native C Backend", class = "text-xs font-bold text-blue-400 uppercase tracking-wider mb-1")
                                    p("Compiled via C99 into high-performance native binaries.", class = "text-xs text-gray-400")
                                }
                                div(class = "bg-gray-950 p-4 rounded-xl border border-gray-800") {
                                    h3("Garbage Collected", class = "text-xs font-bold text-indigo-400 uppercase tracking-wider mb-1")
                                    p("Boehm GC integration for memory safety and zero leaks.", class = "text-xs text-gray-400")
                                }
                                div(class = "bg-gray-950 p-4 rounded-xl border border-gray-800") {
                                    h3("Structured Fibers", class = "text-xs font-bold text-purple-400 uppercase tracking-wider mb-1")
                                    p("Cooperative fibers for lightweight async concurrency.", class = "text-xs text-gray-400")
                                }
                            }

                            div(class = "flex justify-center gap-4") {
                                a(href = "https://github.com/eiwa-lang/eiwa", class = "inline-block bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-6 rounded-xl transition shadow-lg", text = "View Source on GitHub")
                                a(href = "/json", class = "inline-block bg-gray-800 hover:bg-gray-700 text-gray-200 font-semibold py-3 px-6 rounded-xl border border-gray-700 transition", text = "API /json Endpoint")
                                a(href = "/data", class = "inline-block bg-gray-800 hover:bg-gray-700 text-gray-200 font-semibold py-3 px-6 rounded-xl border border-gray-700 transition", text = "API /data Endpoint")
                            }
                        }
                    }
                })
            }

            get("/map") {
                val body = MutableMap<String, String>()
                body["welcome"] = "Hi there!"
                body["description"] = "Arest is a Web Framework for Eiwa!"
                body["date"] = now().toString()
                body["uuid"] = Uuid.generate().toString()
                body["random_int"] = Random.nextInt().toString()
                body["random_double"] = Random.nextDouble(1, 100).toString()
                body["money"] = brl(Random.nextInt()).format()

                respond(200, "application/json", body.toJson())
            }

            get("/json") {
                val addr = Address("Sao Paulo", "01000-000")
                val person = Person("Ana", 30, addr, date(1987, 10, 10), ["friend", "coder"])
                respond(200, "application/json", person.toJson())
            }

            get("/yaml") {
                val addr = Address("Sao Paulo", "01000-000")
                val person = Person("Ana", 30, addr, date(1987, 10, 10), ["friend", "coder"])
                respond(200, "text/yaml", person.toYaml())
            }

            get("/data") {
                val result = pool.query("SELECT id, name FROM users")

                val users = MutableList<User>()
                for (row in result.rows()) {
                    users.add(User(row.int("id"), row.string("name")))
                }
                respond(200, "application/json", users.toJson())
            }

            post("/users") {
                val name = request.queries["name"] ?: "Anonymous"
                pool.prepare("INSERT INTO users (name) VALUES ($1)")
                    .bind(name)
                    .execute()

                val msg = [
                    "status" of "created",
                    "name" of name
                ]
                respond(201, "application/json", msg.toJson())
            }

            get("/hello") {
                val name = request.queries["name"] ?: "Guest"
                respondText("Hello, " + name + "!")
            }

            post("/echo") {
                val contentType = request.headers["Content-Type"] ?: "text/plain"
                respond(200, contentType, request.body)
            }

            get("/shutdown") {
                pool.close()
                server.shutdown()
                respondText("Server is shutting down...")
            }
        }
    }
}
