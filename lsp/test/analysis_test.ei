// analysis_test.ei — unit tests for the LSP text analysis helpers.

import { scanSymbols, wordAt, takeName, findSymbol, findBestSymbol, findTopLevel, findContract, findContractMethod, findMember, findLocalDecl, receiverAt, isCapitalized, indexOfWord, inferReceiverType, enclosingHolder, findImplementations, containsWord, scanImports, locateImportPaths, importPathAtCursor, resolveModule, resolveInRoot, lineAt, declKeyword } from ".lsp.src.analysis"
import { implicitModule, synthesisContract } from ".lsp.src.index"
import { uriToPath } from ".lsp.src.store"
import { headerValue, isContentLength } from ".lsp.src.transport"
import { parseTrailer, checkOutputToDiags } from ".lsp.src.diagnostics"
import { probeStdDir } from ".lsp.src.toolchain"
import { scanDeps, depSrcDirs, extraRoots, findModuleFile, importFileTarget, projectRoots } from ".lsp.src.deps"
import { strLess } from ".lsp.src.index"
import { contractFile } from ".lsp.src.index"
import { uriToPath, Workspace } from ".lsp.src.store"
import { File } from "std.fs"
import { Dir } from "std.fs"
import { Env } from "std.env"

// Writable scratch base for filesystem tests: the OS temp dir when set,
// `/tmp` otherwise (always exists on Unix CI images; `%TEMP%` on Windows).
fun testTmp(): String {
    val t = Env.get("TEMP")
    if (t != null && t != "") {
        return t
    }
    val m = Env.get("TMPDIR")
    if (m != null && m != "") {
        return m
    }
    return "/tmp"
}

test "takeName extracts identifiers" {
    assert(takeName("Counter(val x: Int)") == "Counter")
    assert(takeName("inc(): Int {") == "inc")
    assert(takeName("_hidden123 rest") == "_hidden123")
    assert(takeName("  spaced") == "")
}

test "receiverAt extracts dotted receivers" {
    assert(receiverAt("    val f = File.read(path)", 18) == "File")
    assert(receiverAt("    val f = File.read(path)", 12) == "")
    assert(receiverAt("x.read()", 6) == "x")
    assert(receiverAt("println(x)", 5) == "")
}

test "isCapitalized detects types" {
    assert(isCapitalized("File"))
    assert(isCapitalized("file") == false)
    assert(isCapitalized("") == false)
}

test "findMember stays inside the holder body" {
    val text = "type Counter(val base: Int) {\n    var count: Int = 0\n    fun inc(): Int {\n        return 1\n    }\n}\ntype Other {\n    fun inc(): Int {\n        return 2\n    }\n}"
    val syms = scanSymbols(text)
    val m = findMember(syms, 0, "inc")
    if (m != null) {
        assert(m.line == 2)
    } else {
        assert(false)
    }
    assert(findMember(syms, 0, "missing") == null)
}

test "scanSymbols registers variants and tests" {
    val syms = scanSymbols("enum LogLevel {\n    DEBUG,\n    INFO\n}\ntest \"ok\" {\n}")
    assert(findSymbol(syms, "DEBUG") != null)
    assert(findSymbol(syms, "INFO") != null)
    assert(findSymbol(syms, "LogLevel") != null)
    assert(findSymbol(syms, "ok") != null)
}
test "synthesisContract maps generated methods" {
    assert(synthesisContract("toString") == "Stringable")
    assert(synthesisContract("equals") == "Equatable")
    assert(synthesisContract("hashCode") == "Hashable")
    assert(synthesisContract("draw") == "")
}

test "strLess orders byte-wise" {
    assert(strLess("abc", "abd"))
    assert(strLess("abc", "abcd"))
    assert(strLess("core.ei", "uuid.ei"))
    assert(strLess("a", "b"))
    assert(strLess("a", "a") == false)
}

test "contractFile locates declaring files" {
    assert(contractFile("Stringable").endsWith("std/core.ei"))
    assert(contractFile("Awaitable").endsWith("std/core.ei"))
    assert(contractFile("Nope") == "")
}

test "findContract locates contracts by name" {
    val text = "contract Drawable {\n    fun draw()\n}\ntype Button : Drawable {\n    implement fun draw() {\n    }\n}"
    val syms = scanSymbols(text)
    val c = findContract(syms, "Drawable")
    if (c != null) {
        assert(c.line == 0)
    } else {
        assert(false)
    }
    assert(findContract(syms, "Missing") == null)
}

test "findContractMethod locates the method inside the contract" {
    val text = "contract Drawable {\n    fun draw()\n}\ntype Button : Drawable {\n    implement fun draw() {\n    }\n}"
    val syms = scanSymbols(text)
    val m = findContractMethod(syms, "Drawable", "draw")
    if (m != null) {
        assert(m.line == 1)
        assert(m.kind == "fun")
    } else {
        assert(false)
    }
    assert(findContractMethod(syms, "Drawable", "missing") == null)
    assert(findContractMethod(syms, "Missing", "draw") == null)
}

test "declKeyword detects implement" {
    assert(declKeyword("implement fun draw()") == "implement")
}

test "scanSymbols detects implement methods" {
    val text = "contract Drawable {\n    fun draw()\n}\ntype Button : Drawable {\n    implement fun draw() {\n        println(\"b\")\n    }\n}"
    val syms = scanSymbols(text)
    var found = false
    var i = 0
    while (i < syms.size()) {
        if (syms.get(i).name == "draw" && syms.get(i).kind == "implement") {
            found = true
        }
        i = i + 1
    }
    assert(found)
}

test "findImplementations resolves contract methods" {
    val text = "contract Drawable {\n    fun draw()\n}\ntype Button : Drawable {\n    implement fun draw() {\n    }\n}\ntype Label : Drawable {\n    implement fun draw() {\n    }\n}"
    val syms = scanSymbols(text)
    val impls = findImplementations(syms, "draw")
    assert(impls.size() == 2)
    assert(impls.get(0).line == 4)
    assert(impls.get(1).line == 8)
    assert(findImplementations(syms, "missing").size() == 0)
}

test "findImplementations resolves contract to types" {
    val text = "contract Drawable {\n    fun draw()\n}\ntype Button : Drawable {\n}\ntype Plain {\n}"
    val syms = scanSymbols(text)
    val impls = findImplementations(syms, "Drawable")
    assert(impls.size() == 1)
    assert(impls.get(0).name == "Button")
}

test "containsWord respects identifier boundaries" {
    assert(containsWord("type Button : Drawable + Shadow {", "Drawable"))
    assert(containsWord("Drawable2", "Drawable") == false)
    assert(containsWord("MyDrawable", "Drawable") == false)
    assert(containsWord("Drawable", "Drawable"))
    assert(containsWord("", "Drawable") == false)
}
test "declKeyword detects declaration kinds" {
    assert(declKeyword("fun foo()") == "fun")
    assert(declKeyword("type Bar {") == "type")
    assert(declKeyword("contract C {") == "contract")
    assert(declKeyword("skill S {") == "skill")
    assert(declKeyword("object O {") == "object")
    assert(declKeyword("enum E {") == "enum")
    assert(declKeyword("val x = 1") == "val")
    assert(declKeyword("var y = 2") == "var")
    assert(declKeyword("println(x)") == "")
    assert(declKeyword("functional()") == "")
}

test "scanImports parses single-line imports" {
    val imps = scanImports("import { add, Vector } from \"math\"\ninit {\n}")
    assert(imps.size() == 1)
    assert(imps.get(0).path == "math")
    assert(imps.get(0).names.size() == 2)
    assert(imps.get(0).names.get(0) == "add")
    assert(imps.get(0).names.get(1) == "Vector")
}

test "scanImports parses wrapped imports" {
    val imps = scanImports("import { trim, isSpace,\n    parseTopField } from \"helpers\"\n")
    assert(imps.size() == 1)
    assert(imps.get(0).path == "helpers")
    assert(imps.get(0).names.size() == 3)
    assert(scanImports("println(x)").size() == 0)
}

test "locateImportPaths maps every path with positions" {
    val text = "import { a } from \"alpha\"\nimport { b,\n    c } from \"beta.gamma\"\n// import { z } from \"nope\"\nprintln(\"hi\")\n"
    val paths = locateImportPaths(text)
    assert(paths.size() == 2)
    assert(paths.get(0).path == "alpha")
    assert(paths.get(0).line == 0)
    assert(paths.get(1).path == "beta.gamma")
    assert(paths.get(1).line == 2)
    val seg = text.split("\n").get(2)
    assert(seg.substring(paths.get(1).start, paths.get(1).end) == "\"beta.gamma\"")
}

test "importPathAtCursor only fires inside the path string" {
    val line = "import { html } from \"html\""
    assert(importPathAtCursor(line, 24) == "html")
    assert(importPathAtCursor(line, 9) == "")
    assert(importPathAtCursor(line, 0) == "")
    assert(importPathAtCursor("println(\"hi\")", 10) == "")
    assert(importPathAtCursor("import { x } from \"a.b\"", 22) == "a.b")
    assert(importPathAtCursor("import { x } from \"a.b\"", 2) == "")
}

test "resolveModule follows Eiwa path rules" {
    assert(resolveModule("/proj/src/main.ei", "util.helpers", "/proj") == "/proj/src/util/helpers.ei")
    assert(resolveModule("/proj/src/main.ei", ".consts", "/proj") == "/proj/consts.ei")
    assert(resolveModule("/proj/src/main.ei", ".lib.strings", "/proj") == "/proj/lib/strings.ei")
    assert(resolveModule("/proj/src/main.ei", ".consts", "") == "")
    assert(resolveModule("/proj/src/main.ei", "", "/proj") == "")
    val stdPath = resolveModule("/proj/src/main.ei", "std.collections", "/proj")
    assert(stdPath == "" || stdPath.endsWith("std/collections.ei"))
}

test "probeStdDir finds real std sources" {
    val dir = probeStdDir()
    assert(dir == "" || File.exists(dir + "/core.ei"))
}

test "findTopLevel ignores members" {
    val syms = scanSymbols("type Box {\n    fun open(): Bool {\n        return true\n    }\n}\n")
    assert(findTopLevel(syms, "open") == null)
    assert(findTopLevel(syms, "Box") != null)
    assert(findTopLevel(syms, "missing") == null)
}

test "implicitModule prefers top-level declarations" {
    assert(implicitModule("sleep") == "std.system")
    assert(implicitModule("println") == "std.io")
    assert(implicitModule("toString") == "")
    assert(implicitModule("parseJson") == "std.json")
}

test "multiline headers keep the container" {
    val text = "type TaskScheduler(\n    val mutex: Int\n) {\n    fun sleep(): Int {\n        return 1\n    }\n}\nfun top() {\n}\n"
    val syms = scanSymbols(text)
    val m = findBestSymbol(syms, "sleep")
    if (m != null) {
        assert(m.container == "TaskScheduler")
    } else {
        assert(false)
    }
    val top = findBestSymbol(syms, "top")
    if (top != null) {
        assert(top.container == "")
    } else {
        assert(false)
    }
}

test "comments do not reset the container" {
    val text = "type A {\n// standalone comment\n    fun f(): Int {\n        return 1\n    }\n}\n"
    val syms = scanSymbols(text)
    val m = findBestSymbol(syms, "f")
    if (m != null) {
        assert(m.container == "A")
    } else {
        assert(false)
    }
}
test "implicitModule maps stdlib names" {
    assert(implicitModule("repeat") == "std.system")
    assert(implicitModule("task") == "std.coroutines")
    assert(implicitModule("println") == "std.io")
    assert(implicitModule("Console") == "std.io")
    assert(implicitModule("File") == "std.fs")
    assert(implicitModule("NativeFS") == "std.fs")
    assert(implicitModule("Socket") == "std.net")
    assert(implicitModule("NativeProcess") == "std.process")
    assert(implicitModule("SerdeInt") == "std.serde")
    assert(implicitModule("YamlParser") == "std.yaml")
    assert(implicitModule("it") == "")
    assert(implicitModule("myVar") == "")
}

test "implicitModule is derived from sources, not a list" {
    assert(implicitModule("daysInMonth") == "std.time")
    assert(implicitModule("xyzzy") == "")
    assert(synthesisContract("await") == "Awaitable")
    assert(synthesisContract("parseJson") == "")
}

test "scanSymbols tracks containers" {
    val syms = scanSymbols("type Counter {\n    fun inc(): Int {\n        return 1\n    }\n}\nfun top() {\n}\n")
    val inc = findSymbol(syms, "inc")
    if (inc != null) {
        assert(inc.container == "Counter")
        assert(inc.kind == "fun")
    } else {
        assert(false)
    }
    val top = findSymbol(syms, "top")
    if (top != null) {
        assert(top.container == "")
    } else {
        assert(false)
    }
    assert(findSymbol(syms, "Counter") != null)
}

test "declKeyword detects lib and qualified object" {
    assert(declKeyword("lib Console {") == "lib")
    assert(declKeyword("lib(\"posix\") PosixProcess {") == "lib")
    assert(declKeyword("object(\"posix\") NativeProcess : X {") == "object")
    val syms = scanSymbols("object(\"posix\") NativeProcess : X {\n}\nlib NativeFS {\n}")
    assert(findSymbol(syms, "NativeProcess") != null)
    assert(findSymbol(syms, "NativeFS") != null)
}

test "declKeyword detects union" {
    assert(declKeyword("union Step {") == "union")
}

test "findBestSymbol prefers callables over locals" {
    val text = "fun task() {\n}\nval task = 1"
    val syms = scanSymbols(text)
    val best = findBestSymbol(syms, "task")
    if (best != null) {
        assert(best.kind == "fun")
        assert(best.line == 0)
    } else {
        assert(false)
    }
    assert(findBestSymbol(syms, "missing") == null)
}

test "indexOfWord respects boundaries and offsets" {
    assert(indexOfWord("val b = Box()", "b", 0) == 4)
    assert(indexOfWord("b b", "b", 1) == 2)
    assert(indexOfWord("abc", "b", 5) == -1)
    assert(indexOfWord("abc", "", 0) == -1)
}

test "inferReceiverType reads declarations" {
    val text = "fun f(b: Box) {\n    b.open()\n}\nval p: Pair = Pair()\nprintln(p)\nval n = 5\nprintln(n)\nif (x == y) {\n}\n"
    assert(inferReceiverType(text, 1, "b") == "Box")
    assert(inferReceiverType(text, 4, "p") == "Pair")
    assert(inferReceiverType(text, 6, "n") == "")
    assert(inferReceiverType(text, 7, "x") == "")
    assert(inferReceiverType(text, 7, "y") == "")
    assert(inferReceiverType(text, 1, "this") == "")
    assert(inferReceiverType(text, 1, "") == "")
}

test "enclosingHolder finds the lexically enclosing type" {    val text = "type A {\n    fun f() {\n        println(this.g())\n    }\n}\ntype B {\n}\n"
    assert(enclosingHolder(text, 2) == "A")
    assert(enclosingHolder(text, 6) == "B")
    assert(enclosingHolder("init {\n}\n", 0) == "")
}
test "scanDeps parses freeze manifests" {
    val raw = "dependencies:\n  html:\n    github: eiwa-lang/html\n    branch: main\n    commit: abc123\n  local:\n    path: ../libs/local\n"
    val deps = scanDeps(raw)
    assert(deps.size() == 2)
    assert(deps.get(0).name == "html")
    assert(deps.get(0).commit == "abc123")
    assert(deps.get(0).path == "")
    assert(deps.get(1).name == "local")
    assert(deps.get(1).path == "../libs/local")
    assert(scanDeps("name: app\n").size() == 0)
}

test "resolveInRoot maps dotted paths" {
    assert(resolveInRoot("arest.arest", "/r/html/abc/src") == "/r/html/abc/src/arest/arest.ei")
    assert(resolveInRoot("html", "/r/html/abc/src") == "/r/html/abc/src/html.ei")
    assert(resolveInRoot("", "/r") == "")
}

test "extraRoots reads EIWA_MODULE_PATH" {
    Env.unset("EIWA_MODULE_PATH")
    assert(extraRoots().size() == 0)
    Env.set("EIWA_MODULE_PATH", "/tmp/a:/tmp/b")
    assert(extraRoots().size() == 2)
    assert(extraRoots().get(1) == "/tmp/b")
    Env.set("EIWA_MODULE_PATH", "C:\\a;C:\\b")
    assert(extraRoots().size() == 2)
    assert(extraRoots().get(1) == "C:\\b")
    Env.set("EIWA_MODULE_PATH", "C:\\a")
    assert(extraRoots().size() == 1)
    assert(extraRoots().get(0) == "C:\\a")
    Env.unset("EIWA_MODULE_PATH")
    assert(extraRoots().size() == 0)
}

test "findModuleFile falls back to EIWA_MODULE_PATH" {
    val modBase = testTmp() + "/lspmod_extra"
    if (Dir.exists(modBase) == false) {
        Dir.mkdir(modBase)
    }
    File.write(modBase + "/utilx.ei", "fun utilx(): Int {\n    return 1\n}\n")
    Env.set("EIWA_MODULE_PATH", modBase)
    assert(findModuleFile(testTmp() + "/lspmod/a.ei", "utilx", "") == modBase + "/utilx.ei")
    assert(findModuleFile(testTmp() + "/lspmod/a.ei", "missing", "") == "")
    Env.unset("EIWA_MODULE_PATH")
}

test "projectRoots prefers src layout" {
    val rootBase = testTmp() + "/lsproot2"
    if (Dir.exists(rootBase + "/src") == false) {
        Dir.mkdir(rootBase)
        Dir.mkdir(rootBase + "/src")
    }
    val withSrc = projectRoots(rootBase)
    assert(withSrc.size() == 2)
    assert(withSrc.get(0) == rootBase + "/src")
    assert(withSrc.get(1) == rootBase)
    val flat = projectRoots(testTmp() + "/lspflat_nonexistent_xyz")
    assert(flat.size() == 1)
    assert(flat.get(0) == testTmp() + "/lspflat_nonexistent_xyz")
    assert(projectRoots("").size() == 0)
}

test "findModuleFile resolves root-relative imports against src" {
    val libBase = testTmp() + "/lsproot3"
    if (Dir.exists(libBase + "/src/lib") == false) {
        Dir.mkdir(libBase)
        Dir.mkdir(libBase + "/src")
        Dir.mkdir(libBase + "/src/lib")
    }
    File.write(libBase + "/src/lib/strings.ei", "fun trimmer(s: String): String {\n    return s\n}\n")
    assert(findModuleFile(libBase + "/src/main.ei", ".lib.strings", libBase) == libBase + "/src/lib/strings.ei")
    assert(findModuleFile(libBase + "/src/main.ei", ".lib.missing", libBase) == "")
    assert(findModuleFile(libBase + "/src/main.ei", ".lib.strings", "") == libBase + "/src/lib/strings.ei")
}

test "depSrcDirs resolves path deps against the project root" {
    val projBase = testTmp() + "/lspproj"
    if (Dir.exists(projBase + "/libs/mylib/src") == false) {
        Dir.mkdir(projBase)
        Dir.mkdir(projBase + "/libs")
        Dir.mkdir(projBase + "/libs/mylib")
        Dir.mkdir(projBase + "/libs/mylib/src")
    }
    File.write(projBase + "/eiwa.yaml", "name: demo\ndependencies:\n  mylib:\n    path: libs/mylib\n")
    File.write(projBase + "/libs/mylib/src/mylib.ei", "fun hello(): String {\n    return \"hi\"\n}\n")
    val dirs = depSrcDirs(projBase, "mylib")
    assert(dirs.size() == 1)
    assert(dirs.get(0) == projBase + "/libs/mylib/src")
    assert(findModuleFile(projBase + "/src/main.ei", "mylib", projBase) == projBase + "/libs/mylib/src/mylib.ei")
}

test "scanDeps tolerates comments and single quotes" {
    val raw = "# leading comment\ndependencies:\n  # a dep comment\n  arest:\n    git: https://example.com/arest.git # trailing comment\n    commit: 'abc123'\n"
    val deps = scanDeps(raw)
    assert(deps.size() == 1)
    assert(deps.get(0).name == "arest")
    assert(deps.get(0).commit == "abc123")
}

test "findModuleFile resolves nested dep layout without workspace root" {
    val walkBase = testTmp() + "/lspwalk"
    if (Dir.exists(walkBase + "/proj/libs/arest/src/arest") == false) {
        Dir.mkdir(walkBase)
        Dir.mkdir(walkBase + "/proj")
        Dir.mkdir(walkBase + "/proj/src")
        Dir.mkdir(walkBase + "/proj/src/deep")
        Dir.mkdir(walkBase + "/proj/libs")
        Dir.mkdir(walkBase + "/proj/libs/arest")
        Dir.mkdir(walkBase + "/proj/libs/arest/src")
        Dir.mkdir(walkBase + "/proj/libs/arest/src/arest")
    }
    File.write(walkBase + "/proj/eiwa.yaml", "name: demo\ndependencies:\n  arest:\n    path: libs/arest\n")
    File.write(walkBase + "/proj/libs/arest/src/arest/arest.ei", "fun arest(): Int {\n    return 1\n}\n")
    File.write(walkBase + "/proj/src/deep/main.ei", "import { arest } from \"arest.arest\"\n")
    assert(findModuleFile(walkBase + "/proj/src/deep/main.ei", "arest.arest", "") == walkBase + "/proj/libs/arest/src/arest/arest.ei")
}

test "importFileTarget opens the imported module" {
    val projBase = testTmp() + "/lspproj2"
    if (Dir.exists(projBase + "/libs/mylib/src") == false) {
        Dir.mkdir(projBase)
        Dir.mkdir(projBase + "/libs")
        Dir.mkdir(projBase + "/libs/mylib")
        Dir.mkdir(projBase + "/libs/mylib/src")
    }
    File.write(projBase + "/eiwa.yaml", "name: demo\ndependencies:\n  mylib:\n    path: libs/mylib\n")
    File.write(projBase + "/libs/mylib/src/mylib.ei", "fun hello(): String {\n    return \"hi\"\n}\n")
    Workspace.root = projBase
    val text = "import { hello } from \"mylib\"\ninit {\n    println(hello())\n}\n"
    assert(importFileTarget(text, "file://" + projBase + "/src/main.ei", "mylib") == projBase + "/libs/mylib/src/mylib.ei")
    assert(importFileTarget(text, "file://" + projBase + "/src/main.ei", "other") == "")
    Workspace.root = ""
}

test "scanSymbols finds declarations with 0-based lines" {
    val text = "type Counter(val base: Int) {\n    fun inc(): Int {\n        return this.base\n    }\n}"
    val syms = scanSymbols(text)
    assert(syms.size() == 2)
    assert(syms.get(0).name == "Counter")
    assert(syms.get(0).line == 0)
    assert(syms.get(1).name == "inc")
    assert(syms.get(1).line == 1)
    val found = findSymbol(syms, "inc")
    assert(found != null && found.line == 1)
    assert(findSymbol(syms, "missing") == null)
}

test "wordAt extracts the word under the cursor" {
    assert(wordAt("    fun inc(): Int {", 9) == "inc")
    assert(wordAt("    fun inc(): Int {", 4) == "fun")
    assert(wordAt("type Counter(val", 7) == "Counter")
    assert(wordAt("", 0) == "")
    assert(wordAt("   ", 1) == "")
}

test "lineAt indexes lines safely" {
    val text = "a\nb\nc"
    assert(lineAt(text, 0) == "a")
    assert(lineAt(text, 2) == "c")
    assert(lineAt(text, 5) == "")
}

test "uriToPath strips the file scheme" {
    assert(uriToPath("file:///tmp/x.ei") == "/tmp/x.ei")
    assert(uriToPath("untitled:Untitled-1") == "")
}

test "transport header parsing" {
    assert(isContentLength("Content-Length: 42") == true)
    assert(isContentLength("content-length: 42") == true)
    assert(isContentLength("Content-Type: foo") == false)
    val v = headerValue("Content-Length: 42")
    assert(v != null && v == "42")
    assert(headerValue("no-colon") == null)
}

test "parseTrailer splits file, line and column" {
    val d = parseTrailer("/tmp/err.ei:2:6")
    if (d != null) {
        assert(d.file == "/tmp/err.ei")
        assert(d.line == 2)
        assert(d.col == 6)
    } else {
        assert(false)
    }
    assert(parseTrailer("no-colons-here") == null)
}

test "checkOutputToDiags parses eiwac output" {
    val raw = "\nerror: Expected Int but found String for variable 'x'.\n  --> /tmp/err.ei:2:6\n   |\n 2 |     val x: Int = \"hello\"\n   |      ^\n   |\n\n"
    val diags = checkOutputToDiags(raw)
    assert(diags.size() == 1)
    assert(diags.get(0).severity == 1)
    assert(diags.get(0).line == 2)
    assert(diags.get(0).col == 6)
    assert(diags.get(0).message == "Expected Int but found String for variable 'x'.")
    assert(checkOutputToDiags("OK /tmp/ok.ei\n").size() == 0)
}

test "findLocalDecl resolves params on the signature and in the body" {
    val text = "fun renderVerificationPending(locale: String) {\n    println(locale)\n}"
    assert(findLocalDecl(text, 0, "locale") == 0)
    assert(findLocalDecl(text, 1, "locale") == 0)
    assert(findLocalDecl(text, 1, "missing") == -1)
}

test "findLocalDecl finds vals alongside params" {
    val text = "fun f(locale: String) {\n    val other = 1\n    println(locale, other)\n}"
    assert(findLocalDecl(text, 2, "locale") == 0)
    assert(findLocalDecl(text, 2, "other") == 1)
}

test "findLocalDecl misses closed siblings and top-level code" {
    val closed = "fun a() {\n    val locale = \"x\"\n}\nfun b() {\n    println(locale)\n}"
    assert(findLocalDecl(closed, 4, "locale") == -1)
    assert(findLocalDecl("val locale = \"x\"\nprintln(locale)", 1, "locale") == -1)
}

test "findLocalDecl follows multi-line signatures" {
    val text = "fun f(\n    locale: String\n) {\n    println(locale)\n}"
    assert(findLocalDecl(text, 3, "locale") == 0)
}

test "findLocalDecl misses lambda-shadowed params" {
    val text = "fun f(x: Int) {\n    val g = { x -> println(x) }\n}"
    assert(findLocalDecl(text, 1, "x") == -1)
}

test "findLocalDecl misses for-lambda shadowed names" {
    val text = "fun f(n: Int) {\n    for ([1, 2]) { n -> println(n) }\n    println(n)\n}"
    assert(findLocalDecl(text, 1, "n") == -1)
}

test "findLocalDecl still resolves the outer name without shadowing" {
    val text = "fun f(x: Int) {\n    val g = { y -> println(x, y) }\n}"
    assert(findLocalDecl(text, 1, "x") == 0)
}

test "scanSymbols registers extension funs under the method name" {
    val text = "fun BodyBuilder.renderVerificationState(ticket: String, locale: String) {\n}\nfun BodyBuilder.renderVerificationPending() {\n    renderVerificationState(\"t\", \"en\")\n}"
    val syms = scanSymbols(text)
    val m = findBestSymbol(syms, "renderVerificationState")
    if (m != null) {
        assert(m.line == 0)
        assert(m.kind == "fun")
        assert(m.container == "BodyBuilder")
    } else {
        assert(false)
    }
    assert(findBestSymbol(syms, "BodyBuilder") == null)
}
