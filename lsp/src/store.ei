// store.ei
// In-memory store of open documents (uri -> full text + version).

import { MutableMap } from "std.collections"
import { Process } from "std.process"
import { File } from "std.fs"

type OpenDoc(val uri: String, var text: String, var version: Int)

object DocStore {
    val docs: MutableMap<String, OpenDoc> = MutableMap<String, OpenDoc>()

    fun open(uri: String, text: String, version: Int) {
        if (DocStore.docs.contains(uri)) {
            val d = DocStore.docs[uri]
            if (d != null) {
                d.text = text
                d.version = version
            }
        } else {
            DocStore.docs.put(uri, OpenDoc(uri, text, version))
        }
    }

    fun change(uri: String, text: String, version: Int) {
        DocStore.open(uri, text, version)
    }

    fun close(uri: String) {
        // MutableMap has no remove yet: blank the entry so later
        // lookups treat it as closed.
        if (DocStore.docs.contains(uri)) {
            val d = DocStore.docs[uri]
            if (d != null) {
                d.text = ""
                d.version = -1
            }
        }
    }

    fun get(uri: String): OpenDoc? {
        val d = DocStore.docs[uri]
        if (d == null) {
            return null
        }
        if (d.version == -1) {
            return null
        }
        return d
    }

    fun textOf(uri: String): String? {
        val d = DocStore.get(uri)
        if (d == null) {
            return null
        }
        return d.text
    }
}

// `file:///tmp/x.ei` -> `/tmp/x.ei`. Returns "" for non-file URIs.
// A leading `/` before a drive letter (`file:///C:/x.ei`) is stripped:
// `/C:/...` is not a valid Windows path, `C:/...` is.
fun uriToPath(uri: String): String {
    if (uri.startsWith("file://")) {
        val p = uri.substring(7, uri.length)
        if (p.length >= 3 && p.substring(0, 1) == "/" && p.substring(2, 3) == ":") {
            return p.substring(1, p.length)
        }
        return p
    }
    return ""
}

// `/tmp/x.ei` -> `file:///tmp/x.ei`.
fun pathToUri(path: String): String {
    return "file://" + path
}

// Canonical absolute path (resolves `..`, symlinks). Falls back to input
// when unresolvable. The existence check keeps POSIX `realpath` semantics
// on Windows, where `_fullpath` succeeds even for nonexistent paths.
// Output always uses `/`: LSP locations (and `endsWith` matching) stay
// identical on every platform.
fun canonicalPath(path: String): String {
    if (path == "" || File.exists(path) == false) {
        return path
    }
    val rp = Process.realpath(path)
    if (rp == null) {
        return path
    }
    return rp.replace("\\", "/")
}

// Workspace root (project dir) from `initialize`, used to resolve
// root-relative (`.x`) module paths and project dependencies.
// Empty until initialized.
object Workspace {
    var root: String = ""
}
