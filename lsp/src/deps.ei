// deps.ei
// Project dependency resolution for go-to-definition into ecosystem packages.
// Mirrors the `eiwa` CLI layout: `path:` deps resolve against the project
// root, pinned (`commit:`) deps against `$HOME/.eiwa/repository/<name>/<commit>/src`.
// Unpinned deps fall back to whichever commit checkouts contain the module.
// `EIWA_MODULE_PATH` (colon-separated, `;` on Windows paths) adds extra roots.

import { List, MutableList } from "std.collections"
import { File, Dir } from "std.fs"
import { Env } from "std.env"
import { split } from "std.string"
import { resolveModule, resolveInRoot, dirOf, scanImports } from "analysis"
import { Workspace, uriToPath } from "store"

type Dep(val name: String, var path: String, var commit: String)

fun unquote(s: String): String {
    if (s.length >= 2) {
        val first = s.substring(0, 1)
        val last = s.substring(s.length - 1, s.length)
        if ((first == "\"" && last == "\"") || (first == "'" && last == "'")) {
            return s.substring(1, s.length - 1)
        }
    }
    return s
}

// Minimal parser for the `dependencies:` section of `eiwa.yaml`/`eiwa.freeze`.
// Mirrors the `eiwa` CLI manifest parser: the first indented line under
// `dependencies:` sets the entry level (any width, spaces or tabs); deeper
// lines are fields of the current entry. Blank lines and `#` comments are
// skipped; values honor quotes and trailing comments. Only `path:` and
// `commit:` are kept (enough to locate sources; git URLs need no parsing
// since unpinned deps fall back to scanning all checkouts).
fun indentOfRaw(line: String): Int {
    var n = 0
    while (n < line.length) {
        val c = line.substring(n, n + 1)
        if (c == " " || c == "\t") {
            n = n + 1
        } else {
            return n
        }
    }
    return n
}

fun isSpaceChar(c: String): Bool {
    return c == " " || c == "\t" || c == "\r" || c == "\n"
}

fun trimRaw(s: String): String {
    var start = 0
    var end = s.length
    while (start < end && isSpaceChar(s.substring(start, start + 1))) {
        start = start + 1
    }
    while (end > start && isSpaceChar(s.substring(end - 1, end))) {
        end = end - 1
    }
    return s.substring(start, end)
}

fun stripComment(s: String): String {
    var inSingle = false
    var inDouble = false
    var i = 0
    while (i < s.length) {
        val c = s.substring(i, i + 1)
        if (c == "'" && inDouble == false) {
            inSingle = inSingle == false
        } else if (c == "\"" && inSingle == false) {
            inDouble = inDouble == false
        } else if (c == "#" && inSingle == false && inDouble == false) {
            if (i == 0 || s.substring(i - 1, i) == " " || s.substring(i - 1, i) == "\t") {
                return s.substring(0, i)
            }
        }
        i = i + 1
    }
    return s
}

fun parseScalarRaw(s: String): String {
    return unquote(trimRaw(stripComment(s)))
}

fun scanDeps(text: String): List<Dep> {
    val out: MutableList<Dep> = MutableList<Dep>()
    val lines = text.split("\n")
    var inDeps = false
    var depIndent = -1
    var curIdx = -1
    var i = 0
    while (i < lines.size()) {
        val raw = lines.get(i)
        val trimmed = trimRaw(raw)
        if (trimmed != "" && trimmed.startsWith("#") == false) {
            val indent = indentOfRaw(raw)
            if (indent == 0) {
                inDeps = trimmed == "dependencies:"
                depIndent = -1
                curIdx = -1
            } else if (inDeps) {
                if (depIndent == -1) {
                    depIndent = indent
                }
                if (indent == depIndent && trimmed.endsWith(":")) {
                    out.add(Dep(trimmed.substring(0, trimmed.length - 1), "", ""))
                    curIdx = out.size() - 1
                } else if (indent > depIndent && curIdx != -1) {
                    val c = trimmed.indexOf(":")
                    if (c != -1) {
                        val key = trimRaw(trimmed.substring(0, c))
                        val value = parseScalarRaw(trimmed.substring(c + 1, trimmed.length))
                        val cur = out.get(curIdx)
                        if (key == "path") {
                            cur.path = value
                        }
                        if (key == "commit") {
                            cur.commit = value
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return out.freeze()
}

fun repoRoot(): String {
    val home = Env.get("HOME")
    if (home != null) {
        if (home != "") {
            return home + "/.eiwa/repository"
        }
    }
    val profile = Env.get("USERPROFILE")
    if (profile != null) {
        if (profile != "") {
            return profile + "/.eiwa/repository"
        }
    }
    return ""
}

// Extra module roots from the environment (same role as the compiler's
// repeated `--module-path` flag). `;` separates, with `:` as the Unix
// fallback; a lone drive letter (`C` in `C:\x`) is rejoined so single
// Windows entries survive the `:` fallback.
fun extraRoots(): List<String> {
    val out: MutableList<String> = MutableList<String>()
    val extra = Env.get("EIWA_MODULE_PATH")
    if (extra != null) {
        if (extra != "") {
            val sep = if (extra.contains(";")) ";" else ":"
            val parts = extra.split(sep)
            var i = 0
            while (i < parts.size()) {
                val p = parts.get(i).trim()
                if (p == "") {
                    i = i + 1
                } else if (p.length == 1 && i + 1 < parts.size() && (parts.get(i + 1).startsWith("/") || parts.get(i + 1).startsWith("\\"))) {
                    out.add(p + ":" + parts.get(i + 1).trim())
                    i = i + 2
                } else {
                    out.add(p)
                    i = i + 1
                }
            }
        }
    }
    return out.freeze()
}

fun manifestFile(root: String): String {
    if (root == "") {
        return ""
    }
    if (File.exists(root + "/eiwa.freeze")) {
        return root + "/eiwa.freeze"
    }
    if (File.exists(root + "/eiwa.yaml")) {
        return root + "/eiwa.yaml"
    }
    return ""
}

// Candidate `src/` dirs that can provide `pkg` (an ecosystem dependency).
fun depSrcDirs(root: String, pkg: String): List<String> {
    val out: MutableList<String> = MutableList<String>()
    if (root == "" || pkg == "") {
        return out.freeze()
    }
    val manifest = manifestFile(root)
    if (manifest == "") {
        return out.freeze()
    }
    val deps = scanDeps(File.read(manifest))
    var d = 0
    while (d < deps.size()) {
        val dep = deps.get(d)
        if (dep.name == pkg) {
            if (dep.path != "") {
                out.add(root + "/" + dep.path + "/src")
            } else if (dep.commit != "") {
                val repo = repoRoot()
                if (repo != "") {
                    out.add(repo + "/" + pkg + "/" + dep.commit + "/src")
                }
            } else {
                val repo = repoRoot()
                if (repo != "") {
                    val base = repo + "/" + pkg
                    val commits = Dir.names(base)
                    var c = 0
                    while (c < commits.size()) {
                        out.add(base + "/" + commits.get(c) + "/src")
                        c = c + 1
                    }
                }
            }
        }
        d = d + 1
    }
    return out.freeze()
}

// Candidate module roots for `.x` imports: the entry-file convention puts
// project code under `src/` (entry `src/main.ei` -> root `src/`), while the
// editor only knows the workspace folder. Try `<root>/src` first when it
// exists, then the root itself (flat layout).
fun projectRoots(root: String): List<String> {
    val out: MutableList<String> = MutableList<String>()
    if (root != "") {
        if (Dir.exists(root + "/src")) {
            out.add(root + "/src")
        }
        out.add(root)
    }
    return out.freeze()
}

// Nearest ancestor dir of `file` (or `file` itself when a dir) containing
// `eiwa.freeze`/`eiwa.yaml`. Walks up so files inside dependency checkouts
// or nested layouts resolve against their own manifest, not the workspace
// root. "" when no manifest is found.
fun manifestRootFor(file: String): String {
    var dir = dirOf(file)
    if (dir == "") {
        dir = file
    }
    var guard = 0
    while (dir != "" && guard < 64) {
        if (manifestFile(dir) != "") {
            return dir
        }
        val parent = dirOf(dir)
        if (parent == dir) {
            return ""
        }
        dir = parent
        guard = guard + 1
    }
    return ""
}

// Resolves a bare `a.b.c` module against one file + all known roots,
// returning the first path that exists on disk ("" when none does).
fun findModuleFile(currentPath: String, mod: String, root: String): String {
    if (currentPath == "" || mod == "") {
        return ""
    }
    var base = root
    if (base == "") {
        base = dirOf(currentPath)
    }
    if (mod.startsWith(".")) {
        val roots = projectRoots(base)
        var r = 0
        while (r < roots.size()) {
            val cand = resolveModule(currentPath, mod, roots.get(r))
            if (cand != "" && File.exists(cand)) {
                return cand
            }
            r = r + 1
        }
        return ""
    }
    if (mod.startsWith("std.")) {
        val cand = resolveModule(currentPath, mod, base)
        if (cand != "" && File.exists(cand)) {
            return cand
        }
        return ""
    }
    val direct = resolveModule(currentPath, mod, base)
    if (direct != "" && File.exists(direct)) {
        return direct
    }
    val extras = extraRoots()
    var i = 0
    while (i < extras.size()) {
        val cand = resolveInRoot(mod, extras.get(i))
        if (cand != "" && File.exists(cand)) {
            return cand
        }
        i = i + 1
    }
    // Dependencies mirror the compiler's `--module-path <dep>/src`: the full
    // dotted path maps under the dep src root (`arest.arest` ->
    // `<src>/arest/arest.ei`). Some packages instead lay sources out with the
    // package prefix stripped (`arest.arest` -> `<src>/arest.ei`); try both.
    // The manifest is looked up from the importing file upward so nested
    // layouts and dependency checkouts work regardless of workspace root.
    var manifestRoot = manifestRootFor(currentPath)
    if (manifestRoot == "") {
        manifestRoot = root
    }
    val dot = mod.indexOf(".")
    val pkg = if (dot == -1) mod else mod.substring(0, dot)
    val rest = if (dot == -1) mod else mod.substring(dot + 1, mod.length).replace(".", "/")
    val full = mod.replace(".", "/")
    val dirs = depSrcDirs(manifestRoot, pkg)
    var j = 0
    while (j < dirs.size()) {
        val stripped = dirs.get(j) + "/" + rest + ".ei"
        if (File.exists(stripped)) {
            return stripped
        }
        val kept = dirs.get(j) + "/" + full + ".ei"
        if (kept != "" && kept != stripped && File.exists(kept)) {
            return kept
        }
        j = j + 1
    }
    // Last resort: project sources (`src/` then root) for bare names, so
    // top-level project modules resolve from deeply nested importers.
    val proots = projectRoots(base)
    var p = 0
    while (p < proots.size()) {
        val cand = resolveInRoot(mod, proots.get(p))
        if (cand != "" && cand != direct && File.exists(cand)) {
            return cand
        }
        p = p + 1
    }
    return ""
}

// Resolves a click on a module path segment (`"std"` in `from "std.fs"`)
// to the module file itself. Callers jump to line 0.
fun importFileTarget(text: String, uri: String, word: String): String {
    val path = uriToPath(uri)
    if (path == "" || word == "") {
        return ""
    }
    val imports = scanImports(text)
    var i = 0
    while (i < imports.size()) {
        val segs = imports.get(i).path.split(".")
        var s = 0
        while (s < segs.size()) {
            if (segs.get(s) == word) {
                return findModuleFile(path, imports.get(i).path, Workspace.root)
            }
            s = s + 1
        }
        i = i + 1
    }
    return ""
}
