// server.ei
// JSON-RPC dispatch for the Eiwa language server (LSP 3.17, stdio).

import { parseJson, jsonEscape, JsonValue } from "std.json"
import { File } from "std.fs"
import { writeMessage } from "transport"
import { DocStore, uriToPath, pathToUri, canonicalPath, Workspace } from "store"
import { scanSymbols, findBestSymbol, findTopLevel, findContract, findContractMethod, findImplementations, findMember, receiverAt, isCapitalized, inferReceiverType, enclosingHolder, scanImports, locateImportPaths, importPathAtCursor, wordAt, lineAt, lspKeywords } from "analysis"
import { implicitModule, synthesisContract, contractFile } from "index"
import { findModuleFile, importFileTarget } from "deps"
import { publishDiagnostics, publishEmptyDiagnostics } from "diagnostics"

object Server {
    var shutdownRequested: Bool = false
}

fun respond(id: JsonValue, resultJson: String) {
    writeMessage("{\"jsonrpc\":\"2.0\",\"id\":" + id.write() + ",\"result\":" + resultJson + "}")
}

fun respondError(id: JsonValue, code: Int, message: String) {
    writeMessage("{\"jsonrpc\":\"2.0\",\"id\":" + id.write() + ",\"error\":{\"code\":" + code.toString() + ",\"message\":\"" + jsonEscape(message) + "\"}}")
}

fun getString(node: JsonValue?, key: String): String {
    if (node == null) {
        return ""
    }
    val v = node.get(key)
    if (v == null || v.isString() == false) {
        return ""
    }
    return v.asString()
}

fun getInt(node: JsonValue?, key: String): Int {
    if (node == null) {
        return 0
    }
    val v = node.get(key)
    if (v == null || v.isNumber() == false) {
        return 0
    }
    return v.asNumber().toInt()
}

fun getNode(node: JsonValue?, key: String): JsonValue? {
    if (node == null) {
        return null
    }
    return node.get(key)
}

fun bufferOrFile(uri: String): String? {
    val text = DocStore.textOf(uri)
    if (text != null) {
        return text
    }
    val path = uriToPath(uri)
    if (path != "" && File.exists(path)) {
        return File.read(path)
    }
    return null
}

fun completionKind(kind: String): Int {
    return when (kind) {
        "fun" -> 3
        "implement" -> 3
        "type" -> 7
        "contract" -> 8
        "skill" -> 5
        "object" -> 6
        "enum" -> 13
        "union" -> 7
        "lib" -> 5
        else -> 6
    }
}

fun handleInitialize(id: JsonValue, params: JsonValue?) {
    val rootUri = getString(params, "rootUri")
    if (rootUri != "") {
        Workspace.root = uriToPath(rootUri)
    } else {
        val rootPath = getString(params, "rootPath")
        if (rootPath != "") {
            Workspace.root = rootPath
        }
    }
    respond(id, "{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"definitionProvider\":true,\"implementationProvider\":true,\"documentSymbolProvider\":true,\"documentLinkProvider\":{\"resolveProvider\":false}},\"serverInfo\":{\"name\":\"eiwa-lsp\",\"version\":\"0.1.0\"}}")
}

// Finds the on-disk module file a used name was imported from.
// Falls back to implicit stdlib names (`repeat`, `task`, `String`…).
// Returns "" when the name is not resolvable.
fun resolveImportTarget(text: String, uri: String, word: String): String {
    val path = uriToPath(uri)
    if (path == "" || word == "") {
        return ""
    }
    val imports = scanImports(text)
    var i = 0
    while (i < imports.size()) {
        if (imports.get(i).names.contains(word)) {
            val cand = findModuleFile(path, imports.get(i).path, Workspace.root)
            if (cand != "") {
                return cand
            }
        }
        i = i + 1
    }
    val implicit = implicitModule(word)
    if (implicit != "") {
        val cand = findModuleFile(path, implicit, Workspace.root)
        if (cand != "") {
            return cand
        }
    }
    return ""
}

// Cross-file lookup order: explicitly imported or implicit top-level
// declaration first (lexical scope wins), then synthesized methods at
// their contract, then any imported module declaring the name.
fun findCrossFile(text: String, uri: String, word: String): MemberHit {
    val tpath = resolveImportTarget(text, uri, word)
    if (tpath != "" && File.exists(tpath)) {
        val ttext = bufferOrFile(pathToUri(tpath))
        if (ttext != null) {
            val tsym = findTopLevel(scanSymbols(ttext), word)
            if (tsym != null) {
                return MemberHit(pathToUri(canonicalPath(tpath)), tsym.line, tsym.kind, tsym.detail, true)
            }
        }
    }
    val contractName = synthesisContract(word)
    if (contractName != "") {
        val cfile = contractFile(contractName)
        if (cfile != "" && File.exists(cfile)) {
            val ctext = bufferOrFile(pathToUri(cfile))
            if (ctext != null) {
                val csyms = scanSymbols(ctext)
                val cmeth = findContractMethod(csyms, contractName, word)
                if (cmeth != null) {
                    return MemberHit(pathToUri(canonicalPath(cfile)), cmeth.line, cmeth.kind, cmeth.detail, true)
                }
                val csym = findContract(csyms, contractName)
                if (csym != null) {
                    return MemberHit(pathToUri(canonicalPath(cfile)), csym.line, csym.kind, csym.detail, true)
                }
            }
        }
    }
    return findInImports(text, uri, word)
}

// Best-effort: first imported module (in order) declaring `word`.
// Used when the name itself was never imported (e.g. a method reached
// through its holder: `import { Box }` + `b.open()` with unknown `b`).
fun findInImports(text: String, uri: String, word: String): MemberHit {
    val path = uriToPath(uri)
    if (path == "" || word == "") {
        return MemberHit(uri, 0, "", "", false)
    }
    val imports = scanImports(text)
    var i = 0
    while (i < imports.size()) {
        val cand = findModuleFile(path, imports.get(i).path, Workspace.root)
        if (cand != "" && File.exists(cand)) {
            val ttext = bufferOrFile(pathToUri(cand))
            if (ttext != null) {
                val tsym = findBestSymbol(scanSymbols(ttext), word)
                if (tsym != null) {
                    return MemberHit(pathToUri(canonicalPath(cand)), tsym.line, tsym.kind, tsym.detail, true)
                }
            }
        }
        i = i + 1
    }
    return MemberHit(uri, 0, "", "", false)
}

type MemberHit(val uri: String, val line: Int, val kind: String, val detail: String, val found: Bool)

// Resolves `Recv.method` calls. The holder is the capitalized `Recv` itself,
// `this` (enclosing holder), or a local inferred from its declaration
// (`val b = Box()` / `val b: Box` / `fun f(b: Box)`). Falls back to a miss
// so plain name lookup still applies.
fun resolveMemberTarget(text: String, uri: String, line: Int, character: Int, word: String): MemberHit {
    val recv = receiverAt(lineAt(text, line), character)
    if (recv == "") {
        return MemberHit(uri, 0, "", "", false)
    }
    var holder = ""
    if (recv == "this") {
        holder = enclosingHolder(text, line)
    } else if (isCapitalized(recv)) {
        holder = recv
    } else {
        holder = inferReceiverType(text, line, recv)
    }
    if (holder == "") {
        return MemberHit(uri, 0, "", "", false)
    }
    val syms = scanSymbols(text)
    val h = findBestSymbol(syms, holder)
    if (h != null) {
        val m = findMember(syms, h.line, word)
        if (m != null) {
            return MemberHit(uri, m.line, m.kind, m.detail, true)
        }
        return MemberHit(uri, 0, "", "", false)
    }
    val tpath = resolveImportTarget(text, uri, holder)
    if (tpath != "" && File.exists(tpath)) {
        val ttext = bufferOrFile(pathToUri(tpath))
        if (ttext != null) {
            val tsyms = scanSymbols(ttext)
            val th = findBestSymbol(tsyms, holder)
            if (th != null) {
                val m = findMember(tsyms, th.line, word)
                if (m != null) {
                    return MemberHit(pathToUri(canonicalPath(tpath)), m.line, m.kind, m.detail, true)
                }
            }
        }
    }
    return MemberHit(uri, 0, "", "", false)
}

fun handleDidOpen(params: JsonValue?) {
    val td = getNode(params, "textDocument")
    val uri = getString(td, "uri")
    val text = getString(td, "text")
    val version = getInt(td, "version")
    if (uri == "") {
        return
    }
    DocStore.open(uri, text, version)
    publishDiagnostics(uri)
}

fun handleDidChange(params: JsonValue?) {
    val td = getNode(params, "textDocument")
    val uri = getString(td, "uri")
    val version = getInt(td, "version")
    if (uri == "") {
        return
    }
    val changes = getNode(params, "contentChanges")
    if (changes == null || changes.isArray() == false) {
        return
    }
    val first = changes.getIndex(0)
    if (first == null) {
        return
    }
    val text = getString(first, "text")
    DocStore.change(uri, text, version)
}

fun handleDidSave(params: JsonValue?) {
    val td = getNode(params, "textDocument")
    val uri = getString(td, "uri")
    if (uri == "") {
        return
    }
    publishDiagnostics(uri)
}

fun handleDidClose(params: JsonValue?) {
    val td = getNode(params, "textDocument")
    val uri = getString(td, "uri")
    if (uri == "") {
        return
    }
    DocStore.close(uri)
    publishEmptyDiagnostics(uri)
}

fun handleHover(id: JsonValue, params: JsonValue?) {
    val uri = getString(getNode(params, "textDocument"), "uri")
    val pos = getNode(params, "position")
    val line = getInt(pos, "line")
    val character = getInt(pos, "character")
    val text = bufferOrFile(uri)
    if (text == null) {
        respond(id, "null")
        return
    }
    val hoverPath = importPathAtCursor(lineAt(text, line), character)
    if (hoverPath != "") {
        val mf = findModuleFile(uriToPath(uri), hoverPath, Workspace.root)
        if (mf != "") {
            val hvalue = "`" + hoverPath + "` → `" + mf + "`"
            respond(id, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + jsonEscape(hvalue) + "\"}}")
            return
        }
        respond(id, "null")
        return
    }
    val word = wordAt(lineAt(text, line), character)
    if (word == "") {
        respond(id, "null")
        return
    }
    val hit = resolveMemberTarget(text, uri, line, character, word)
    if (hit.found) {
        val hvalue = "```eiwa\n" + hit.detail + "\n```\n_" + hit.kind + " • " + hit.uri + ":" + (hit.line + 1).toString() + "_"
        respond(id, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + jsonEscape(hvalue) + "\"}}")
        return
    }
    val sym = findBestSymbol(scanSymbols(text), word)
    if (sym == null) {
        val xhit = findCrossFile(text, uri, word)
        if (xhit.found) {
            val value = "```eiwa\n" + xhit.detail + "\n```\n_" + xhit.kind + " • " + xhit.uri + ":" + (xhit.line + 1).toString() + "_"
            respond(id, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + jsonEscape(value) + "\"}}")
            return
        }
        val modFile = importFileTarget(text, uri, word)
        if (modFile != "") {
            val mvalue = "`" + word + "` → `" + modFile + "`"
            respond(id, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + jsonEscape(mvalue) + "\"}}")
            return
        }
        respond(id, "null")
        return
    }
    val value = "```eiwa\n" + sym.detail + "\n```\n_" + sym.kind + " • line " + (sym.line + 1).toString() + "_"
    respond(id, "{\"contents\":{\"kind\":\"markdown\",\"value\":\"" + jsonEscape(value) + "\"}}")
}

fun handleCompletion(id: JsonValue, params: JsonValue?) {
    val uri = getString(getNode(params, "textDocument"), "uri")
    val pos = getNode(params, "position")
    val line = getInt(pos, "line")
    val character = getInt(pos, "character")
    val text = bufferOrFile(uri)
    var prefix = ""
    if (text != null) {
        val lineText = lineAt(text, line)
        val upto = if (character < lineText.length) lineText.substring(0, character) else lineText
        var i = upto.length
        while (i > 0) {
            if ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789".indexOf(upto.charAt(i - 1)) == -1) {
                leave
            }
            i = i - 1
        }
        prefix = upto.substring(i, upto.length)
    }
    var items = ""
    var count = 0
    val kws = lspKeywords()
    var k = 0
    while (k < kws.size()) {
        val kw = kws.get(k)
        if (prefix == "" || kw.startsWith(prefix)) {
            if (count > 0) {
                items = items + ","
            }
            items = items + "{\"label\":\"" + kw + "\",\"kind\":14}"
            count = count + 1
        }
        k = k + 1
    }
    if (text != null) {
        val syms = scanSymbols(text)
        var s = 0
        while (s < syms.size()) {
            val sym = syms.get(s)
            if (sym.name.startsWith(prefix)) {
                if (count > 0) {
                    items = items + ","
                }
                items = items + "{\"label\":\"" + jsonEscape(sym.name) + "\",\"kind\":" + completionKind(sym.kind).toString() + "}"
                count = count + 1
            }
            s = s + 1
        }
    }
    respond(id, "{\"isIncomplete\":false,\"items\":[" + items + "]}")
}

fun handleDefinition(id: JsonValue, params: JsonValue?) {
    val uri = getString(getNode(params, "textDocument"), "uri")
    val pos = getNode(params, "position")
    val line = getInt(pos, "line")
    val character = getInt(pos, "character")
    val text = bufferOrFile(uri)
    if (text == null) {
        respond(id, "null")
        return
    }
    val word = wordAt(lineAt(text, line), character)
    if (word == "") {
        respond(id, "null")
        return
    }
    val pathHit = importPathAtCursor(lineAt(text, line), character)
    if (pathHit != "") {
        val mf = findModuleFile(uriToPath(uri), pathHit, Workspace.root)
        if (mf != "" && File.exists(mf)) {
            respond(id, "{\"uri\":\"" + jsonEscape(pathToUri(canonicalPath(mf))) + "\",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}}}")
            return
        }
        respond(id, "null")
        return
    }
    val hit = resolveMemberTarget(text, uri, line, character, word)
    if (hit.found) {
        respond(id, "{\"uri\":\"" + jsonEscape(hit.uri) + "\",\"range\":{\"start\":{\"line\":" + hit.line.toString() + ",\"character\":0},\"end\":{\"line\":" + hit.line.toString() + ",\"character\":0}}}")
        return
    }
    val sym = findBestSymbol(scanSymbols(text), word)
    if (sym != null) {
        respond(id, "{\"uri\":\"" + jsonEscape(uri) + "\",\"range\":{\"start\":{\"line\":" + sym.line.toString() + ",\"character\":0},\"end\":{\"line\":" + sym.line.toString() + ",\"character\":0}}}")
        return
    }
    val cross = findCrossFile(text, uri, word)
    if (cross.found) {
        respond(id, "{\"uri\":\"" + jsonEscape(cross.uri) + "\",\"range\":{\"start\":{\"line\":" + cross.line.toString() + ",\"character\":0},\"end\":{\"line\":" + cross.line.toString() + ",\"character\":0}}}")
        return
    }
    val modFile = importFileTarget(text, uri, word)
    if (modFile != "") {
        respond(id, "{\"uri\":\"" + jsonEscape(pathToUri(canonicalPath(modFile))) + "\",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}}}")
        return
    }
    respond(id, "null")
}

fun handleImplementation(id: JsonValue, params: JsonValue?) {
    val uri = getString(getNode(params, "textDocument"), "uri")
    val pos = getNode(params, "position")
    val line = getInt(pos, "line")
    val character = getInt(pos, "character")
    val text = bufferOrFile(uri)
    if (text == null) {
        respond(id, "null")
        return
    }
    val word = wordAt(lineAt(text, line), character)
    if (word == "") {
        respond(id, "null")
        return
    }
    var turi = uri
    var impls = findImplementations(scanSymbols(text), word)
    if (impls.size() == 0) {
        val tpath = resolveImportTarget(text, uri, word)
        if (tpath != "" && File.exists(tpath)) {
            val ttext = bufferOrFile(pathToUri(tpath))
            if (ttext != null) {
                impls = findImplementations(scanSymbols(ttext), word)
                turi = pathToUri(canonicalPath(tpath))
            }
        }
    }
    var arr = ""
    var s = 0
    while (s < impls.size()) {
        if (s > 0) {
            arr = arr + ","
        }
        val ln = impls.get(s).line
        arr = arr + "{\"uri\":\"" + jsonEscape(turi) + "\",\"range\":{\"start\":{\"line\":" + ln.toString() + ",\"character\":0},\"end\":{\"line\":" + ln.toString() + ",\"character\":0}}}"
        s = s + 1
    }
    respond(id, "[" + arr + "]")
}

fun handleDocumentSymbol(id: JsonValue, params: JsonValue?) {
    val uri = getString(getNode(params, "textDocument"), "uri")
    val text = bufferOrFile(uri)
    if (text == null) {
        respond(id, "null")
        return
    }
    val syms = scanSymbols(text)
    var arr = ""
    var s = 0
    while (s < syms.size()) {
        val sym = syms.get(s)
        if (s > 0) {
            arr = arr + ","
        }
        arr = arr + "{\"name\":\"" + jsonEscape(sym.name) + "\",\"kind\":" + completionKind(sym.kind).toString() + ",\"range\":{\"start\":{\"line\":" + sym.line.toString() + ",\"character\":0},\"end\":{\"line\":" + sym.line.toString() + ",\"character\":0}},\"selectionRange\":{\"start\":{\"line\":" + sym.line.toString() + ",\"character\":0},\"end\":{\"line\":" + sym.line.toString() + ",\"character\":0}}}"
        s = s + 1
    }
    respond(id, "[" + arr + "]")
}

// Every import path as one clickable link spanning the whole quoted
// string (`from ".lib.strings"`), pointing at the resolved module file.
fun handleDocumentLink(id: JsonValue, params: JsonValue?) {
    val uri = getString(getNode(params, "textDocument"), "uri")
    val text = bufferOrFile(uri)
    if (text == null) {
        respond(id, "null")
        return
    }
    val base = uriToPath(uri)
    var arr = ""
    var count = 0
    if (base != "") {
        val paths = locateImportPaths(text)
        var i = 0
        while (i < paths.size()) {
            val cand = findModuleFile(base, paths.get(i).path, Workspace.root)
            if (cand != "" && File.exists(cand)) {
                if (count > 0) {
                    arr = arr + ","
                }
                val ln = paths.get(i).line
                arr = arr + "{\"range\":{\"start\":{\"line\":" + ln.toString() + ",\"character\":" + paths.get(i).start.toString() + "},\"end\":{\"line\":" + ln.toString() + ",\"character\":" + paths.get(i).end.toString() + "}},\"target\":\"" + jsonEscape(pathToUri(canonicalPath(cand))) + "\"}"
                count = count + 1
            }
            i = i + 1
        }
    }
    respond(id, "[" + arr + "]")
}

fun handleMessage(raw: String) {
    val root = parseJson(raw)
    val methodVal = root.get("method")
    if (methodVal == null || methodVal.isString() == false) {
        return
    }
    val method = methodVal.asString()
    val id = root.get("id")
    val params = root.get("params")

    when (method) {
        "initialize" -> {
            if (id != null) {
                handleInitialize(id, params)
            }
        }
        "initialized" -> {}
        "shutdown" -> {
            Server.shutdownRequested = true
            if (id != null) {
                respond(id, "null")
            }
        }
        "exit" -> {
            if (Server.shutdownRequested) {
                exit(0)
            }
            exit(1)
        }
        "textDocument/didOpen" -> {
            handleDidOpen(params)
        }
        "textDocument/didChange" -> {
            handleDidChange(params)
        }
        "textDocument/didSave" -> {
            handleDidSave(params)
        }
        "textDocument/didClose" -> {
            handleDidClose(params)
        }
        "textDocument/hover" -> {
            if (id != null) {
                handleHover(id, params)
            }
        }
        "textDocument/completion" -> {
            if (id != null) {
                handleCompletion(id, params)
            }
        }
        "textDocument/definition" -> {
            if (id != null) {
                handleDefinition(id, params)
            }
        }
        "textDocument/implementation" -> {
            if (id != null) {
                handleImplementation(id, params)
            }
        }
        "textDocument/documentSymbol" -> {
            if (id != null) {
                handleDocumentSymbol(id, params)
            }
        }
        "textDocument/documentLink" -> {
            if (id != null) {
                handleDocumentLink(id, params)
            }
        }
        else -> {
            if (id != null) {
                respondError(id, -32601, "method not found: " + method)
            }
        }
    }
}
