import { Coroutine } from "std.coroutines"
import { Leave } from "std.exceptions"

fun loop(@Leaveable block: () -> Void) {
    try {
        while (true) {
            block()
        }
    } catch (e: Leave) {}
}

fun repeat(count: Int, @Leaveable block: (Int) -> Void) {
    try {
        var i = 0

        while (i < count) {
            block(i)
            i = i + 1
        }
    } catch (e: Leave) {}
}

fun retry(times: Int, @Leaveable block: (Int) -> Void) {
    var err: Throwable | Null = null
    var attempt = 0

    while (attempt < times) {
        try {
            block(attempt)
            return
        } catch (e: Leave) {
            err = null
            leave
        } catch (e: Throwable) {
            err = e
            attempt = attempt + 1
        }
    }

    if (err != null) {
        throw err
    }
}

fun sleep(seconds: Int): Void {
    Coroutine.sleep(seconds * 1000000000)
}

fun sleepMs(ms: Int): Void {
    Coroutine.sleepMs(ms)
}

fun yield(): Void {
    Coroutine.yield()
}

fun park(): Void {
    Coroutine.park()
}

fun exit(code: Int): Void {
    Standard.exit(code)
}