// std.collections
// Powered by True Generics and Native Arrays!

import { Json } from "std.json"
import { Serializable, SerdeField, SerdeList, SerdeObjectList, SerdeValue, SerdeString, SerdeObject } from "std.serde"

type MutableList<T>(val list: List<T> = []) : Serializable + Json {
    fun add(element: T): Void {
        this.list.items.push(element)
    }

    operator fun get(index: Int): T {
        return this.list.items[index]
    }

    operator fun set(index: Int, element: T): Void {
        this.list.items[index] = element
    }

    fun remove(index: Int): Void {
        // Shifting elements left
        var i = index
        while (i < this.list.items.length - 1) {
            this.list.items[i] = this.list.items[i + 1]
            i = i + 1
        }
    }

    fun size(): Int {
        return this.list.items.length
    }

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0

    fun freeze(): List<T> {
        return this.list
    }

    implement fun serialize(): SerdeValue = this.list.serialize()
}

type List<T>(val items: NativeArray<T> = []) : Equatable, Serializable + Json {
    operator fun get(index: Int): T {
        return this.items[index]
    }

    fun size(): Int {
        return this.items.length
    }

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0

    implement operator fun equals(other: Equatable): Bool {
        if (other is List<T>) {
            val otherList = other as List<T>
            if (this.size() != otherList.size()) {
                return false
            }
            var i = 0
            while (i < this.size()) {
                if (this.get(i) != otherList.get(i)) {
                    return false
                }
                i = i + 1
            }
            return true
        }
        return false
    }

    fun mut(): MutableList<T> {
        return MutableList(this)
    }
}

type Node<K, V>(val key: K, var value: V, var next: Node<K, V>?) {
    implement fun toString(): String = ""
}

type MutableMap<K, V>(val entries: List<Node<K, V>?> = []) : Serializable + Json {
    operator fun put(key: K, value: V): Void {
        var capacity = this.entries.size()
        if (capacity == 0) {
            var i = 0
            while (i < 16) {
                this.entries.items.push(null)
                i = i + 1
            }
            capacity = this.entries.size()
        }

        var hash = key.hashCode()
        var index = hash - (hash / capacity) * capacity
        if (index < 0) {
            index = index + capacity
        }

        var curr = this.entries.items[index]
        while (curr != null) {
            if (curr!!.key == key) {
                curr!!.value = value
                return
            }
            curr = curr!!.next
        }

        val newNode = Node(key, value, this.entries.items[index])
        this.entries.items[index] = newNode
    }

    operator fun get(key: K): V? {
        val capacity = this.entries.size()
        if (capacity == 0) {
            return null
        }

        var hash = key.hashCode()
        var index = hash - (hash / capacity) * capacity
        if (index < 0) index = index + capacity

        var curr = this.entries.items[index]
        while (curr != null) {
            if (curr!!.key == key) {
                return curr!!.value
            }
            curr = curr!!.next
        }
        return null
    }

    fun containsKey(key: K): Bool {
        return this.get(key) != null
    }

    fun size(): Int {
        var count = 0
        var i = 0
        while (i < this.entries.size()) {
            var curr = this.entries.items[i]
            while (curr != null) {
                count = count + 1
                curr = curr!!.next
            }
            i = i + 1
        }
        return count
    }

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0

    fun freeze(): Map<K, V> = Map(this.entries)

    fun serdeFields(): List<SerdeField> = Map(this.entries).serdeFields()
    implement fun serialize(): SerdeValue = Map(this.entries).serialize()
}

type Map<K, V>(val entries: List<Node<K, V>?> = []) : Serializable + Json {
    operator fun get(key: K): V? {
        val capacity = this.entries.size()
        if (capacity == 0) {
            return null
        }

        var hash = key.hashCode()
        var index = hash - (hash / capacity) * capacity
        if (index < 0) index = index + capacity

        var curr = this.entries.items[index]
        while (curr != null) {
            if (curr!!.key == key) {
                return curr!!.value
            }
            curr = curr!!.next
        }
        return null
    }

    fun containsKey(key: K): Bool {
        return this.get(key) != null
    }

    fun size(): Int {
        var count = 0
        var i = 0
        while (i < this.entries.size()) {
            var curr = this.entries.items[i]
            while (curr != null) {
                count = count + 1
                curr = curr!!.next
            }
            i = i + 1
        }
        return count
    }

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0

    fun mut(): MutableMap<K, V> = MutableMap(this.entries)

    fun serdeFields(): List<SerdeField> {
        val fields = MutableList<SerdeField>()
        var i = 0
        while (i < this.entries.size()) {
            var curr = this.entries.items[i]
            while (curr != null) {
                fields.add(SerdeField(curr!!.key.toString(), SerdeString(curr!!.value.toString())))
                curr = curr!!.next
            }
            i = i + 1
        }
        return fields.freeze()
    }

    implement fun serialize(): SerdeValue = SerdeObject(this.serdeFields())
}

type MutableSet<T>(val map: MutableMap<T, Bool> = MutableMap()) {
    fun add(element: T): Void {
        this.map.put(element, true)
    }

    fun contains(element: T): Bool {
        return this.map.containsKey(element)
    }

    fun size(): Int = this.map.size()

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0

    fun freeze(): Set<T> = Set(this.map.freeze())
}

type Set<T>(val map: Map<T, Bool> = Map()) {
    fun contains(element: T): Bool {
        return this.map.containsKey(element)
    }

    fun size(): Int = this.map.size()

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0

    fun mut(): MutableSet<T> {
        val m = MutableSet<T>()
        var i = 0
        while (i < this.map.entries.size()) {
            var curr = this.map.entries.items[i]
            while (curr != null) {
                m.add(curr!!.key)
                curr = curr!!.next
            }
            i = i + 1
        }
        return m
    }
}
