// std.collections
// Powered by True Generics and Native Arrays!

import { Json } from "std.json"
import { Serializable, SerdeField, SerdeList, SerdeObjectList, SerdeValue, SerdeString, SerdeObject } from "std.serde"
import { StackTask } from "std.coroutines"

skill Slicing : Indexed<T> {

    implement fun slice(start: Int, end: Int): List<T> {
        var startPos = start
        if (startPos < 0) {
            startPos = 0
        }
        var endPos = end
        if (endPos > this.size()) {
            endPos = this.size()
        }
        val out = MutableList<T>()
        var i = startPos
        while (i < endPos) {
            out.add(this.get(i))
            i = i + 1
        }
        return out.freeze()
    }

    implement fun skip(n: Int): List<T> = this.slice(n, this.size())

    implement fun take(n: Int): List<T> = this.slice(0, n)

    implement fun skipLast(n: Int): List<T> = this.slice(0, this.size() - n)

    implement fun takeLast(n: Int): List<T> = this.slice(this.size() - n, this.size())
}

skill Appending : Indexed<T> {

    operator fun plus(element: T): List<T> {
        val result = MutableList<T>()
        var i = 0
        while (i < this.size()) {
            result.add(this.get(i))
            i = i + 1
        }
        result.add(element)
        return result.freeze()
    }

    operator fun plus(other: List<T>): List<T> {
        val result = MutableList<T>()
        var i = 0
        while (i < this.size()) {
            result.add(this.get(i))
            i = i + 1
        }
        var j = 0
        while (j < other.size()) {
            result.add(other.get(j))
            j = j + 1
        }
        return result.freeze()
    }
}

skill Joining : Indexed<T> {

    fun joinToString(separator: String = ", ", prefix: String = "", postfix: String = "", limit: Int = -1, truncated: String = "..."): String {
        var result = prefix
        val count = this.size()
        var lim = count
        var trunc = false
        if (limit >= 0 && count > limit) {
            lim = limit
            trunc = true
        }
        var i = 0
        while (i < lim) {
            if (i > 0) {
                result = result + separator
            }
            val e: T = this.get(i)
            result = result + (e?.toString() ?: "null")
            i = i + 1
        }
        if (trunc) {
            if (lim > 0) {
                result = result + separator
            }
            result = result + truncated
        }
        result = result + postfix
        return result
    }

    fun joinToString(transform: (T) -> String, separator: String = ", ", prefix: String = "", postfix: String = "", limit: Int = -1, truncated: String = "..."): String {
        var result = prefix
        val count = this.size()
        var lim = count
        var trunc = false
        if (limit >= 0 && count > limit) {
            lim = limit
            trunc = true
        }
        var i = 0
        while (i < lim) {
            if (i > 0) {
                result = result + separator
            }
            result = result + transform(this.get(i))
            i = i + 1
        }
        if (trunc) {
            if (lim > 0) {
                result = result + separator
            }
            result = result + truncated
        }
        result = result + postfix
        return result
    }
}

skill Filtering : Indexed<T> {

    fun filter(predicate: (T) -> Bool): List<T> {
        val out = MutableList<T>()
        var i = 0
        while (i < this.size()) {
            val e: T = this.get(i)
            if (predicate(e)) {
                out.add(e)
            }
            i = i + 1
        }
        return out.freeze()
    }

    fun filterNot(predicate: (T) -> Bool): List<T> {
        val out = MutableList<T>()
        var i = 0
        while (i < this.size()) {
            val e: T = this.get(i)
            if (!predicate(e)) {
                out.add(e)
            }
            i = i + 1
        }
        return out.freeze()
    }

    fun filterIndexed(predicate: (Int, T) -> Bool): List<T> {
        val out = MutableList<T>()
        var i = 0
        while (i < this.size()) {
            val e: T = this.get(i)
            if (predicate(i, e)) {
                out.add(e)
            }
            i = i + 1
        }
        return out.freeze()
    }

    fun count(predicate: (T) -> Bool): Int {
        var n = 0
        var i = 0
        while (i < this.size()) {
            if (predicate(this.get(i))) {
                n = n + 1
            }
            i = i + 1
        }
        return n
    }
}

skill Searching : Indexed<T> {

    implement fun isEmpty(): Bool = this.size() == 0

    implement fun isNotEmpty(): Bool = this.size() > 0

    implement fun contains(element: T): Bool {
        var i = 0
        while (i < this.size()) {
            if (this.get(i) == element) {
                return true
            }
            i = i + 1
        }
        return false
    }

    implement fun indexOf(element: T): Int {
        var i = 0
        while (i < this.size()) {
            if (this.get(i) == element) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    implement fun first(): T = this.get(0)

    implement fun last(): T = this.get(this.size() - 1)
}

type MutableList<T>(val list: List<T> = []): Slicable<T>, Indexed<T>, Searchable<T>, Serializable + Slicing + Json + Appending + Searching + Joining + Filtering {
    fun add(element: T): Void {
        this.list.items.push(element)
    }

    fun add(elements: List<T>): Void {
        var i = 0
        while (i < elements.size()) {
            this.list.items.push(elements.get(i))
            i = i + 1
        }
    }

    fun addAll(elements: List<T>): Void {
        this.add(elements)
    }

    implement operator fun get(index: Int): T {
        return this.list.items[index]
    }

    operator fun set(index: Int, element: T): Void {
        this.list.items[index] = element
    }

    fun remove(index: Int): Void {
        // Shifting elements left
        var i = index
        while (i < this.list.items.length - 1) {
            this.list.items[i] = this.list.items[i + 1]
            i = i + 1
        }
    }

    implement fun size(): Int {
        return this.list.items.length
    }

    fun freeze(): List<T> {
        return this.list
    }

    implement fun toString(): String = this.list.toString()

    implement fun serialize(): SerdeValue = this.list.serialize()
}

type List<T>(val items: NativeArray<T> = []): Equatable, Slicable<T>, Indexed<T>, Searchable<T>, Serializable + Slicing + Json + Appending + Searching + Joining + Filtering {

    implement operator fun get(index: Int): T {
        return this.items[index]
    }

    implement fun size(): Int {
        return this.items.length
    }

    implement operator fun equals(other: Equatable): Bool {
        if (other is List<T>) {
            val otherList = other as List<T>
            if (this.size() != otherList.size()) {
                return false
            }
            var i = 0
            while (i < this.size()) {
                if (this.get(i) != otherList.get(i)) {
                    return false
                }
                i = i + 1
            }
            return true
        }
        return false
    }

    fun mut(): MutableList<T> = MutableList(this)

    implement fun toString(): String {
        var result = "["
        var i = 0
        while (i < this.items.length) {
            val e: T = this.items[i]
            result = result + (e?.toString() ?: "null")
            if (i < this.items.length - 1) {
                result = result + ", "
            }
            i = i + 1
        }
        result = result + "]"
        return result
    }
}

type Node<K, V>(val key: K, var value: V, var next: Node<K, V>?) {
    implement fun toString(): String = "Node(key=${this.key}, value=${this.value})"
}

type MutableMap<K, V>(val entries: List<Node<K, V>?> = []) : Serializable + Json {

    operator fun put(key: K, value: V): Void {
        var capacity = this.entries.size()
        if (capacity == 0) {
            var i = 0
            while (i < 16) {
                this.entries.items.push(null)
                i = i + 1
            }
            capacity = this.entries.size()
        }

        var hash = key.hashCode()
        var index = hash - (hash / capacity) * capacity
        if (index < 0) {
            index = index + capacity
        }

        var curr = this.entries.items[index]
        while (curr != null) {
            if (curr!!.key == key) {
                curr!!.value = value
                return
            }
            curr = curr!!.next
        }

        val newNode = Node(key, value, this.entries.items[index])
        this.entries.items[index] = newNode
    }

    operator fun get(key: K): V? {
        val capacity = this.entries.size()
        if (capacity == 0) {
            return null
        }

        var hash = key.hashCode()
        var index = hash - (hash / capacity) * capacity
        if (index < 0) index = index + capacity

        var curr = this.entries.items[index]
        while (curr != null) {
            if (curr!!.key == key) {
                return curr!!.value
            }
            curr = curr!!.next
        }
        return null
    }

    fun contains(key: K): Bool {
        val capacity = this.entries.size()
        if (capacity == 0) {
            return false
        }

        var hash = key.hashCode()
        var index = hash - (hash / capacity) * capacity
        if (index < 0) index = index + capacity

        var curr = this.entries.items[index]
        while (curr != null) {
            if (curr!!.key == key) {
                return true
            }
            curr = curr!!.next
        }
        return false
    }

    fun size(): Int {
        var count = 0
        var i = 0
        while (i < this.entries.size()) {
            var curr = this.entries.items[i]
            while (curr != null) {
                count = count + 1
                curr = curr!!.next
            }
            i = i + 1
        }
        return count
    }

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0

    fun freeze(): Map<K, V> = Map(this.entries)

    fun keys(): MapKeys<K, V> = MapKeys(this.entries)

    fun values(): MapValues<K, V> = MapValues(this.entries)

    fun serdeFields(): List<SerdeField> = Map(this.entries).serdeFields()
    implement fun serialize(): SerdeValue = Map(this.entries).serialize()
}

type Map<K, V>(val entries: List<Node<K, V>?> = []) : Serializable + Json {

    operator fun get(key: K): V? {
        val capacity = this.entries.size()
        if (capacity == 0) {
            return null
        }

        var hash = key.hashCode()
        var index = hash - (hash / capacity) * capacity
        if (index < 0) index = index + capacity

        var curr = this.entries.items[index]
        while (curr != null) {
            if (curr!!.key == key) {
                return curr!!.value
            }
            curr = curr!!.next
        }
        return null
    }

    fun contains(key: K): Bool {
        val capacity = this.entries.size()
        if (capacity == 0) {
            return false
        }

        var hash = key.hashCode()
        var index = hash - (hash / capacity) * capacity
        if (index < 0) index = index + capacity

        var curr = this.entries.items[index]
        while (curr != null) {
            if (curr!!.key == key) {
                return true
            }
            curr = curr!!.next
        }
        return false
    }

    fun size(): Int {
        var count = 0
        var i = 0
        while (i < this.entries.size()) {
            var curr = this.entries.items[i]
            while (curr != null) {
                count = count + 1
                curr = curr!!.next
            }
            i = i + 1
        }
        return count
    }

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0

    fun mut(): MutableMap<K, V> = MutableMap(this.entries)

    fun keys(): MapKeys<K, V> = MapKeys(this.entries)

    fun values(): MapValues<K, V> = MapValues(this.entries)

    fun serdeFields(): List<SerdeField> {
        val fields = MutableList<SerdeField>()
        var i = 0
        while (i < this.entries.size()) {
            var curr = this.entries.items[i]
            while (curr != null) {
                fields.add(SerdeField(curr!!.key.toString(), SerdeString(curr!!.value?.toString() ?: "null")))
                curr = curr!!.next
            }
            i = i + 1
        }
        return fields.freeze()
    }

    implement fun serialize(): SerdeValue = SerdeObject(this.serdeFields())
}

// Lazy zero-allocation views over a map's hash buckets (Phase 75).
// A view holds the same `entries` list (no copy, live view): `for` over a
// view walks the buckets directly, and `size()` counts by walking.
type MapKeys<K, V>(val entries: List<Node<K, V>?> = []) {

    fun size(): Int {
        var count = 0
        var i = 0
        while (i < this.entries.size()) {
            var curr = this.entries.items[i]
            while (curr != null) {
                count = count + 1
                curr = curr!!.next
            }
            i = i + 1
        }
        return count
    }

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0
}

type MapValues<K, V>(val entries: List<Node<K, V>?> = []) {

    fun size(): Int {
        var count = 0
        var i = 0
        while (i < this.entries.size()) {
            var curr = this.entries.items[i]
            while (curr != null) {
                count = count + 1
                curr = curr!!.next
            }
            i = i + 1
        }
        return count
    }

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0
}

type MutableSet<T>(val map: MutableMap<T, Bool> = MutableMap()) {
    fun add(element: T): Void {
        this.map.put(element, true)
    }

    fun contains(element: T): Bool {
        return this.map.contains(element)
    }

    fun size(): Int = this.map.size()

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0

    fun freeze(): Set<T> = Set(this.map.freeze())
}

type Set<T>(val map: Map<T, Bool> = Map()) {
    fun contains(element: T): Bool {
        return this.map.contains(element)
    }

    fun size(): Int = this.map.size()

    fun isEmpty(): Bool = this.size() == 0

    fun isNotEmpty(): Bool = this.size() > 0

    fun mut(): MutableSet<T> {
        val m = MutableSet<T>()
        var i = 0
        while (i < this.map.entries.size()) {
            var curr = this.map.entries.items[i]
            while (curr != null) {
                m.add(curr!!.key)
                curr = curr!!.next
            }
            i = i + 1
        }
        return m
    }
}

// awaitAll (Kotlin parity): preserves order; created tasks already run concurrently.
@Suspend
fun <T> List<StackTask<T>>.awaitAll(): List<T> {
    val out = MutableList<T>()
    var i = 0
    while (i < this.size()) {
        out.add(this.get(i).await())
        i = i + 1
    }
    return out.freeze()
}

@Suspend
fun <T> MutableList<StackTask<T>>.awaitAll(): List<T> {
    val out = MutableList<T>()
    var i = 0
    while (i < this.size()) {
        out.add(this.get(i).await())
        i = i + 1
    }
    return out.freeze()
}
