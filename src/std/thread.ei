// std.thread
// Native threading and synchronization primitives for Eiwa.
// Built on POSIX pthread without custom C wrappers.

import { Standard } from "std.core"

@Header("<pthread.h>", "<unistd.h>")
lib("posix") NativeThread {
    @Alias("pthread_create")
    fun pthreadCreate(threadOut: Pointer, attr: Pointer, startRoutine: Pointer, arg: Pointer): Int

    @Alias("pthread_join")
    fun pthreadJoin(thread: Pointer, retval: Pointer): Int

    @Alias("pthread_self")
    fun pthreadSelf(): Pointer

    @Alias("pthread_mutex_init")
    fun pthreadMutexInit(mutex: Pointer, attr: Pointer): Int

    @Alias("pthread_mutex_lock")
    fun pthreadMutexLock(mutex: Pointer): Int

    @Alias("pthread_mutex_unlock")
    fun pthreadMutexUnlock(mutex: Pointer): Int

    @Alias("pthread_mutex_destroy")
    fun pthreadMutexDestroy(mutex: Pointer): Int

    @Alias("pthread_cond_init")
    fun pthreadCondInit(cond: Pointer, attr: Pointer): Int

    @Alias("pthread_cond_wait")
    fun pthreadCondWait(cond: Pointer, mutex: Pointer): Int

    @Alias("pthread_cond_signal")
    fun pthreadCondSignal(cond: Pointer): Int

    @Alias("pthread_cond_broadcast")
    fun pthreadCondBroadcast(cond: Pointer): Int

    @Alias("pthread_cond_destroy")
    fun pthreadCondDestroy(cond: Pointer): Int

    @Alias("sysconf")
    fun sysconf(name: Int): Int
}

@Header("<pthread.h>", "<windows.h>")
lib("windows") NativeThread {
    @Alias("pthread_create")
    fun pthreadCreate(threadOut: Pointer, attr: Pointer, startRoutine: Pointer, arg: Pointer): Int

    @Alias("pthread_join")
    fun pthreadJoin(thread: Pointer, retval: Pointer): Int

    @Alias("pthread_self")
    fun pthreadSelf(): Pointer

    @Alias("pthread_mutex_init")
    fun pthreadMutexInit(mutex: Pointer, attr: Pointer): Int

    @Alias("pthread_mutex_lock")
    fun pthreadMutexLock(mutex: Pointer): Int

    @Alias("pthread_mutex_unlock")
    fun pthreadMutexUnlock(mutex: Pointer): Int

    @Alias("pthread_mutex_destroy")
    fun pthreadMutexDestroy(mutex: Pointer): Int

    @Alias("pthread_cond_init")
    fun pthreadCondInit(cond: Pointer, attr: Pointer): Int

    @Alias("pthread_cond_wait")
    fun pthreadCondWait(cond: Pointer, mutex: Pointer): Int

    @Alias("pthread_cond_signal")
    fun pthreadCondSignal(cond: Pointer): Int

    @Alias("pthread_cond_broadcast")
    fun pthreadCondBroadcast(cond: Pointer): Int

    @Alias("pthread_cond_destroy")
    fun pthreadCondDestroy(cond: Pointer): Int

    @Alias("GetActiveProcessorCount")
    fun getActiveProcessorCount(groupNumber: Int): Int
}

object ThreadConstants {
    // POSIX sysconf keys for online processor count
    val SC_NPROCESSORS_ONLN_DARWIN: Int = 58
    val SC_NPROCESSORS_ONLN_LINUX: Int = 84

    // Win32 processor group mask for all active processors
    val ALL_PROCESSOR_GROUPS: Int = 65535

    // Native buffer allocation sizes (bytes)
    val PTHREAD_MUTEX_SIZE: Int = 128
    val PTHREAD_COND_SIZE: Int = 128
    val PTHREAD_HANDLE_SIZE: Int = 16
    val GC_STACK_BASE_SIZE: Int = 16
    val THREAD_TASK_SIZE: Int = 24
}

type RawMutex(val ptr: Pointer) {
    fun lock() {
        NativeThread.pthreadMutexLock(this.ptr)
    }

    fun unlock() {
        NativeThread.pthreadMutexUnlock(this.ptr)
    }

    fun destroy() {
        NativeThread.pthreadMutexDestroy(this.ptr)
    }
} object {
    fun create(): RawMutex {
        // Allocate buffer (sufficient for pthread_mutex_t on all platforms: macOS=64B, Linux=40B, Windows=40B)
        val mPtr = Standard.gcMalloc(ThreadConstants.PTHREAD_MUTEX_SIZE)
        NativeThread.pthreadMutexInit(mPtr, null)
        return RawMutex(mPtr)
    }
}

type Mutex(val raw: RawMutex = RawMutex.create()) {
    fun withLock<T>(action: () -> T): T {
        this.raw.lock()
        val result = action()
        this.raw.unlock()
        return result
    }
}

object GlobalSync {
    val defaultLock: Mutex = Mutex()
}

fun sync<T>(action: () -> T): T {
    return GlobalSync.defaultLock.withLock(action)
}

fun sync<T>(lock: Mutex, action: () -> T): T {
    return lock.withLock(action)
}

type CondVar(val ptr: Pointer) {
    fun wait(mutex: RawMutex) {
        NativeThread.pthreadCondWait(this.ptr, mutex.ptr)
    }

    fun signal() {
        NativeThread.pthreadCondSignal(this.ptr)
    }

    fun broadcast() {
        NativeThread.pthreadCondBroadcast(this.ptr)
    }

    fun destroy() {
        NativeThread.pthreadCondDestroy(this.ptr)
    }
} object {
    fun create(): CondVar {
        // Allocate buffer (sufficient for pthread_cond_t on all platforms: macOS=48B, Linux=48B, Windows=48B)
        val cPtr = Standard.gcMalloc(ThreadConstants.PTHREAD_COND_SIZE)
        NativeThread.pthreadCondInit(cPtr, null)
        return CondVar(cPtr)
    }
}

type Thread(val handle: Pointer) {
    fun join() {
        NativeThread.pthreadJoin(this.handle, null)
    }
}

lib NativeGC {
    @Alias("GC_get_stack_base")
    fun getStackBase(sb: Pointer): Int

    @Alias("GC_register_my_thread")
    fun registerMyThread(sb: Pointer): Int

    @Alias("GC_unregister_my_thread")
    fun unregisterMyThread(): Int
}

// Context wrapper to pass closure to the pthread worker trampoline
type ThreadTask(var action: () -> Void)

fun threadTrampoline(arg: Pointer): Pointer {
    if (arg != null) {
        val sb = Standard.malloc(ThreadConstants.GC_STACK_BASE_SIZE)
        NativeGC.getStackBase(sb)
        NativeGC.registerMyThread(sb)
        Standard.free(sb)

        val task = arg as ThreadTask
        task.action()

        NativeGC.unregisterMyThread()
    }
    return null
}

contract CoreDetector {
    fun getCores(): Int
}

object("posix") CurrentCoreDetector : CoreDetector {
    implement fun getCores(): Int {
        var cores = NativeThread.sysconf(ThreadConstants.SC_NPROCESSORS_ONLN_DARWIN)
        if (cores <= 0) {
            cores = NativeThread.sysconf(ThreadConstants.SC_NPROCESSORS_ONLN_LINUX)
        }
        if (cores <= 0) {
            cores = 1
        }
        return cores
    }
}

object("windows") CurrentCoreDetector : CoreDetector {
    implement fun getCores(): Int {
        val count = NativeThread.getActiveProcessorCount(ThreadConstants.ALL_PROCESSOR_GROUPS)
        if (count > 0) {
            return count
        }
        return 1
    }
}

object CurrentCoreDetector : CoreDetector {
    implement fun getCores(): Int = 1
}

object Threads {
    fun numCores(): Int {
        return CurrentCoreDetector.getCores()
    }

    fun currentThread(): Pointer {
        return NativeThread.pthreadSelf()
    }

    fun spawn(block: () -> Void): Thread {
        val buf = Standard.gcMalloc(ThreadConstants.THREAD_TASK_SIZE)
        val task = buf as ThreadTask
        task.action = block
        val threadBuf = Standard.gcMalloc(ThreadConstants.PTHREAD_HANDLE_SIZE)
        val routine = funPointer { arg: Pointer -> threadTrampoline(arg) }
        NativeThread.pthreadCreate(threadBuf, null, routine, buf)
        val handle = Standard.loadInt64(threadBuf) as Pointer
        return Thread(handle)
    }
}
