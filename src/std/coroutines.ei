// std.coroutines
// Stackless coroutines with multi-core parallelism: task/await via generated state
// machines + multi-threaded Dispatchers (Dispatchers.Default thread pool) and
// cooperative FIFO schedulers, written in pure Eiwa.

import { mod } from "std.math"
import { NativeMemory, Standard } from "std.core"
import { Thread, RawMutex, Mutex, CondVar, Threads, NativeThread, NativeGC } from "std.thread"
import { AtomicBool } from "std.atomic"
import { MutableList } from "std.collections"

// ============================================================================
// System primitives via FFI (no neco). `nanosleep` for time, `poll` for I/O
// readiness, `sched_yield` for cooperative yielding.
// ============================================================================

@Header("<time.h>")
lib NativeTime {
    @Alias("nanosleep")
    fun nanosleep(req: Pointer, rem: Pointer): Int
}

@Header("<sched.h>")
lib NativeSched {
    @Alias("sched_yield")
    fun schedYield(): Int
}

@Header("<poll.h>")
lib("posix") PosixPoll {
    @Alias("poll")
    fun poll(fds: Pointer, nfds: Int, timeout: Int): Int
}

@Header("<winsock2.h>")
lib("windows") Win32Poll {
    @Alias("WSAPoll")
    fun poll(fds: Pointer, nfds: Int, timeout: Int): Int
}

contract PollLayoutContract {
    fun entrySize(): Int
    fun eventsOffset(): Int
    fun reventsOffset(): Int
    fun fdBytes(): Int
    fun pollInLow(): Int
    fun pollInHigh(): Int
    fun pollOutLow(): Int
    fun pollOutHigh(): Int
    fun poll(fds: Pointer, nfds: Int, timeout: Int): Int
}

object("posix") PollLayout : PollLayoutContract {
    implement fun entrySize(): Int = 8
    implement fun eventsOffset(): Int = 4
    implement fun reventsOffset(): Int = 6
    implement fun fdBytes(): Int = 4
    implement fun pollInLow(): Int = 1
    implement fun pollInHigh(): Int = 0
    implement fun pollOutLow(): Int = 4
    implement fun pollOutHigh(): Int = 0
    implement fun poll(fds: Pointer, nfds: Int, timeout: Int): Int {
        return PosixPoll.poll(fds, nfds, timeout)
    }
}

object("windows") PollLayout : PollLayoutContract {
    implement fun entrySize(): Int = 16
    implement fun eventsOffset(): Int = 8
    implement fun reventsOffset(): Int = 10
    implement fun fdBytes(): Int = 8
    implement fun pollInLow(): Int = 0
    implement fun pollInHigh(): Int = 3
    implement fun pollOutLow(): Int = 16
    implement fun pollOutHigh(): Int = 0
    implement fun poll(fds: Pointer, nfds: Int, timeout: Int): Int {
        return Win32Poll.poll(fds, nfds, timeout)
    }
}

// ============================================================================
// Continuations & Scheduler (Thread-Safe, Instantiable)
// ============================================================================

contract Continuation {
    fun resume()
    fun isDone(): Bool
}

// Intrusive FIFO queue node
type ContNode(val cont: Continuation, var next: ContNode?)

// Timer node for cooperative `sleep`: a continuation to re-schedule once the
// virtual clock reaches `deadline`. Intrusive, kept in deadline order.
type TimerNode(var deadline: Int, var cont: Continuation, var next: TimerNode?)

// I/O Waiter node for cooperative non-blocking I/O
// events: 1 = POLLIN (readable), 4 = POLLOUT (writable)
type IoWaiterNode(val fd: Int, val events: Int, val cont: Continuation, var next: IoWaiterNode?)

type TaskScheduler(
    val mutex: RawMutex,
    val cond: CondVar
) {
    var head: ContNode? = null
    var tail: ContNode? = null
    var timerHead: TimerNode? = null
    var ioHead: IoWaiterNode? = null
    var isPolling: Bool = false
    var now: Int = 0
    var isShutdown: Bool = false

    fun schedule(cont: Continuation) {
        val node = ContNode(cont, null)
        this.mutex.lock()
        if (this.tail == null) {
            this.head = node
            this.tail = node
        } else {
            this.tail!!.next = node
            this.tail = node
        }
        this.cond.signal()
        this.mutex.unlock()
    }

    // Registers `cont` to be re-scheduled after `ms` virtual milliseconds.
    fun sleep(cont: Continuation, ms: Int): Bool {
        this.mutex.lock()
        val deadline = this.now + ms
        var node = TimerNode(deadline, cont, null)
        if (this.timerHead == null || this.timerHead!!.deadline > deadline) {
            node.next = this.timerHead
            this.timerHead = node
        } else {
            var cur = this.timerHead!!
            var placed = false
            while (cur.next != null && !placed) {
                if (cur.next!!.deadline <= deadline) {
                    cur = cur.next!!
                } else {
                    placed = true
                }
            }
            node.next = cur.next
            cur.next = node
        }
        this.cond.signal()
        this.mutex.unlock()
        return true
    }

    // Cooperative yield: re-queue `cont` at the end of the ready queue.
    fun yield(cont: Continuation): Bool {
        this.schedule(cont)
        return true
    }

    // Registers `cont` to be re-scheduled once `fd` is ready for `events`.
    fun waitIo(cont: Continuation, fd: Int, events: Int): Bool {
        this.mutex.lock()
        val node = IoWaiterNode(fd, events, cont, this.ioHead)
        this.ioHead = node
        this.cond.signal()
        this.mutex.unlock()
        return true
    }

    fun waitReadable(cont: Continuation, fd: Int): Bool {
        return this.waitIo(cont, fd, 1)
    }

    fun waitWritable(cont: Continuation, fd: Int): Bool {
        return this.waitIo(cont, fd, 4)
    }

    fun pollIoLocked(timeoutMs: Int): Bool {
        if (this.ioHead == null || this.isPolling) {
            return false
        }
        this.isPolling = true
        var count = 0
        var cur = this.ioHead
        while (cur != null) {
            count = count + 1
            cur = cur!!.next
        }
        if (count == 0) {
            this.isPolling = false
            return false
        }
        val entrySz = PollLayout.entrySize()
        val evOff = PollLayout.eventsOffset()
        val revOff = PollLayout.reventsOffset()
        val fdB = PollLayout.fdBytes()

        val pfd = Standard.gcMalloc(count * entrySz)
        cur = this.ioHead
        var idx = 0
        while (cur != null) {
            val w = cur!!
            val base = idx * entrySz
            var v = w.fd
            var b = 0
            while (b < fdB) {
                NativeMemory.writeByte(pfd, base + b, mod(v, 256))
                v = v / 256
                b = b + 1
            }
            if (w.events == 1) {
                NativeMemory.writeByte(pfd, base + evOff, PollLayout.pollInLow())
                NativeMemory.writeByte(pfd, base + evOff + 1, PollLayout.pollInHigh())
            } else {
                NativeMemory.writeByte(pfd, base + evOff, PollLayout.pollOutLow())
                NativeMemory.writeByte(pfd, base + evOff + 1, PollLayout.pollOutHigh())
            }
            NativeMemory.writeByte(pfd, base + revOff, 0)
            NativeMemory.writeByte(pfd, base + revOff + 1, 0)
            idx = idx + 1
            cur = w.next
        }
        var actualTimeout = timeoutMs
        if (actualTimeout < 0) {
            actualTimeout = 0
        }
        this.mutex.unlock()
        val n = PollLayout.poll(pfd, count, actualTimeout)
        this.mutex.lock()
        this.isPolling = false

        if (n <= 0 || this.ioHead == null) {
            return false
        }
        var fired = false
        var prev: IoWaiterNode? = null
        cur = this.ioHead
        idx = 0
        while (cur != null && idx < count) {
            val w = cur!!
            val base = idx * entrySz
            val reventsLow = NativeMemory.readByte(pfd, base + revOff)
            val reventsHigh = NativeMemory.readByte(pfd, base + revOff + 1)
            val revents = reventsLow + reventsHigh * 256
            if (revents != 0) {
                if (prev == null) {
                    this.ioHead = w.next
                } else {
                    prev!!.next = w.next
                }
                val node = ContNode(w.cont, null)
                if (this.tail == null) {
                    this.head = node
                    this.tail = node
                } else {
                    this.tail!!.next = node
                    this.tail = node
                }
                fired = true
            } else {
                prev = w
            }
            idx = idx + 1
            cur = w.next
        }
        if (fired) {
            this.cond.broadcast()
        }
        return fired
    }

    // Blocking pop for worker threads in a thread pool
    fun popBlocking(): ContNode? {
        this.mutex.lock()
        var waiting = this.head == null && !this.isShutdown
        while (waiting) {
            if (this.timerHead != null) {
                val first = this.timerHead!!
                val delta = first.deadline - this.now
                if (delta <= 0) {
                    this.fireTimersLocked()
                }
            }
            if (this.ioHead != null && !this.isPolling) {
                this.pollIoLocked(0)
            }
            if (this.head != null || this.isShutdown) {
                waiting = false
            } else {
                if (this.ioHead != null) {
                    this.mutex.unlock()
                    this.waitMs(2)
                    this.mutex.lock()
                    this.now = this.now + 2
                    this.fireTimersLocked()
                } else if (this.timerHead != null) {
                    val first = this.timerHead!!
                    val delta = first.deadline - this.now
                    if (delta > 0) {
                        this.mutex.unlock()
                        this.waitMs(delta)
                        this.mutex.lock()
                        this.now = first.deadline
                    }
                    this.fireTimersLocked()
                } else {
                    this.cond.wait(this.mutex)
                }
                waiting = this.head == null && !this.isShutdown
            }
        }
        if (this.head != null) {
            val node = this.head!!
            this.head = node.next
            if (this.head == null) {
                this.tail = null
            }
            this.mutex.unlock()
            return node
        }
        this.mutex.unlock()
        return null
    }

    fun fireTimersLocked(): Bool {
        if (this.timerHead == null) {
            return false
        }
        var fired = false
        var expired = true
        while (this.timerHead != null && expired) {
            val t = this.timerHead!!
            if (t.deadline > this.now) {
                expired = false
            } else {
                val node = ContNode(t.cont, null)
                if (this.tail == null) {
                    this.head = node
                    this.tail = node
                } else {
                    this.tail!!.next = node
                    this.tail = node
                }
                this.timerHead = t.next
                fired = true
            }
        }
        if (fired) {
            this.cond.broadcast()
        }
        return fired
    }

    fun fireTimers(): Bool {
        this.mutex.lock()
        val fired = this.fireTimersLocked()
        this.mutex.unlock()
        return fired
    }

    fun waitMs(ms: Int) {
        val ts = Standard.malloc(16)
        var sec = ms / 1000
        var nsec = mod(ms, 1000) * 1000000
        var i = 0
        while (i < 8) {
            NativeMemory.writeByte(ts, i, mod(sec, 256))
            NativeMemory.writeByte(ts, 8 + i, mod(nsec, 256))
            sec = sec / 256
            nsec = nsec / 256
            i = i + 1
        }
        NativeTime.nanosleep(ts, null)
        Standard.free(ts)
    }

    fun run() {
        while (this.runStep()) {}
    }

    fun runStep(): Bool {
        this.mutex.lock()
        if (this.head == null) {
            if (this.timerHead != null) {
                val first = this.timerHead!!
                val delta = first.deadline - this.now
                if (delta > 0 && this.ioHead == null) {
                    this.waitMs(delta)
                    this.now = first.deadline
                }
                this.fireTimersLocked()
            }
            if (this.ioHead != null) {
                this.pollIoLocked(0)
            }
        }
        if (this.head == null) {
            this.mutex.unlock()
            return false
        }
        val node = this.head!!
        this.head = node.next
        if (this.head == null) {
            this.tail = null
        }
        this.mutex.unlock()
        node.cont.resume()
        return true
    }

    fun shutdown() {
        this.mutex.lock()
        this.isShutdown = true
        this.cond.broadcast()
        this.mutex.unlock()
    }
} object {
    fun create(): TaskScheduler {
        val m = RawMutex.create()
        val c = CondVar.create()
        return TaskScheduler(m, c)
    }
}

// ============================================================================
// Dispatchers & Multi-Threaded Workers
// ============================================================================

type WorkerTask(var dispatcher: Dispatcher)

fun workerThreadTrampoline(arg: Pointer): Pointer {
    if (arg != null) {
        val sb = Standard.malloc(16)
        NativeGC.getStackBase(sb)
        NativeGC.registerMyThread(sb)
        Standard.free(sb)

        val task = arg as WorkerTask
        val disp = task.dispatcher
        while (!disp.isShutdown) {
            val node = disp.scheduler.popBlocking()
            if (node != null) {
                node!!.cont.resume()
            }
        }

        NativeGC.unregisterMyThread()
    }
    return null
}

type Dispatcher(
    val name: String,
    val nThreads: Int,
    val scheduler: TaskScheduler,
    var isShutdown: Bool,
    var isStarted: Bool = false
) {
    val threads: MutableList<Thread?> = MutableList<Thread?>()

    fun ensureStarted() {
        if (!this.isStarted && !this.isShutdown && this.nThreads > 0) {
            this.isStarted = true
            var i = 0
            while (i < this.nThreads) {
                val buf = Standard.gcMalloc(24)
                val task = buf as WorkerTask
                task.dispatcher = this
                val threadBuf = Standard.gcMalloc(16)
                val routine = funPointer { arg: Pointer -> workerThreadTrampoline(arg) }
                NativeThread.pthreadCreate(threadBuf, null, routine, buf)
                val handle = Standard.loadInt64(threadBuf) as Pointer
                this.threads.add(Thread(handle))
                i = i + 1
            }
        }
    }

    fun shutdown() {
        this.isShutdown = true
        this.scheduler.shutdown()
        var i = 0
        while (i < this.threads.size()) {
            val t = this.threads.get(i)
            if (t != null) {
                t!!.join()
            }
            i = i + 1
        }
    }
}

object Dispatchers {
    val Single: Dispatcher = Dispatchers.create("single", 1)
    val Default: Dispatcher = Dispatchers.createDefault()

    fun createDefault(): Dispatcher {
        return Dispatchers.create("default", Threads.numCores())
    }

    fun create(name: String, threads: Int): Dispatcher {
        val sched = TaskScheduler.create()
        return Dispatcher(name, threads, sched, false, false)
    }
}

// Global facade for compiler-generated code and backward compatibility
object Scheduler {
    fun schedule(cont: Continuation) {
        Dispatchers.Default.ensureStarted()
        Dispatchers.Default.scheduler.schedule(cont)
    }

    fun sleep(cont: Continuation, ms: Int): Bool {
        Dispatchers.Default.ensureStarted()
        return Dispatchers.Default.scheduler.sleep(cont, ms)
    }

    fun yield(cont: Continuation): Bool {
        Dispatchers.Default.ensureStarted()
        return Dispatchers.Default.scheduler.yield(cont)
    }

    fun waitReadable(cont: Continuation, fd: Int): Bool {
        Dispatchers.Default.ensureStarted()
        return Dispatchers.Default.scheduler.waitReadable(cont, fd)
    }

    fun waitWritable(cont: Continuation, fd: Int): Bool {
        Dispatchers.Default.ensureStarted()
        return Dispatchers.Default.scheduler.waitWritable(cont, fd)
    }

    fun run() {
        Dispatchers.Default.scheduler.run()
    }

    fun runStep(): Bool {
        return Dispatchers.Default.scheduler.runStep()
    }
}

// ============================================================================
// Coroutine / EventLoop facade
// ============================================================================

object Coroutine {
    @Suspend
    fun yield(): Int {
        return NativeSched.schedYield()
    }

    @Suspend
    fun sleep(nanosecs: Int): Int {
        val ts = Standard.malloc(16)
        var sec = nanosecs / 1000000000
        var nsec = mod(nanosecs, 1000000000)
        var i = 0
        while (i < 8) {
            NativeMemory.writeByte(ts, i, mod(sec, 256))
            NativeMemory.writeByte(ts, 8 + i, mod(nsec, 256))
            sec = sec / 256
            nsec = nsec / 256
            i = i + 1
        }
        val res = NativeTime.nanosleep(ts, null)
        Standard.free(ts)
        return res
    }

    @Suspend
    fun sleepMs(ms: Int): Int {
        return Coroutine.sleep(ms * 1000000)
    }
}

object EventLoop {
    @Suspend
    fun waitReadable(fd: Int): Int {
        val entrySz = PollLayout.entrySize()
        val pfd = Standard.gcMalloc(entrySz)
        var z = 0
        while (z < entrySz) {
            NativeMemory.writeByte(pfd, z, 0)
            z = z + 1
        }
        var v = fd
        var i = 0
        val fdB = PollLayout.fdBytes()
        while (i < fdB) {
            NativeMemory.writeByte(pfd, i, mod(v, 256))
            v = v / 256
            i = i + 1
        }
        val evOff = PollLayout.eventsOffset()
        NativeMemory.writeByte(pfd, evOff, PollLayout.pollInLow())
        NativeMemory.writeByte(pfd, evOff + 1, PollLayout.pollInHigh())
        return PollLayout.poll(pfd, 1, -1)
    }

    @Suspend
    fun waitWritable(fd: Int): Int {
        val entrySz = PollLayout.entrySize()
        val pfd = Standard.gcMalloc(entrySz)
        var z = 0
        while (z < entrySz) {
            NativeMemory.writeByte(pfd, z, 0)
            z = z + 1
        }
        var v = fd
        var i = 0
        val fdB = PollLayout.fdBytes()
        while (i < fdB) {
            NativeMemory.writeByte(pfd, i, mod(v, 256))
            v = v / 256
            i = i + 1
        }
        val evOff = PollLayout.eventsOffset()
        NativeMemory.writeByte(pfd, evOff, PollLayout.pollOutLow())
        NativeMemory.writeByte(pfd, evOff + 1, PollLayout.pollOutHigh())
        return PollLayout.poll(pfd, 1, -1)
    }
}

// ============================================================================
// StackTask & task API
// ============================================================================

type WaiterNode(val cont: Continuation, var next: WaiterNode?)

type StackTask<T>(
    var done: Bool,
    var result: T?,
    var waiters: WaiterNode?,
    val mutex: RawMutex = RawMutex.create()
): Awaitable<T> {

    @Suspend
    implement fun await(): T {
        while (!this.done) {
            if (!Dispatchers.Default.scheduler.runStep()) {
                Coroutine.sleepMs(1)
            }
        }
        return this.result!!
    }

    fun awaitCoop(cont: Continuation): Bool {
        this.mutex.lock()
        if (this.done) {
            this.mutex.unlock()
            return true
        }
        val node = WaiterNode(cont, this.waiters)
        this.waiters = node
        this.mutex.unlock()
        return false
    }

    implement fun isDone(): Bool = this.done
}

@Coroutine
fun task<T>(block: () -> T) = StackTask<T>(false, null, null, RawMutex.create())

@Coroutine
fun task<T>(dispatcher: Dispatcher, block: () -> T) = StackTask<T>(false, null, null, RawMutex.create())
