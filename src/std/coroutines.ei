@Header("neco/neco_wrapper.h")
@Define("NECO_NOWORKERS")
@Define("NECO_NOSIGNALS")
@Define("NECO_USEHEAPSTACK")
@Define("NECO_STACKSIZE=262144")
@Source("src/runtime/third_party/neco/neco.c")
@Source("src/runtime/third_party/neco/neco_wrapper.c")
@Include("src/runtime/third_party/neco")
lib Neco {
    @Alias("eiwa_neco_start_closure")
    fun start(closure: () -> Void): Int

    @Alias("eiwa_neco_join")
    fun join(id: Int): Int

    @Alias("eiwa_neco_yield")
    fun yield(): Int

    @Alias("eiwa_neco_sleep")
    fun sleep(nanosecs: Int): Int

    @Alias("eiwa_neco_wait_readable")
    fun waitReadable(fd: Int): Int

    @Alias("eiwa_neco_wait_writable")
    fun waitWritable(fd: Int): Int
}

object Coroutine {
    fun start(closure: () -> Void): Int {
        return Neco.start(closure)
    }

    fun join(id: Int): Int {
        return Neco.join(id)
    }

    fun yield(): Int {
        return Neco.yield()
    }

    fun sleep(nanosecs: Int): Int {
        return Neco.sleep(nanosecs)
    }

    fun sleepMs(ms: Int): Int {
        return Neco.sleep(ms * 1000000)
    }
}

object EventLoop {
    fun waitReadable(fd: Int): Int {
        return Neco.waitReadable(fd)
    }

    fun waitWritable(fd: Int): Int {
        return Neco.waitWritable(fd)
    }
}

contract Taskable<T> {
    fun exec(): Int
    fun join(id: Int)
}

skill TaskableCoroutine<T> : Taskable<T>, Runnable {

    implement fun exec(): Int {
        return Coroutine.start { 
            run() 
        }
    }

    implement fun join(id: Int) {
        Coroutine.join(id)
    }
}

type Task<T>(
    var id: Int?,
    var done: Bool,
    var result: T?,
    val block: () -> T
): Awaitable<T>, Runnable, Taskable<T> + TaskableCoroutine {

    implement fun await(): T {
        if (!done) {
            join(id)
            done = true
        }
        return result!!
    }

    implement fun run() {
        result = block()
        done = true
    }

    implement fun start(): Awaitable<T> {
        id = this.exec()
        return this
    }

    implement fun isDone() = done

}

fun task<T>(block: () -> T) = Task<T>(null, false, null, block).start()
