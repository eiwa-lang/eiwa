// std.coroutines
// Stackless coroutines: task/await via generated state machines + a
// cooperative FIFO scheduler, written in pure Eiwa. No neco (stackful).

import { mod } from "std.math"
import { NativeMemory } from "std.core"

// ============================================================================
// System primitives via FFI (no neco). `nanosleep` for time, `poll` for I/O
// readiness, `sched_yield` for cooperative yielding.
// ============================================================================

@Header("<time.h>")
lib NativeTime {
    @Alias("nanosleep")
    fun nanosleep(req: Pointer, rem: Pointer): Int
}

@Header("<sched.h>")
lib NativeSched {
    @Alias("sched_yield")
    fun schedYield(): Int
}

@Header("<poll.h>")
lib NativePoll {
    @Alias("poll")
    fun poll(fds: Pointer, nfds: Int, timeout: Int): Int
}

// ============================================================================
// Cooperative scheduler (Eiwa puro, sem neco).
//
// O compilador transforma cada função suspend em uma state machine cujo estado
// vive num objeto que implementa `Continuation` (label + locais salvos). Este
// scheduler é o runtime cooperativo single-threaded: `schedule()` enfileira uma
// continuation pronta e `run()` executa até a fila esvaziar. Uma continuation
// que suspende NÃO é re-enfileirada por `run()` — ela se re-agenda sozinha
// (timer/I/O) ou é agendada pela task que aguardava quando esta completa.
// ============================================================================

contract Continuation {
    fun resume()
    fun isDone(): Bool
}

// Intrusive FIFO queue node (a contract field inside a self-referential struct
// works; a generic `MutableList<Continuation>` does NOT — the LLVM backend
// cannot store fat pointers in generic collections yet).
type ContNode(val cont: Continuation, var next: ContNode?)

object Scheduler {
    var head: ContNode? = null
    var tail: ContNode? = null

    fun schedule(cont: Continuation) {
        val node = ContNode(cont, null)
        if (Scheduler.tail == null) {
            Scheduler.head = node
            Scheduler.tail = node
        } else {
            Scheduler.tail!!.next = node
            Scheduler.tail = node
        }
    }

    fun run() {
        while (Scheduler.head != null) {
            Scheduler.runStep()
        }
    }

    // Runs a single ready continuation. Returns false when the queue is empty.
    // `await()` loops on this until the awaited task completes, so independent
    // tasks queued behind it are NOT drained — they stay for their own await.
    fun runStep(): Bool {
        if (Scheduler.head == null) {
            return false
        }
        val node = Scheduler.head!!
        Scheduler.head = node.next
        if (Scheduler.head == null) {
            Scheduler.tail = null
        }
        node.cont.resume()
        return true
    }
}

// ============================================================================
// Coroutine / EventLoop facade — the suspend surfaces users call. In the
// current blocking-poll model a `sleep`/`yield` simply blocks the thread
// (nanosleep / sched_yield) inside a task's resume; the scheduler is only
// used by task/await. A future phase (switch(label)) will make these true
// non-blocking suspension points.
// ============================================================================

object Coroutine {
    @Suspend
    fun yield(): Int {
        return NativeSched.schedYield()
    }

    @Suspend
    fun sleep(nanosecs: Int): Int {
        val ts = Standard.gcMalloc(16)
        var sec = nanosecs / 1000000000
        var nsec = mod(nanosecs, 1000000000)
        // timespec: { time_t tv_sec (8B), long tv_nsec (8B) } — write little-endian.
        var i = 0
        while (i < 8) {
            NativeMemory.writeByte(ts, i, mod(sec, 256))
            NativeMemory.writeByte(ts, 8 + i, mod(nsec, 256))
            sec = sec / 256
            nsec = nsec / 256
            i = i + 1
        }
        return NativeTime.nanosleep(ts, null)
    }

    @Suspend
    fun sleepMs(ms: Int): Int {
        return Coroutine.sleep(ms * 1000000)
    }
}

object EventLoop {
    // pollfd: { int fd; short events; short revents } (8 bytes, little-endian).
    // POLLIN=0x001, POLLOUT=0x004. Timeout -1 = wait indefinitely.
    @Suspend
    fun waitReadable(fd: Int): Int {
        val pfd = Standard.gcMalloc(8)
        var v = fd
        var i = 0
        while (i < 4) {
            NativeMemory.writeByte(pfd, i, mod(v, 256))
            v = v / 256
            i = i + 1
        }
        NativeMemory.writeByte(pfd, 4, 1) // POLLIN low byte
        NativeMemory.writeByte(pfd, 5, 0)
        return NativePoll.poll(pfd, 1, -1)
    }

    @Suspend
    fun waitWritable(fd: Int): Int {
        val pfd = Standard.gcMalloc(8)
        var v = fd
        var i = 0
        while (i < 4) {
            NativeMemory.writeByte(pfd, i, mod(v, 256))
            v = v / 256
            i = i + 1
        }
        NativeMemory.writeByte(pfd, 4, 4) // POLLOUT low byte
        NativeMemory.writeByte(pfd, 5, 0)
        return NativePoll.poll(pfd, 1, -1)
    }
}

// ============================================================================
// Stackless task/await cell (Fase C — generated code).
//
// The compiler transform rewrites:
//   `val t = task { block }`  ->  allocate a StackTask<T>, generate a
//                                Continuation that runs `block`, schedule it.
//   `t.await()`               ->  poll the task (run the scheduler until done),
//                                then return `t.result`.
//
// Waiters are an intrusive linked list of structs (NOT a nullable contract
// field, which the LLVM backend mishandles — silent no-op dispatch).
// ============================================================================

type WaiterNode(val cont: Continuation, var next: WaiterNode?)

type StackTask<T>(
    var done: Bool,
    var result: T?,
    var waiters: WaiterNode?
): Awaitable<T> {

    @Suspend
    implement fun await(): T {
        if (!done) {
            Scheduler.run()
        }
        return result!!
    }

    implement fun start(): Awaitable<T> {
        return this
    }

    implement fun isDone(): Bool = done
}

@Coroutine
fun task<T>(block: () -> T) = StackTask<T>(false, null, null)
