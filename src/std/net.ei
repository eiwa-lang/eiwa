import { EventLoop } from "std.coroutines"

@Header("src/runtime/third_party/eiwa_net/net_helpers.h")
@Source("src/runtime/third_party/eiwa_net/net_helpers.c")
lib NativeNet {
    @Alias("eiwa_tcp_bind")
    fun tcpBind(port: Int): Int

    @Alias("eiwa_tcp_connect")
    fun tcpConnect(host: Pointer, port: Int): Int

    @Alias("eiwa_tcp_accept")
    fun tcpAccept(fd: Int): Int

    @Alias("eiwa_socket_read")
    fun socketRead(fd: Int, buf: Pointer, maxLen: Int): Int

    @Alias("eiwa_socket_write")
    fun socketWrite(fd: Int, data: Pointer, len: Int): Int
    
    @Alias("eiwa_tcp_set_nonblocking")
    fun setNonblocking(fd: Int): Int
    
    @Alias("eiwa_socket_close")
    fun socketClose(fd: Int): Void
}

type Socket(val fd: Int = -1) {
    @Suspend
    fun read(maxLen: Int): String {
        val buf = Standard.gcMalloc(maxLen + 1)
        EventLoop.waitReadable(this.fd)
        val n = NativeNet.socketRead(this.fd, buf, maxLen)
        if (n <= 0) {
            return ""
        }
        buf?.writeByte(n, 0)
        return String(buf, n)
    }
    
    @Suspend
    fun write(data: String): Int {
        EventLoop.waitWritable(this.fd)
        return NativeNet.socketWrite(this.fd, data.ptr, data.length)
    }
    
    fun close(): Void {
        NativeNet.socketClose(this.fd)
    }
}

object SocketClient {
    fun connect(host: String, port: Int): Socket? {
        val fd = NativeNet.tcpConnect(host.ptr, port)
        if (fd < 0) {
            return null
        }
        NativeNet.setNonblocking(fd)
        return Socket(fd)
    }
}

type TCPServer(var fd: Int = -1) {
    fun bind(port: Int): Bool {
        this.fd = NativeNet.tcpBind(port)
        if (this.fd >= 0) {
            NativeNet.setNonblocking(this.fd)
        }
        return this.fd >= 0
    }
    
    @Suspend
    fun accept(): Socket? {
        if (this.fd < 0) {
            return null
        }
        EventLoop.waitReadable(this.fd)
        val clientFd = NativeNet.tcpAccept(this.fd)
        if (clientFd < 0) {
            return null
        }
        NativeNet.setNonblocking(clientFd)
        return Socket(clientFd)
    }
    
    fun close(): Void {
        if (this.fd >= 0) {
            NativeNet.socketClose(this.fd)
            this.fd = -1
        }
    }
}

