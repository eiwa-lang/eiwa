import { EventLoop } from "std.coroutines"

@Header("src/runtime/third_party/eiwa_net/net_helpers.h")
@Source("src/runtime/third_party/eiwa_net/net_helpers.c")
lib NativeNet {
    @Alias("eiwa_tcp_bind")
    fun tcpBind(port: Int): Int

    @Alias("eiwa_tcp_connect")
    fun tcpConnect(host: Pointer, port: Int): Int

    @Alias("eiwa_tcp_accept")
    fun tcpAccept(fd: Int): Int

    @Alias("eiwa_socket_read")
    fun socketRead(fd: Int, buf: Pointer, maxLen: Int): Int

    @Alias("eiwa_socket_write")
    fun socketWrite(fd: Int, data: Pointer, len: Int): Int

    @Alias("eiwa_tcp_set_nonblocking")
    fun setNonblocking(fd: Int): Int

    @Alias("eiwa_socket_close")
    fun socketClose(fd: Int): Void
}

// Same BSD-socket surface for lwIP: the C file is portable (socket, bind,
// listen, accept, read, write, fcntl, getaddrinfo, poll all exist in lwIP),
// so the esp32 motor reuses it instead of forking the C code.
@Header("src/runtime/third_party/eiwa_net/net_helpers.h")
@Source("src/runtime/third_party/eiwa_net/net_helpers.c")
lib("esp32") EspNet {
    @Alias("eiwa_tcp_bind")
    fun tcpBind(port: Int): Int

    @Alias("eiwa_tcp_connect")
    fun tcpConnect(host: Pointer, port: Int): Int

    @Alias("eiwa_tcp_accept")
    fun tcpAccept(fd: Int): Int

    @Alias("eiwa_socket_read")
    fun socketRead(fd: Int, buf: Pointer, maxLen: Int): Int

    @Alias("eiwa_socket_write")
    fun socketWrite(fd: Int, data: Pointer, len: Int): Int

    @Alias("eiwa_tcp_set_nonblocking")
    fun setNonblocking(fd: Int): Int

    @Alias("eiwa_socket_close")
    fun socketClose(fd: Int): Void
}

contract NetOps {
    fun tcpBind(port: Int): Int
    fun tcpConnect(host: Pointer, port: Int): Int
    fun tcpAccept(fd: Int): Int
    fun socketRead(fd: Int, buf: Pointer, maxLen: Int): Int
    fun socketWrite(fd: Int, data: Pointer, len: Int): Int
    fun setNonblocking(fd: Int): Int
    fun socketClose(fd: Int): Void
}

object Net : NetOps {
    implement fun tcpBind(port: Int): Int = NativeNet.tcpBind(port)
    implement fun tcpConnect(host: Pointer, port: Int): Int = NativeNet.tcpConnect(host, port)
    implement fun tcpAccept(fd: Int): Int = NativeNet.tcpAccept(fd)
    implement fun socketRead(fd: Int, buf: Pointer, maxLen: Int): Int = NativeNet.socketRead(fd, buf, maxLen)
    implement fun socketWrite(fd: Int, data: Pointer, len: Int): Int = NativeNet.socketWrite(fd, data, len)
    implement fun setNonblocking(fd: Int): Int = NativeNet.setNonblocking(fd)
    implement fun socketClose(fd: Int): Void {
        NativeNet.socketClose(fd)
    }
}

object("esp32") Net : NetOps {
    implement fun tcpBind(port: Int): Int = EspNet.tcpBind(port)
    implement fun tcpConnect(host: Pointer, port: Int): Int = EspNet.tcpConnect(host, port)
    implement fun tcpAccept(fd: Int): Int = EspNet.tcpAccept(fd)
    implement fun socketRead(fd: Int, buf: Pointer, maxLen: Int): Int = EspNet.socketRead(fd, buf, maxLen)
    implement fun socketWrite(fd: Int, data: Pointer, len: Int): Int = EspNet.socketWrite(fd, data, len)
    implement fun setNonblocking(fd: Int): Int = EspNet.setNonblocking(fd)
    implement fun socketClose(fd: Int): Void {
        EspNet.socketClose(fd)
    }
}

type Socket(val fd: Int = -1) {
    @Suspend
    fun read(maxLen: Int): String {
        val buf = Standard.gcMalloc(maxLen + 1)
        EventLoop.waitReadable(this.fd)
        val n = Net.socketRead(this.fd, buf, maxLen)
        if (n <= 0) {
            return ""
        }
        buf?.writeByte(n, 0)
        return String(buf, n)
    }
    
    @Suspend
    fun write(data: String): Int {
        EventLoop.waitWritable(this.fd)
        return Net.socketWrite(this.fd, data.ptr, data.length)
    }
    
    fun close(): Void {
        Net.socketClose(this.fd)
    }
}

object SocketClient {
    fun connect(host: String, port: Int): Socket? {
        val fd = Net.tcpConnect(host.ptr, port)
        if (fd < 0) {
            return null
        }
        Net.setNonblocking(fd)
        return Socket(fd)
    }
}

type BindException(val port: Int) : Throwable {
    implement fun message(): String {
        return "cannot bind port " + this.port.toString() + ": address already in use or not available"
    }
}

type TCPServer(var fd: Int = -1) {
    fun tryBind(port: Int): Bool {
        this.fd = Net.tcpBind(port)
        if (this.fd >= 0) {
            Net.setNonblocking(this.fd)
        }
        return this.fd >= 0
    }

    fun bind(port: Int): Void {
        if (!this.tryBind(port)) {
            throw BindException(port)
        }
    }
    
    @Suspend
    fun accept(): Socket? {
        if (this.fd < 0) {
            return null
        }
        val pr = EventLoop.waitReadable(this.fd, 250)
        if (pr <= 0) {
            return null
        }
        val clientFd = Net.tcpAccept(this.fd)
        if (clientFd < 0) {
            return null
        }
        Net.setNonblocking(clientFd)
        return Socket(clientFd)
    }
    
    fun close(): Void {
        if (this.fd >= 0) {
            Net.socketClose(this.fd)
            this.fd = -1
        }
    }
}

