import { List, MutableList } from "std.collections"
import { Exception } from "std.exceptions"
import { mod } from "std.math"

fun formatThousands(majorStr: String, thousandSeparator: String): String {
    if (thousandSeparator.length == 0 || majorStr.length <= 3) {
        return majorStr
    }

    val len = majorStr.length
    var result = ""
    var i = 0

    while (i < len) {
        if (i > 0 && mod(len - i, 3) == 0) {
            result = result + thousandSeparator
        }
        result = result + majorStr.substring(i, i + 1)
        i = i + 1
    }

    return result
}

type Currency(
    val code: String,
    val name: String,
    val symbol: String,
    val decimals: Int,
    val decimalSeparator: String = ".",
    val thousandSeparator: String = ""
) {
    operator fun equals(other: Currency): Bool {
        return this.code == other.code
    }

    fun formatAmount(cents: Int): String {
        val isNegative = cents < 0
        var positiveCents = cents
        if (isNegative) {
            positiveCents = 0 - cents
        }

        var divisor = 1
        var i = 0
        while (i < this.decimals) {
            divisor = divisor * 10
            i = i + 1
        }

        val major = positiveCents / divisor
        val majorStr = formatThousands(major.toString(), this.thousandSeparator)

        if (this.decimals == 0) {
            if (isNegative) {
                return "-" + this.symbol + " " + majorStr
            }
            return this.symbol + " " + majorStr
        }

        val minor = mod(positiveCents, divisor)

        var minorStr = minor.toString()
        while (minorStr.length < this.decimals) {
            minorStr = "0" + minorStr
        }

        val formatted = this.symbol + " " + majorStr + this.decimalSeparator + minorStr
        if (isNegative) {
            return "-" + formatted
        }
        return formatted
    }
}

object Currencies {
    // South America
    val BRL = Currency("BRL", "Brazilian Real", "R$", 2, ",", ".")
    val ARS = Currency("ARS", "Argentine Peso", "ARS$", 2, ",", ".")
    val CLP = Currency("CLP", "Chilean Peso", "CLP$", 0, ".", ".")
