    val USD = Currency("USD", "US Dollar", "$", 2, ".", ",")
    val CAD = Currency("CAD", "Canadian Dollar", "CA$", 2, ".", ",")
    val MXN = Currency("MXN", "Mexican Peso", "Mex$", 2, ".", ",")
