    val NIO = Currency("NIO", "Nicaraguan Córdoba", "C$", 2, ".", ",")
    val PAB = Currency("PAB", "Panamanian Balboa", "B/.", 2, ".", ",")
    val JMD = Currency("JMD", "Jamaican Dollar", "J$", 2, ".", ",")
    val TTD = Currency("TTD", "Trinidad and Tobago Dollar", "TT$", 2, ".", ",")

    // Major Global (Europe, Asia, Oceania, Middle East, Africa)
    val EUR = Currency("EUR", "Euro", "€", 2, ",", ".")
    val GBP = Currency("GBP", "British Pound", "£", 2, ".", ",")
    val JPY = Currency("JPY", "Japanese Yen", "¥", 0, ".", ",")
    val CHF = Currency("CHF", "Swiss Franc", "CHF", 2, ".", "'")
    val AUD = Currency("AUD", "Australian Dollar", "A$", 2, ".", ",")
    val NZD = Currency("NZD", "New Zealand Dollar", "NZ$", 2, ".", ",")
    val CNY = Currency("CNY", "Chinese Yuan", "¥", 2, ".", ",")
    val HKD = Currency("HKD", "Hong Kong Dollar", "HK$", 2, ".", ",")
    val SGD = Currency("SGD", "Singapore Dollar", "S$", 2, ".", ",")
    val KRW = Currency("KRW", "South Korean Won", "₩", 0, ".", ",")
    val INR = Currency("INR", "Indian Rupee", "₹", 2, ".", ",")
    val SEK = Currency("SEK", "Swedish Krona", "kr", 2, ",", ".")
    val NOK = Currency("NOK", "Norwegian Krone", "kr", 2, ",", ".")
    val DKK = Currency("DKK", "Danish Krone", "kr.", 2, ",", ".")
    val PLN = Currency("PLN", "Polish Złoty", "zł", 2, ",", ".")
    val TRY = Currency("TRY", "Turkish Lira", "₺", 2, ",", ".")
    val AED = Currency("AED", "UAE Dirham", "AED", 2, ".", ",")
    val SAR = Currency("SAR", "Saudi Riyal", "SR", 2, ".", ",")
    val ILS = Currency("ILS", "Israeli New Shekel", "₪", 2, ".", ",")
    val ZAR = Currency("ZAR", "South African Rand", "R", 2, ",", ".")
}

type Money(val cents: Int, val currency: Currency) {
    operator fun plus(other: Money): Money {
        if (this.currency.code != other.currency.code) {
            throw Exception("Currency mismatch: " + this.currency.code + " vs " + other.currency.code)
        }
        return Money(this.cents + other.cents, this.currency)
    }

    operator fun minus(other: Money): Money {
        if (this.currency.code != other.currency.code) {
            throw Exception("Currency mismatch: " + this.currency.code + " vs " + other.currency.code)
        }
        return Money(this.cents - other.cents, this.currency)
    }

    operator fun times(factor: Int): Money {
        return Money(this.cents * factor, this.currency)
    }

    operator fun equals(other: Money): Bool {
        return this.cents == other.cents && this.currency.code == other.currency.code
    }

    fun isZero(): Bool = this.cents == 0

    fun isPositive(): Bool = this.cents > 0

    fun isNegative(): Bool = this.cents < 0

    fun allocate(ratios: List<Int>): List<Money> {
        var totalWeight = 0
        var i = 0
        while (i < ratios.size()) {
            val weight = ratios[i]
            if (weight < 0) {
                throw Exception("Ratio weight cannot be negative")
            }
            totalWeight = totalWeight + weight
            i = i + 1
        }

        if (totalWeight == 0) {
            throw Exception("Total weight must be greater than 0")
        }

        var remainder = this.cents
        val result = MutableList<Money>()

        i = 0
        while (i < ratios.size()) {
            val weight = ratios[i]
            val share = (this.cents * weight) / totalWeight
            result.add(Money(share, this.currency))
            remainder = remainder - share
            i = i + 1
        }

        // Distribute remaining cents 1-by-1 to preserve exact sum (Fowler pattern)
        i = 0
        while (remainder > 0 && i < result.size()) {
            val current = result[i]
            result.set(i, Money(current.cents + 1, this.currency))
            remainder = remainder - 1
            i = i + 1
        }

        return result.freeze()
    }

    fun split(parts: Int): List<Money> {
        if (parts <= 0) {
            throw Exception("Parts must be greater than 0")
        }
        val ratios = MutableList<Int>()
        var i = 0
        while (i < parts) {
            ratios.add(1)
            i = i + 1
        }
        return this.allocate(ratios.freeze())
    }

    fun format(): String {
        return this.currency.formatAmount(this.cents)
    }
}

fun money(cents: Int, currency: Currency): Money {
    return Money(cents, currency)
}

// South America
fun brl(cents: Int): Money = Money(cents, Currencies.BRL)
fun ars(cents: Int): Money = Money(cents, Currencies.ARS)
fun clp(amount: Int): Money = Money(amount, Currencies.CLP)
