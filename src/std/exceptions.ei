contract Throwable {
    fun message(): String
}

/// Bypassed by generic handlers; only explicit `ControlFlow` catches observe it.
contract ControlFlow {
    fun message(): String
}

type AssertionException(val text: String) : Throwable {
    implement fun message() = this.text
}

type Exception(val text: String) : Throwable {
    implement fun message() = this.text
}

/// Value-delivery signal for inlined (`@Embed`) loop drivers: `leave v`
/// becomes `throw LeaveValue(v)`, caught per expansion.
type LeaveValue<T>(val value: T) : ControlFlow {
    implement fun message() = "leave value"
}

/// Region-exit signal for inlined (`@Embed`) loop drivers: block-direct
/// bare `leave`s become `throw EmbedReturn()`, caught per expansion.
/// (Also carries callee-own early `return`s out of the pasted region.)
type EmbedReturn(val code: Int = 0) : ControlFlow {
    implement fun message() = "embed return"
}

fun error(msg: String): Void {
    throw Exception(msg)
}

fun assert(condition: Bool, message: String = "Assertion failed") {
    if (condition == false) {
        throw AssertionException(message)
    }
}
