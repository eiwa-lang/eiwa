import { Socket, TCPServer } from "std.net"
import { Map, MutableMap } from "std.collections"

@Link("curl")
@Header("<curl/curl.h>")
lib NativeHttp {
    @Alias("curl_easy_init")
    fun curlEasyInit(): Pointer
    
    @Alias("curl_easy_perform")
    fun curlEasyPerform(curl: Pointer): Int
    
    @Alias("curl_easy_cleanup")
    fun curlEasyCleanup(curl: Pointer): Void
    
    @Alias("curl_easy_setopt")
    fun curlEasySetopt(curl: Pointer, option: Int, value: Pointer...): Int
    
    @Alias("curl_easy_getinfo")
    fun curlEasyGetInfo(curl: Pointer, info: Int, value: Pointer...): Int
}

/// Memory view of the write-buffer slot: the curl write callback accumulates
/// the response body into a `core_String` (layout `{ _desc, ptr, length }`).
type CString(var ptr: Pointer, var length: Int)

fun writeCallback(contents: Pointer, size: Int, nmemb: Int, userp: Pointer): Int {
    val s = userp as CString
    val n = size * nmemb
    val newData = Standard.gcRealloc(s.ptr, s.length + n + 1)
    Standard.memcpy(newData + s.length, contents, n)
    s.ptr = newData
    s.length = s.length + n
    return n
}

type Response(val status: Int, val body: String)

type Client() {
    fun get(url: String): Response {
        val curl = NativeHttp.curlEasyInit()
        if (curl == null) {
            return Response(0, "")
        }
        
        val buffer = Standard.gcMalloc(24)
        
        val CURLOPT_URL = 10002
        val CURLOPT_WRITEFUNCTION = 20011
        val CURLOPT_WRITEDATA = 10001
        val CURLOPT_FOLLOWLOCATION = 52
        val CURLOPT_TIMEOUT_MS = 155
        val CURLOPT_CONNECTTIMEOUT_MS = 156
        val CURLINFO_RESPONSE_CODE = 2097154
        
        NativeHttp.curlEasySetopt(curl, CURLOPT_URL, url.ptr)
        NativeHttp.curlEasySetopt(curl, CURLOPT_WRITEFUNCTION, funPointer { contents: Pointer, size: Int, nmemb: Int, userp: Pointer -> writeCallback(contents, size, nmemb, userp) })
        NativeHttp.curlEasySetopt(curl, CURLOPT_WRITEDATA, buffer)
        NativeHttp.curlEasySetopt(curl, CURLOPT_FOLLOWLOCATION, 1)
        // Never block the caller indefinitely: fail after a bounded connect
        // and overall time instead of hanging on a stalled endpoint.
        NativeHttp.curlEasySetopt(curl, CURLOPT_CONNECTTIMEOUT_MS, 5000)
        NativeHttp.curlEasySetopt(curl, CURLOPT_TIMEOUT_MS, 15000)
        
        val res = NativeHttp.curlEasyPerform(curl)
        
        var status = 0
        if (res == 0) {
            status = Memory.alloc<IntVar> {
                NativeHttp.curlEasyGetInfo(curl, CURLINFO_RESPONSE_CODE, it.ptr)
            }.get()
        }
        
        NativeHttp.curlEasyCleanup(curl)
        
        val bodyBuf = buffer as CString
        val bodyStr = if (bodyBuf.ptr == null) "" else String(bodyBuf.ptr, bodyBuf.length)
        return Response(status, bodyStr)
    }

    fun post(url: String, body: String): Response {
        val curl = NativeHttp.curlEasyInit()
        if (curl == null) {
            return Response(0, "")
        }
        
        val buffer = Standard.gcMalloc(24)
        
        val CURLOPT_URL = 10002
        val CURLOPT_WRITEFUNCTION = 20011
        val CURLOPT_WRITEDATA = 10001
        val CURLOPT_POST = 47
        val CURLOPT_POSTFIELDS = 10015
        val CURLOPT_POSTFIELDSIZE = 60
        val CURLOPT_FOLLOWLOCATION = 52
        val CURLOPT_TIMEOUT_MS = 155
        val CURLOPT_CONNECTTIMEOUT_MS = 156
        val CURLINFO_RESPONSE_CODE = 2097154
        
        NativeHttp.curlEasySetopt(curl, CURLOPT_URL, url.ptr)
        NativeHttp.curlEasySetopt(curl, CURLOPT_WRITEFUNCTION, funPointer { contents: Pointer, size: Int, nmemb: Int, userp: Pointer -> writeCallback(contents, size, nmemb, userp) })
        NativeHttp.curlEasySetopt(curl, CURLOPT_WRITEDATA, buffer)
        NativeHttp.curlEasySetopt(curl, CURLOPT_FOLLOWLOCATION, 1)
        // Never block the caller indefinitely: fail after a bounded connect
        // and overall time instead of hanging on a stalled endpoint.
        NativeHttp.curlEasySetopt(curl, CURLOPT_CONNECTTIMEOUT_MS, 5000)
        NativeHttp.curlEasySetopt(curl, CURLOPT_TIMEOUT_MS, 15000)
        
        NativeHttp.curlEasySetopt(curl, CURLOPT_POST, 1)
        NativeHttp.curlEasySetopt(curl, CURLOPT_POSTFIELDS, body.ptr)
        NativeHttp.curlEasySetopt(curl, CURLOPT_POSTFIELDSIZE, body.length)
        
        val res = NativeHttp.curlEasyPerform(curl)
        
        var status = 0
        if (res == 0) {
            status = Memory.alloc<IntVar> {
                NativeHttp.curlEasyGetInfo(curl, CURLINFO_RESPONSE_CODE, it.ptr)
            }.get()
        }
        
        NativeHttp.curlEasyCleanup(curl)
        
        val bodyBuf = buffer as CString
        val bodyStr = if (bodyBuf.ptr == null) "" else String(bodyBuf.ptr, bodyBuf.length)
        return Response(status, bodyStr)
    }
}

type Request(val method: String, val path: String, val body: String, val headers: Map<String, String>, val queries: Map<String, String>)

type ServerConnection(val sock: Socket) {
    fun readRequest(): Request {
        // The request (headers + body) may arrive in several TCP segments
        // (e.g. via a proxy like Traefik). Keep reading until the headers are
        // complete AND the full body (per Content-Length) has been received.
        var raw = ""
        var complete = false
        while (!complete) {
            val chunk = this.sock.read(4096)
            if (chunk == "") {
                complete = true
            } else {
                raw = raw + chunk
                val bodyStart = raw.indexOf("\r\n\r\n")
                if (bodyStart >= 0) {
                    val contentLength = this.parseContentLength(raw.substring(0, bodyStart))
                    if (contentLength <= 0) {
                        complete = true
                    } else {
                        val haveBody = raw.length - (bodyStart + 4)
                        if (haveBody >= contentLength) {
                            complete = true
                        }
                    }
                }
            }
        }

        var method = "GET"
        var path = "/"
        
        val space1 = raw.indexOf(" ")
        if (space1 > 0) {
            method = raw.substring(0, space1)
            val rest = raw.substring(space1 + 1, raw.length)
            val space2 = rest.indexOf(" ")
            if (space2 > 0) {
                path = rest.substring(0, space2)
            } else {
                path = rest
            }
        }
        
        var body = ""
        val bodyStart = raw.indexOf("\r\n\r\n")
        if (bodyStart >= 0) {
            val contentLength = this.parseContentLength(raw.substring(0, bodyStart))
            if (contentLength > 0 && bodyStart + 4 + contentLength <= raw.length) {
                body = raw.substring(bodyStart + 4, bodyStart + 4 + contentLength)
            } else {
                body = raw.substring(bodyStart + 4, raw.length)
            }
        }
        
        // Parse actual path and queries
        var actualPath = path
        var queryStr = ""
        val qMark = path.indexOf("?")
        if (qMark >= 0) {
            actualPath = path.substring(0, qMark)
            queryStr = path.substring(qMark + 1, path.length)
        }
        
        val queriesMap = MutableMap<String, String>()
        if (queryStr.length > 0) {
            var rest = queryStr
            var searching = true
            while (searching) {
                val ampIdx = rest.indexOf("&")
                var pair = ""
                if (ampIdx >= 0) {
                    pair = rest.substring(0, ampIdx)
                    rest = rest.substring(ampIdx + 1, rest.length)
                } else {
                    pair = rest
                    searching = false
                }
                
                val eqIdx = pair.indexOf("=")
                if (eqIdx >= 0) {
                    val key = pair.substring(0, eqIdx)
                    val value = pair.substring(eqIdx + 1, pair.length)
                    queriesMap.put(key, value)
                } else if (pair.length > 0) {
                    queriesMap.put(pair, "")
                }
                
                if (rest.length == 0) {
                    searching = false
                }
            }
        }
        
        // Parse headers
        val headersMap = MutableMap<String, String>()
        val firstLineEnd = raw.indexOf("\r\n")
        if (firstLineEnd > 0 && bodyStart > firstLineEnd) {
            var headersPart = raw.substring(firstLineEnd + 2, bodyStart)
            var searching = true
            while (searching) {
                val lineEnd = headersPart.indexOf("\r\n")
                var line = ""
                if (lineEnd >= 0) {
                    line = headersPart.substring(0, lineEnd)
                    headersPart = headersPart.substring(lineEnd + 2, headersPart.length)
                } else {
                    line = headersPart
                    searching = false
                }
                
                if (line.length > 0) {
                    val colonIdx = line.indexOf(":")
                    if (colonIdx > 0) {
                        val key = line.substring(0, colonIdx)
                        var valStart = colonIdx + 1
                        while (valStart < line.length && line.substring(valStart, valStart + 1) == " ") {
                            valStart = valStart + 1
                        }
                        val value = line.substring(valStart, line.length)
                        headersMap.put(key, value)
                    }
                }
                
                if (headersPart.length == 0) {
                    searching = false
                }
            }
        }
        
        return Request(method, actualPath, body, headersMap.freeze(), queriesMap.freeze())
    }

    fun parseContentLength(headersPart: String): Int {
        var rest = headersPart
        var searching = true
        while (searching) {
            val lineEnd = rest.indexOf("\r\n")
            var line = ""
            if (lineEnd >= 0) {
                line = rest.substring(0, lineEnd)
                rest = rest.substring(lineEnd + 2, rest.length)
            } else {
                line = rest
                searching = false
            }
            if (line.length > 0) {
                val colonIdx = line.indexOf(":")
                if (colonIdx > 0) {
                    val key = line.substring(0, colonIdx)
                    if (this.iequals(key, "Content-Length")) {
                        var valStart = colonIdx + 1
                        while (valStart < line.length && line.substring(valStart, valStart + 1) == " ") {
                            valStart = valStart + 1
                        }
                        return this.parseInt(line.substring(valStart, line.length))
                    }
                }
            }
            if (rest.length == 0) {
                searching = false
            }
        }
        return -1
    }

    fun iequals(a: String, b: String): Bool {
        if (a.length != b.length) {
            return false
        }
        var i = 0
        while (i < a.length) {
            var ca = NativeMemory.readByte(a.ptr!!, i)
            var cb = NativeMemory.readByte(b.ptr!!, i)
            if (ca >= 65 && ca <= 90) {
                ca = ca + 32
            }
            if (cb >= 65 && cb <= 90) {
                cb = cb + 32
            }
            if (ca != cb) {
                return false
            }
            i = i + 1
        }
        return true
    }

    fun parseInt(s: String): Int {
        var result = 0
        var i = 0
        while (i < s.length) {
            val c = NativeMemory.readByte(s.ptr!!, i)
            if (c >= 48 && c <= 57) {
                result = result * 10 + (c - 48)
            }
            i = i + 1
        }
        return result
    }
    
    fun writeResponse(status: Int, contentType: String, body: String): Void {
        val statusLine = "HTTP/1.1 $status OK\r\n"
        val headers = "Content-Type: $contentType\r\nContent-Length: ${body.length}\r\nConnection: close\r\n\r\n"
        
        this.sock.write("$statusLine$headers")
        this.sock.write(body)
    }
    
    fun close(): Void {
        this.sock.close()
    }
}

type Server(val tcpServer: TCPServer = TCPServer(-1)) {
    fun bind(port: Int): Bool {
        return this.tcpServer.bind(port)
    }
    
    fun accept(): ServerConnection? {
        val sock = this.tcpServer.accept()
        if (sock == null) {
            return null
        }
        return ServerConnection(sock)
    }
    
    fun close(): Void {
        this.tcpServer.close()
    }
}
