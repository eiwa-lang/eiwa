@Header("<stdio.h>")
lib Console {
    fun printf(format: Pointer, value: Int): Void
    fun puts(str: Pointer): Int
    fun fflush(stream: Pointer): Int
}

skill Echoable : Stringable {
    fun echo() {
        println(this.toString())
    }
}

fun print(value: Stringable?) {
    if (value == null) {
        Console.printf("null".ptr)
    } else {
        Console.printf("%s".ptr, value!!.toString().ptr)
    }
    Console.fflush(0)
}

fun println() {
    Console.puts("".ptr)
}

fun echo(value: Stringable?) {
    println(value)
}

fun println(value: Stringable?) {
    if (value == null) {
        Console.puts("null".ptr)
    } else {
        Console.puts(value!!.toString().ptr)
    }
}

fun printWelcome() {
    println(
        "   _____ _               \n" +
        "  | ____(_)_      ____ _ \n" +
        "  |  _| | |\\ \\ /\\ / / _` |\n" +
        "  | |___| | \\ V  V / (_| |\n" +
        "  |_____|_|  \\_/\\_/ \\__,_| v0.1\n"
    )
}
