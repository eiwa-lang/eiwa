@Header("<stdlib.h>", "<stdio.h>")
lib Standard {
    @Alias("sprintf")
    fun sprintfInt(buffer: Pointer, format: Pointer, value: Int): Int

    @Alias("sprintf")
    fun sprintfDouble(buffer: Pointer, format: Pointer, value: Double): Int

    fun atof(nptr: Pointer): Double

    @Alias("GC_MALLOC")
    fun gcMalloc(size: Int): Pointer

    @Alias("GC_REALLOC")
    fun gcRealloc(ptr: Pointer, newSize: Int): Pointer

    fun exit(code: Int): Void
}

@Header("<string.h>")
lib NativeString {
    fun strcmp(s1: Pointer, s2: Pointer): Int

    fun strstr(haystack: Pointer, needle: Pointer): Pointer

    fun strcpy(dest: Pointer, src: Pointer): Pointer

    fun strncpy(dest: Pointer, src: Pointer, n: Int): Pointer

    fun strlen(s: Pointer): Int
}

lib NativeMemory {
    @Alias("eiwa_char_at")
    fun readByte(ptr: Pointer, index: Int): Int

    @Alias("eiwa_write_byte")
    fun writeByte(ptr: Pointer, index: Int, value: Int): Void

    @Alias("eiwa_random_bytes")
    fun randomBytes(ptr: Pointer, len: Int): Void

    @Alias("eiwa_now_millis")
    fun nowMillis(): Int

    @Alias("eiwa_double_to_int")
    fun doubleToInt(value: Double): Int

    @Alias("eiwa_int_to_double")
    fun intToDouble(value: Int): Double
}

contract Stringable {
    fun toString(): String
}

contract Equatable {
    operator fun equals(other: Stringable): Bool
}

contract Hashable {
    fun hashCode(): Int
}

contract Runnable {
    fun run()
}

contract Closeable {
    fun close()
}

skill Scope<T> {

    fun let<R>(block: (T) -> R): R {
        return block(this)
    }

    fun also(block: (T) -> Void): T {
        block(this)
        return this
    }

    fun apply(block: (T) -> Void): T {
        block(this)
        return this
    }

    fun run<R>(block: (T) -> R): R {
        return block(this)
    }

    fun takeIf(predicate: (T) -> Bool): T? {
        if (predicate(this)) {
            return this
        } else {
            return null
        }
    }

    fun takeUnless(predicate: (T) -> Bool): T? {
        if (!predicate(this)) {
            return this
        } else {
            return null
        }
    }

}

fun with<T, R>(receiver: T, block: (T) -> R): R {
    return block(receiver)
}

fun use<T>(receiver: T, block: (T) -> Void): Void {
    try {
        block(receiver)
        if (receiver is Closeable) {
            receiver.close()
        }
    } catch (e: Throwable) {
        if (receiver is Closeable) {
            receiver.close()
        }
        throw e
    }
}

@Primitive("pointer")
type Pointer {
    fun readByte(index: Int): Int = NativeMemory.readByte(this, index)

    fun writeByte(index: Int, value: Int): Void {
        NativeMemory.writeByte(this, index, value)
    }
}

type String(val ptr: Pointer, val length: Int) : Stringable, Equatable, Hashable {
    implement fun toString(): String = this

    operator fun equals(other: String): Bool {
        return NativeString.strcmp(this.ptr, other.ptr) == 0
    }
    operator fun plus(other: String): String {
        val totalLen = this.length + other.length
        val buf = Standard.gcMalloc(totalLen + 1)
        Standard.sprintfInt(buf, "%s%s".ptr, this.ptr, other.ptr)
        return String(buf, totalLen)
    }

    fun replace(old: String, newStr: String): String {
        var count = 0
        var curr = this.ptr
        var searching = true

        while (searching) {
            val match = NativeString.strstr(curr, old.ptr)
            if (match != null) {
                count = count + 1
                curr = match + old.length
            } else {
                searching = false
            }
        }

        if (count == 0) { return this }

        val newLen = this.length + (count * (newStr.length - old.length))
        val res = Standard.gcMalloc(newLen + 1)

        curr = this.ptr
        var resCurr = res
        searching = true

        while (searching) {
            val match = NativeString.strstr(curr, old.ptr)
            if (match != null) {
                val prefixLen = match - curr
                NativeString.strncpy(resCurr, curr, prefixLen)
                resCurr = resCurr + prefixLen

                NativeString.strcpy(resCurr, newStr.ptr)
                resCurr = resCurr + newStr.length

                curr = match + old.length
            } else {
                NativeString.strcpy(resCurr, curr)
                searching = false
            }
        }


        return String(res, newLen)
    }

    fun indexOf(needle: String): Int {
        val match = NativeString.strstr(this.ptr, needle.ptr)
        if (match == null) { return -1 }
        return match - this.ptr
    }

    fun contains(other: String): Bool {
        return this.indexOf(other) != -1
    }


    fun substring(start: Int, end: Int): String {
        if (start < 0 || end > this.length || start > end) {
            return ""
        }
        val len = end - start
        val buf = Standard.gcMalloc(len + 1)
        NativeString.strncpy(buf, this.ptr + start, len)
        NativeMemory.writeByte(buf, len, 0)
        return String(buf, len)
    }

    fun toDouble(): Double {
        return Standard.atof(this.ptr)
    }

    fun hashCode(): Int {
        var hash = 5381
        var i = 0
        while (i < this.length) {
            val c = NativeMemory.readByte(this.ptr, i)
            hash = hash * 33 + c
            i = i + 1
        }
        return hash
    }
}

@Primitive("int64_t")
type Int : Stringable, Equatable, Hashable {
    implement fun toString(): String {
        val buf = Standard.gcMalloc(32)
        Standard.sprintfInt(buf, "%lld".ptr, this)
        return String(buf, NativeString.strlen(buf))
    }

    implement fun hashCode(): Int {
        return this
    }

    implement operator fun equals(other: Stringable): Bool {
        if (other is Int) {
            return this == other
        }
        return false
    }

    fun toDouble(): Double {
        return NativeMemory.intToDouble(this)
    }

    fun toInt(): Int = this
}

@Primitive("double")
type Double : Stringable, Equatable, Hashable {
    implement fun toString(): String {
        val buf = Standard.gcMalloc(64)
        Standard.sprintfDouble(buf, "%g".ptr, this)
        return String(buf, NativeString.strlen(buf))
    }

    implement fun hashCode(): Int {
        return NativeMemory.doubleToInt(this)
    }

    implement operator fun equals(other: Stringable): Bool {
        if (other is Double) {
            return this == (other as Double)
        }
        return false
    }

    fun toInt(): Int {
        return NativeMemory.doubleToInt(this)
    }

    fun toDouble(): Double = this
}

contract Awaitable<T> {
    fun await(): T
    fun start(): Awaitable<T>
    fun isDone(): Bool
}

@Primitive("bool")
type Bool : Stringable, Equatable, Hashable {
    implement fun toString(): String {
        return if (this) "true" else "false"
    }

    implement fun hashCode(): Int {
        return if (this) 1 else 0
    }

    implement operator fun equals(other: Stringable): Bool {
        if (other is Bool) {
            return this == other
        }
        return false
    }
}
