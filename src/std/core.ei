@Header("<stdlib.h>", "<stdio.h>")
lib Standard {
    @Alias("sprintf")
    fun sprintfInt(buffer: Pointer, format: Pointer, value: Int): Int

    @Alias("sprintf")
    fun sprintfDouble(buffer: Pointer, format: Pointer, value: Double): Int

    fun atof(nptr: Pointer): Double
 
    @Alias("malloc")
    fun malloc(size: Int): Pointer

    @Alias("free")
    fun free(ptr: Pointer): Void

    @Alias("GC_MALLOC")
    fun gcMalloc(size: Int): Pointer

    @Alias("GC_REALLOC")
    fun gcRealloc(ptr: Pointer, newSize: Int): Pointer

    @Alias("eiwa_load_int64")
    fun loadInt64(ptr: Pointer): Int

    @Alias("eiwa_store_int64")
    fun storeInt64(ptr: Pointer, value: Int): Void

    @Alias("memcpy")
    fun memcpy(dest: Pointer, src: Pointer, n: Int): Pointer

    fun exit(code: Int): Void
}

@Header("<string.h>")
lib NativeString {
    fun strcmp(s1: Pointer, s2: Pointer): Int

    fun strstr(haystack: Pointer, needle: Pointer): Pointer

    fun strcpy(dest: Pointer, src: Pointer): Pointer

    fun strncpy(dest: Pointer, src: Pointer, n: Int): Pointer

    fun strncmp(s1: Pointer, s2: Pointer, n: Int): Int

    fun strlen(s: Pointer): Int
}

lib NativeMemory {
    @Alias("eiwa_char_at")
    fun readByte(ptr: Pointer, index: Int): Int

    @Alias("eiwa_write_byte")
    fun writeByte(ptr: Pointer, index: Int, value: Int): Void

    @Alias("eiwa_random_bytes")
    fun randomBytes(ptr: Pointer, len: Int): Void

    @Alias("eiwa_now_millis")
    fun nowMillis(): Int
}

contract Stringable {
    fun toString(): String
}

contract Equatable {
    operator fun equals(other: Equatable): Bool
}

contract Hashable {
    fun hashCode(): Int
}

contract Runnable {
    fun run()
}

contract Closeable {
    fun close()
}

skill Scope<T> {

    fun let<R>(block: (T) -> R): R {
        return block(this)
    }

    fun also(block: (T) -> Void): T {
        block(this)
        return this
    }

    fun apply(block: (T) -> Void): T {
        block(this)
        return this
    }

    fun run<R>(block: (T) -> R): R {
        return block(this)
    }

    fun takeIf(predicate: (T) -> Bool): T? {
        if (predicate(this)) {
            return this
        } else {
            return null
        }
    }

    fun takeUnless(predicate: (T) -> Bool): T? {
        if (!predicate(this)) {
            return this
        } else {
            return null
        }
    }

}

fun with<T, R>(receiver: T, block: (T) -> R): R {
    return block(receiver)
}

fun use<T>(receiver: T, block: (T) -> Void): Void {
    try {
        block(receiver)
        if (receiver is Closeable) {
            receiver.close()
        }
    } catch (e: Throwable) {
        if (receiver is Closeable) {
            receiver.close()
        }
        throw e
    }
}

@Primitive("pointer")
type Pointer {
    fun readByte(index: Int): Int = NativeMemory.readByte(this, index)

    fun writeByte(index: Int, value: Int): Void {
        NativeMemory.writeByte(this, index, value)
    }
}

/// Typed view of an 8-byte GC slot, mirroring Kotlin/Native `LongVar`/`IntVar`:
/// pass `.ptr` to a C function that writes the value, then read it with `.get()`.
type IntVar(val ptr: Pointer) {
    fun get(): Int = Standard.loadInt64(this.ptr)

    fun set(value: Int): Void {
        Standard.storeInt64(this.ptr, value)
    }
}

/// Allocates an 8-byte GC slot for `T` and runs `block` with a typed view of it
/// (pass `.ptr` to a C out-param, then read with `.get()`). Mirrors
/// Kotlin/Native `memScoped { alloc<IntVar>() }`: `T` is the slot type, so
/// `alloc<DoubleVar>`/`alloc<PointerVar>` will work once those slots exist.
object Memory {
    fun alloc<T>(block: (T) -> Void): T {
        val v = T(Standard.gcMalloc(8))
        block(v)
        return v
    }
}

type String(val ptr: Pointer, val length: Int) : Stringable, Equatable, Hashable {
    implement fun toString(): String = this

    implement operator fun equals(other: Equatable): Bool {
        if (other is String) {
            return NativeString.strcmp(this.ptr, other.ptr) == 0
        }
        return false
    }

    operator fun plus(other: Stringable): String {
        val totalLen = this.length + other.toString().length
        val buf = Standard.gcMalloc(totalLen + 1)
        Standard.sprintfInt(buf, "%s%s".ptr, this.ptr, other.toString().ptr)
        return String(buf, totalLen)
    }

    fun replace(old: String, newStr: String): String {
        var count = 0
        var curr = this.ptr
        var searching = true

        while (searching) {
            val match = NativeString.strstr(curr, old.ptr)
            if (match != null) {
                count = count + 1
                curr = match + old.length
            } else {
                searching = false
            }
        }

        if (count == 0) { return this }

        val newLen = this.length + (count * (newStr.length - old.length))
        val res = Standard.gcMalloc(newLen + 1)

        curr = this.ptr
        var resCurr = res
        searching = true

        while (searching) {
            val match = NativeString.strstr(curr, old.ptr)
            if (match != null) {
                val prefixLen = match - curr
                NativeString.strncpy(resCurr, curr, prefixLen)
                resCurr = resCurr + prefixLen

                NativeString.strcpy(resCurr, newStr.ptr)
                resCurr = resCurr + newStr.length

                curr = match + old.length
            } else {
                NativeString.strcpy(resCurr, curr)
                searching = false
            }
        }

        return String(res, newLen)
    }

    fun indexOf(needle: String): Int {
        val match = NativeString.strstr(this.ptr, needle.ptr)
        if (match == null) { return -1 }
        return match - this.ptr
    }

    fun contains(other: String): Bool {
        return this.indexOf(other) != -1
    }

    fun startsWith(prefix: String): Bool {
        if (prefix.length > this.length) {
            return false
        }
        return NativeString.strncmp(this.ptr, prefix.ptr, prefix.length) == 0
    }

    fun endsWith(suffix: String): Bool {
        if (suffix.length > this.length) {
            return false
        }
        val offset = this.length - suffix.length
        return NativeString.strncmp(this.ptr + offset, suffix.ptr, suffix.length) == 0
    }

    fun substring(start: Int, end: Int): String {
        if (start < 0 || end > this.length || start > end) {
            return ""
        }
        val len = end - start
        val buf = Standard.gcMalloc(len + 1)
        NativeString.strncpy(buf, this.ptr + start, len)
        NativeMemory.writeByte(buf, len, 0)
        return String(buf, len)
    }

    fun charAt(index: Int): String {
        if (index < 0 || index >= this.length) {
            return ""
        }
        val buf = Standard.gcMalloc(2)
        val b = NativeMemory.readByte(this.ptr, index)
        NativeMemory.writeByte(buf, 0, b)
        NativeMemory.writeByte(buf, 1, 0)
        return String(buf, 1)
    }

    fun toDouble(): Double {
        return Standard.atof(this.ptr)
    }

    implement fun hashCode(): Int {
        var hash = 5381
        var i = 0
        while (i < this.length) {
            val c = NativeMemory.readByte(this.ptr, i)
            hash = hash * 33 + c
            i = i + 1
        }
        return hash
    }
}

@Primitive("int64_t")
type Int : Stringable, Equatable, Hashable {
    implement fun toString(): String {
        val buf = Standard.gcMalloc(32)
        Standard.sprintfInt(buf, "%lld".ptr, this)
        return String(buf, NativeString.strlen(buf))
    }

    implement fun hashCode(): Int {
        return this
    }

    implement operator fun equals(other: Stringable): Bool {
        if (other is Int) {
            return this == other
        }
        return false
    }

    fun toDouble(): Double {
        return this as Double
    }

    fun toInt(): Int = this
}

@Primitive("double")
type Double : Stringable, Equatable, Hashable {
    implement fun toString(): String {
        val buf = Standard.gcMalloc(64)
        Standard.sprintfDouble(buf, "%g".ptr, this)
        return String(buf, NativeString.strlen(buf))
    }

    implement fun hashCode(): Int {
        return this as Int
    }

    implement operator fun equals(other: Stringable): Bool {
        if (other is Double) {
            return this == (other as Double)
        }
        return false
    }

    fun toInt(): Int {
        return this as Int
    }

    fun toDouble(): Double = this
}

contract Awaitable<T> {
    @Suspend
    fun await(): T
    fun isDone(): Bool
}

@Primitive("bool")
type Bool : Stringable, Equatable, Hashable {
    implement fun toString(): String {
        return if (this) "true" else "false"
    }

    implement fun hashCode(): Int {
        return if (this) 1 else 0
    }

    implement operator fun equals(other: Stringable): Bool {
        if (other is Bool) {
            return this == other
        }
        return false
    }
}
