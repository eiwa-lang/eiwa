@Header("<stdlib.h>", "<stdio.h>")
lib Standard {
    @Alias("sprintf")
    fun sprintfInt(buffer: Pointer, format: Pointer, value: Int): Int

    @Alias("sprintf")
    fun sprintfDouble(buffer: Pointer, format: Pointer, value: Double): Int

    fun atof(nptr: Pointer): Double
 
    @Alias("malloc")
    fun malloc(size: Int): Pointer

    @Alias("free")
    fun free(ptr: Pointer): Void

    @Alias("GC_MALLOC")
    fun gcMalloc(size: Int): Pointer

    @Alias("GC_malloc_atomic")
    fun gcMallocAtomic(size: Int): Pointer

    @Alias("GC_REALLOC")
    fun gcRealloc(ptr: Pointer, newSize: Int): Pointer

    @Alias("eiwa_load_int64")
    fun loadInt64(ptr: Pointer): Int

    @Alias("eiwa_store_int64")
    fun storeInt64(ptr: Pointer, value: Int): Void

    @Alias("memcpy")
    fun memcpy(dest: Pointer, src: Pointer, n: Int): Pointer

    fun exit(code: Int): Void
}

@Header("<string.h>", "<ctype.h>", "src/runtime/third_party/eiwa_string/string_helpers.h")
@Source("src/runtime/third_party/eiwa_string/string_helpers.c")
lib NativeString {
    @Alias("eiwa_strcmp")
    fun strcmp(s1: Pointer, s2: Pointer): Int

    fun strstr(haystack: Pointer, needle: Pointer): Pointer

    fun strcpy(dest: Pointer, src: Pointer): Pointer

    fun strncpy(dest: Pointer, src: Pointer, n: Int): Pointer

    fun strncmp(s1: Pointer, s2: Pointer, n: Int): Int

    fun strlen(s: Pointer): Int

    fun tolower(c: Int): Int

    fun toupper(c: Int): Int
}

lib NativeMemory {
    @Alias("eiwa_char_at")
    fun readByte(ptr: Pointer, index: Int): Int

    @Alias("eiwa_write_byte")
    fun writeByte(ptr: Pointer, index: Int, value: Int): Void

    @Alias("eiwa_random_bytes")
    fun randomBytes(ptr: Pointer, len: Int): Void

    @Alias("eiwa_now_millis")
    fun nowMillis(): Int
}

contract Stringable {
    fun toString(): String
}

contract Equatable {
    operator fun equals(other: Equatable): Bool
}

contract Hashable {
    fun hashCode(): Int
}

contract Runnable {
    fun run()
}

contract Closeable {
    fun close()
}

contract Slicable<T> {
    fun slice(start: Int, end: Int): List<T>
    fun skip(n: Int): List<T>
    fun take(n: Int): List<T>
    fun skipLast(n: Int): List<T>
    fun takeLast(n: Int): List<T>
}

contract Indexed<T> {
    fun size(): Int
    fun get(index: Int): T
}

contract Searchable<T> {
    fun isEmpty(): Bool
    fun isNotEmpty(): Bool
    fun contains(element: T): Bool
    fun indexOf(element: T): Int
    fun first(): T
    fun last(): T
}

skill Scope<T> {

    fun let<R>(block: (T) -> R): R {
        return block(this)
    }

    fun also(block: (T) -> Void): T {
        block(this)
        return this
    }

    fun apply(block: (T) -> Void): T {
        block(this)
        return this
    }

    fun run<R>(block: (T) -> R): R {
        return block(this)
    }

    fun takeIf(predicate: (T) -> Bool): T? {
        if (predicate(this)) {
            return this
        } else {
            return null
        }
    }

    fun takeUnless(predicate: (T) -> Bool): T? {
        if (!predicate(this)) {
            return this
        } else {
            return null
        }
    }

}

fun with<T, R>(receiver: T, block: (T) -> R): R {
    return block(receiver)
}

fun use<T>(receiver: T, block: (T) -> Void): Void {
    try {
        block(receiver)
        if (receiver is Closeable) {
            receiver.close()
        }
    } catch (e: Throwable) {
        if (receiver is Closeable) {
            receiver.close()
        }
        throw e
    }
}

@Primitive("pointer")
type Pointer {
    fun readByte(index: Int): Int = NativeMemory.readByte(this, index)

    fun writeByte(index: Int, value: Int): Void {
        NativeMemory.writeByte(this, index, value)
    }

    // Lets synthesized default toString/hashCode for types with Pointer
    // fields resolve to real bodies.
    fun toString(): String {
        val buf = Standard.gcMallocAtomic(32)
        Standard.sprintfInt(buf, "%p".ptr, this as Int)
        return String(buf, NativeString.strlen(buf))
    }

    fun hashCode(): Int {
        return this as Int
    }
}

/// Typed view of an 8-byte GC slot, mirroring Kotlin/Native `LongVar`/`IntVar`:
/// pass `.ptr` to a C function that writes the value, then read it with `.get()`.
type IntVar(val ptr: Pointer) {
    fun get(): Int = Standard.loadInt64(this.ptr)

    fun set(value: Int): Void {
        Standard.storeInt64(this.ptr, value)
    }
}

/// Allocates an 8-byte GC slot for `T` and runs `block` with a typed view of it
/// (pass `.ptr` to a C out-param, then read with `.get()`). Mirrors
/// Kotlin/Native `memScoped { alloc<IntVar>() }`: `T` is the slot type, so
/// `alloc<DoubleVar>`/`alloc<PointerVar>` will work once those slots exist.
object Memory {
    fun alloc<T>(block: (T) -> Void): T {
        val v = T(Standard.gcMalloc(8))
        block(v)
        return v
    }
}

/// `length` defaults to `strlen(ptr)`, covering the common case of
/// null-terminated C strings: `String(cPtr)`. Pass an explicit length only
/// when the buffer is not null-terminated or needs truncation.
type String(val ptr: Pointer, val length: Int = NativeString.strlen(ptr)) : Stringable, Equatable, Hashable {
    
    implement fun toString(): String = this

    implement operator fun equals(other: Equatable): Bool {
        if (other is String) {
            return NativeString.strcmp(this.ptr, other.ptr) == 0
        }
        return false
    }

    operator fun plus(other: Stringable): String {
        val s = other.toString()
        val totalLen = this.length + s.length
        val buf = Standard.gcMallocAtomic(totalLen + 1)
        Standard.memcpy(buf, this.ptr, this.length)
        Standard.memcpy(buf + this.length, s.ptr, s.length)
        NativeMemory.writeByte(buf, totalLen, 0)
        return String(buf, totalLen)
    }

    // Byte-level primitives (search, slice, convert) stay in the prelude:
    // half the stdlib needs them import-free. Higher-level String
    // utilities (checks, case, replace, trim) live in std.string.

    fun indexOf(needle: String): Int {
        val match = NativeString.strstr(this.ptr, needle.ptr)
        if (match == null) { return -1 }
        return match - this.ptr
    }

    fun indexOfFrom(needle: String, fromIndex: Int): Int {
        if (fromIndex <= 0) {
            return this.indexOf(needle)
        }
        if (fromIndex >= this.length) {
            return -1
        }
        val match = NativeString.strstr(this.ptr + fromIndex, needle.ptr)
        if (match == null) { return -1 }
        return match - this.ptr
    }

    fun substring(start: Int, end: Int = this.length): String {
        if (start < 0 || end > this.length || start > end) {
            return ""
        }
        val len = end - start
        val buf = Standard.gcMallocAtomic(len + 1)
        Standard.memcpy(buf, this.ptr + start, len)
        NativeMemory.writeByte(buf, len, 0)
        return String(buf, len)
    }

    fun toDouble(): Double {
        return Standard.atof(this.ptr)
    }

    fun toInt(): Int {
        return this.toDouble() as Int
    }

    implement fun hashCode(): Int {
        var hash = 5381
        var i = 0
        while (i < this.length) {
            val c = NativeMemory.readByte(this.ptr, i)
            hash = hash * 33 + c
            i = i + 1
        }
        return hash
    }
}

type StringBuilder(var cap: Int = 32, var buf: Pointer = Standard.gcMallocAtomic(cap + 1), var len: Int = 0) : Stringable {
    fun length(): Int = this.len

    fun isEmpty(): Bool = this.len == 0

    fun ensure(extra: Int): Void {
        val need = this.len + extra + 1
        if (need > this.cap) {
            var newCap = if (this.cap == 0) 32 else this.cap * 2
            while (newCap < need) {
                newCap = newCap * 2
            }
            if (this.buf == null) {
                this.buf = Standard.gcMallocAtomic(newCap)
            } else {
                this.buf = Standard.gcRealloc(this.buf, newCap)
            }
            this.cap = newCap
        }
    }

    fun append(s: String): StringBuilder {
        this.ensure(s.length)
        Standard.memcpy(this.buf + this.len, s.ptr, s.length)
        this.len = this.len + s.length
        NativeMemory.writeByte(this.buf, this.len, 0)
        return this
    }

    fun appendInt(v: Int): StringBuilder {
        if (v == 0) {
            return this.append("0")
        }
        var n = v
        var neg = false
        if (n < 0) {
            neg = true
        }
        var tmp = n
        var digits = 0
        while (tmp != 0) {
            digits = digits + 1
            tmp = tmp / 10
        }
        var total = digits
        if (neg) {
            total = total + 1
        }
        this.ensure(total)
        var pos = this.len + total
        tmp = n
        while (tmp != 0) {
            var d = tmp % 10
            if (d < 0) {
                d = 0 - d
            }
            pos = pos - 1
            NativeMemory.writeByte(this.buf, pos, 48 + d)
            tmp = tmp / 10
        }
        if (neg) {
            pos = pos - 1
            NativeMemory.writeByte(this.buf, pos, 45)
        }
        this.len = this.len + total
        NativeMemory.writeByte(this.buf, this.len, 0)
        return this
    }

    implement fun toString(): String {
        val out = Standard.gcMallocAtomic(this.len + 1)
        if (this.len > 0) {
            Standard.memcpy(out, this.buf, this.len)
        }
        NativeMemory.writeByte(out, this.len, 0)
        return String(out, this.len)
    }
}

@Primitive("int64_t")
type Int : Stringable, Equatable, Hashable {
    implement fun toString(): String {
        val buf = Standard.gcMallocAtomic(32)
        Standard.sprintfInt(buf, "%lld".ptr, this)
        return String(buf, NativeString.strlen(buf))
    }

    implement fun hashCode(): Int {
        return this
    }

    implement operator fun equals(other: Equatable): Bool {
        if (other is Int) {
            return this == other
        }
        return false
    }

    fun toDouble(): Double {
        return this as Double
    }

    fun toInt(): Int = this
}

@Primitive("double")
type Double : Stringable, Equatable, Hashable {
    implement fun toString(): String {
        val buf = Standard.gcMallocAtomic(64)
        Standard.sprintfDouble(buf, "%g".ptr, this)
        return String(buf, NativeString.strlen(buf))
    }

    implement fun hashCode(): Int {
        return this as Int
    }

    implement operator fun equals(other: Equatable): Bool {
        if (other is Double) {
            return this == (other as Double)
        }
        return false
    }

    fun toInt(): Int {
        return this as Int
    }

    fun toDouble(): Double = this
}

contract Awaitable<T> {
    @Suspend
    fun await(): T
    fun isDone(): Bool
}

@Primitive("bool")
type Bool : Stringable, Equatable, Hashable {
    implement fun toString(): String {
        return if (this) "true" else "false"
    }

    implement fun hashCode(): Int {
        return if (this) 1 else 0
    }

    implement operator fun equals(other: Equatable): Bool {
        if (other is Bool) {
            return this == other
        }
        return false
    }
}
