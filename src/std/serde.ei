import { print } from "std.core"
import { List, MutableList, Map, MutableMap } from "std.collections"

contract Serializable {
    fun serialize(): SerdeValue
}

type SerdeField(val name: String, val value: SerdeValue) : Serializable {
    implement fun serialize(): SerdeValue = this.value
    implement fun toString(): String = this.name
}

contract Deserializable<T> {
    fun deserialize(value: SerdeValue): T
}

contract SerdeValue

contract SerdeList {
    fun size(): Int
    fun getAt(index: Int): SerdeValue
}

type SerdeNull() : SerdeValue
type SerdeInt(val v: Int) : SerdeValue
type SerdeDouble(val v: Double) : SerdeValue
type SerdeBool(val v: Bool) : SerdeValue
type SerdeString(val v: String) : SerdeValue
type SerdeListValue(val list: SerdeList) : SerdeValue

type SerdeObject(val fields: List<SerdeField>) : SerdeValue {
    fun get(name: String): SerdeValue? {
        var i = 0
        while (i < this.fields.size()) {
            val f = this.fields.get(i)
            if (f.name == name) {
                return f.value
            }
            i = i + 1
        }
        return null
    }

    fun getString(name: String): String {
        val v = this.get(name)
        if (v != null && v is SerdeString) {
            return (v as SerdeString).v
        }
        return ""
    }

    fun getInt(name: String): Int {
        val v = this.get(name)
        if (v != null) {
            if (v is SerdeInt) {
                return (v as SerdeInt).v
            }
            if (v is SerdeDouble) {
                val d = (v as SerdeDouble).v
                return d.toInt()
            }
        }
        return 0
    }

    fun getDouble(name: String): Double {
        val v = this.get(name)
        if (v != null) {
            if (v is SerdeDouble) {
                return (v as SerdeDouble).v
            }
            if (v is SerdeInt) {
                val i = (v as SerdeInt).v
                return i.toDouble()
            }
        }
        return 0.0
    }

    fun getBool(name: String): Bool {
        val v = this.get(name)
        if (v != null && v is SerdeBool) {
            return (v as SerdeBool).v
        }
        return false
    }

    fun getObject(name: String): SerdeObject? {
        val v = this.get(name)
        if (v != null && v is SerdeObject) {
            return v as SerdeObject
        }
        return null
    }

    fun getList(name: String): SerdeList? {
        val v = this.get(name)
        if (v != null && v is SerdeListValue) {
            return (v as SerdeListValue).list
        }
        return null
    }
}

type SerdeIntList(val list: List<Int>) : SerdeList {
    implement fun size(): Int = list.size()
    implement fun getAt(index: Int): SerdeValue = SerdeInt(list.get(index))
}

type SerdeDoubleList(val list: List<Double>) : SerdeList {
    implement fun size(): Int = list.size()
    implement fun getAt(index: Int): SerdeValue = SerdeDouble(list.get(index))
}

type SerdeBoolList(val list: List<Bool>) : SerdeList {
    implement fun size(): Int = list.size()
    implement fun getAt(index: Int): SerdeValue = SerdeBool(list.get(index))
}

type SerdeStringList(val list: List<String>) : SerdeList {
    implement fun size(): Int = list.size()
    implement fun getAt(index: Int): SerdeValue = SerdeString(list.get(index))
}

type SerdeObjectList<T>(val list: List<T>) : SerdeList {
    implement fun size(): Int = list.size()
    implement fun getAt(index: Int): SerdeValue = list.get(index).serialize()
}

type SerdeGenericList<T>(val list: List<T>) : SerdeList {
    implement fun size(): Int = 0
    implement fun getAt(index: Int): SerdeValue = SerdeString("")
}

fun asSerdeObject(v: SerdeValue?): SerdeObject {
    if (v == null) {
        return SerdeObject(List<SerdeField>())
    }
    if (v is SerdeObject) {
        return v as SerdeObject
    }
    return SerdeObject(List<SerdeField>())
}

fun isMissingOrNull(v: SerdeValue?): Bool {
    if (v == null) {
        return true
    }
    if (v is SerdeNull) {
        return true
    }
    return false
}

fun asString(v: SerdeValue): String {
    if (v is SerdeString) {
        return (v as SerdeString).v
    }
    return ""
}

fun asInt(v: SerdeValue): Int {
    if (v is SerdeInt) {
        return (v as SerdeInt).v
    }
    if (v is SerdeDouble) {
        val d = (v as SerdeDouble).v
        return d.toInt()
    }
    return 0
}

fun asDouble(v: SerdeValue): Double {
    if (v is SerdeDouble) {
        return (v as SerdeDouble).v
    }
    if (v is SerdeInt) {
        val i = (v as SerdeInt).v
        return i.toDouble()
    }
    return 0.0
}

fun asBool(v: SerdeValue): Bool {
    if (v is SerdeBool) {
        return (v as SerdeBool).v
    }
    return false
}

fun asSerdeList(v: SerdeValue): SerdeList? {
    if (v is SerdeListValue) {
        return (v as SerdeListValue).list
    }
    return null
}

fun asNullableString(v: SerdeValue?): String? {
    if (v == null) {
        return null
    }
    if (v is SerdeNull) {
        return null
    }
    if (v is SerdeString) {
        return (v as SerdeString).v
    }
    return null
}

fun asNullableInt(v: SerdeValue?): Int? {
    if (v == null) {
        return null
    }
    if (v is SerdeNull) {
        return null
    }
    if (v is SerdeInt) {
        return (v as SerdeInt).v
    }
    if (v is SerdeDouble) {
        val d = (v as SerdeDouble).v
        return d.toInt()
    }
    return null
}

fun asNullableDouble(v: SerdeValue?): Double? {
    if (v == null) {
        return null
    }
    if (v is SerdeNull) {
        return null
    }
    if (v is SerdeDouble) {
        return (v as SerdeDouble).v
    }
    if (v is SerdeInt) {
        val i = (v as SerdeInt).v
        return i.toDouble()
    }
    return null
}

fun asNullableBool(v: SerdeValue?): Bool? {
    if (v == null) {
        return null
    }
    if (v is SerdeNull) {
        return null
    }
    if (v is SerdeBool) {
        return (v as SerdeBool).v
    }
    return null
}

fun boxNullableString(s: String?): SerdeValue {
    if (s == null) {
        return SerdeNull()
    }
    return SerdeString(s)
}

fun boxNullableInt(v: Int?): SerdeValue {
    if (v == null) {
        return SerdeNull()
    }
    return SerdeInt(v!!)
}

fun boxNullableDouble(v: Double?): SerdeValue {
    if (v == null) {
        return SerdeNull()
    }
    return SerdeDouble(v!!)
}

fun boxNullableBool(v: Bool?): SerdeValue {
    if (v == null) {
        return SerdeNull()
    }
    return SerdeBool(v!!)
}

fun deserializeList<T>(serdeList: SerdeList?, mapper: (SerdeValue) -> T): List<T> {
    if (serdeList == null) {
        return List<T>()
    }
    val out = MutableList<T>()
    var i = 0
    while (i < serdeList!!.size()) {
        out.add(mapper(serdeList!!.getAt(i)))
        i = i + 1
    }
    return out.freeze()
}

fun deserializeStringMap<V>(mapObj: SerdeObject?, mapper: (SerdeValue) -> V): Map<String, V> {
    val out = MutableMap<String, V>()
    if (mapObj == null) {
        return out.freeze()
    }
    var i = 0
    while (i < mapObj!!.fields.size()) {
        val f = mapObj!!.fields.get(i)
        out.put(f.name, mapper(f.value))
        i = i + 1
    }
    return out.freeze()
}

fun serializeStringMap<V>(map: Map<String, V>, mapper: (V) -> SerdeValue): SerdeValue {
    val fields = MutableList<SerdeField>()
    var i = 0
    while (i < map.entries.size()) {
        var curr = map.entries.items[i]
        while (curr != null) {
            fields.add(SerdeField(curr!!.key, mapper(curr!!.value)))
            curr = curr!!.next
        }
        i = i + 1
    }
    return SerdeObject(fields.freeze())
}

