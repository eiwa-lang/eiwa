import { print } from "std.core"
import { List, MutableList } from "std.collections"

contract Serializable {
    fun serialize(): SerdeValue
}

type SerdeField(val name: String, val value: SerdeValue) : Serializable {
    implement fun serialize(): SerdeValue = this.value
    implement fun toString(): String = this.name
}

contract SerdeValue

contract SerdeList {
    fun size(): Int
    fun getAt(index: Int): SerdeValue
}

type SerdeInt(val v: Int) : SerdeValue
type SerdeDouble(val v: Double) : SerdeValue
type SerdeBool(val v: Bool) : SerdeValue
type SerdeString(val v: String) : SerdeValue
type SerdeObject(val fields: List<SerdeField>) : SerdeValue
type SerdeListValue(val list: SerdeList) : SerdeValue

type SerdeIntList(val list: List<Int>) : SerdeList {
    implement fun size(): Int = list.size()
    implement fun getAt(index: Int): SerdeValue = SerdeInt(list.get(index))
}

type SerdeDoubleList(val list: List<Double>) : SerdeList {
    implement fun size(): Int = list.size()
    implement fun getAt(index: Int): SerdeValue = SerdeDouble(list.get(index))
}

type SerdeBoolList(val list: List<Bool>) : SerdeList {
    implement fun size(): Int = list.size()
    implement fun getAt(index: Int): SerdeValue = SerdeBool(list.get(index))
}

type SerdeStringList(val list: List<String>) : SerdeList {
    implement fun size(): Int = list.size()
    implement fun getAt(index: Int): SerdeValue = SerdeString(list.get(index))
}

type SerdeObjectList<T>(val list: List<T>) : SerdeList {
    implement fun size(): Int = list.size()
    implement fun getAt(index: Int): SerdeValue = list.get(index).serialize()
}

type SerdeGenericList<T>(val list: List<T>) : SerdeList {
    implement fun size(): Int = 0
    implement fun getAt(index: Int): SerdeValue = SerdeString("")
}
