@Header("<stdio.h>")
lib NativeFS {
    fun fopen(path: String, mode: String): Pointer
    fun fread(buffer: Pointer, size: Int, count: Int, stream: Pointer): Int
    fun fwrite(buffer: Pointer, size: Int, count: Int, stream: Pointer): Int
    fun fclose(stream: Pointer): Int
    fun fseek(stream: Pointer, offset: Int, origin: Int): Int
    fun ftell(stream: Pointer): Int
    fun remove(path: String): Int
}

type File(val path: String) {

    fun read(): String {
        val file = NativeFS.fopen(path, "rb")

        if (file == null) {
            print("Error opening file")
            return ""
        }

        NativeFS.fseek(file, 0, 2)
        val size = NativeFS.ftell(file)

        NativeFS.fseek(file, 0, 0)
        val buffer = Standard.gcMalloc(size + 1)
        val read = NativeFS.fread(buffer, 1, size, file)

        NativeFS.fclose(file)
        return String(buffer, size)
    }

    fun write(content: String): Bool {
        val file = NativeFS.fopen(path, "wb")

        if (file == null) {
            return false
        }

        val written = NativeFS.fwrite(content.ptr, 1, content.length, file)
        NativeFS.fclose(file)
        return written == content.length
    }

    fun delete() = NativeFS.remove(path) == 0

    fun exists(): Bool {
        val file = NativeFS.fopen(path, "r")
        if (file == null) {
            return false
        }
        NativeFS.fclose(file)
        return true
    }

} object {
    
    fun read(path: String) = File(path).read()

    fun write(path: String, content: String) = File(path).write(content)

    fun delete(path: String) = File(path).delete()

    fun exists(path: String) = File(path).exists()
}