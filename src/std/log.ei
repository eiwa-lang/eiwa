import { Map, MutableMap, Node } from "std.collections"
import { now, Time } from "std.time"
import { Throwable } from "std.exceptions"
import { println } from "std.io"

enum LogLevel {
    TRACE,
    DEBUG,
    INFO,
    WARN,
    ERROR,
    OFF
}

contract LogFormatter {
    fun format(level: LogLevel, message: String, throwable: Throwable?, fields: Map<String, String>): String
}

skill TextFormatter : LogFormatter {
    fun getAnsiColor(level: LogLevel): String {
        return when (level) {
            LogLevel.TRACE -> "\x1b[35m"
            LogLevel.DEBUG -> "\x1b[90m"
            LogLevel.INFO -> "\x1b[36m"
            LogLevel.WARN -> "\x1b[33m"
            LogLevel.ERROR -> "\x1b[31m"
            else -> "\x1b[0m"
        }
    }

    implement fun format(level: LogLevel, message: String, throwable: Throwable?, fields: Map<String, String>): String {
        val reset = "\x1b[0m"
        val color = this.getAnsiColor(level)
        val timestamp = now().toString()
        val levelStr = level.name

        var result = "[" + timestamp + "] " + color + "[" + levelStr + "]" + reset + " " + message

        if (throwable != null) {
            result = result + " | Error: " + throwable!!.message()
        }

        if (fields.size() > 0) {
            result = result + " {"
            var i = 0
            val capacity = fields.entries.size()
            var first = true
            while (i < capacity) {
                var curr = fields.entries.get(i)
                while (curr != null) {
                    if (first == false) {
                        result = result + ", "
                    }
                    val k = curr!!.key
                    val v = curr!!.value
                    result = result + k + "=" + v
                    first = false
                    curr = curr!!.next
                }
                i = i + 1
            }
            result = result + "}"
        }

        return result
    }
}

skill JsonFormatter : LogFormatter {
    implement fun format(level: LogLevel, message: String, throwable: Throwable?, fields: Map<String, String>): String {
        val timestamp = now().toString()
        val levelStr = level.name

        var json = "{\"timestamp\":\"" + timestamp + "\",\"level\":\"" + levelStr + "\",\"message\":\"" + message + "\""

        if (throwable != null) {
            json = json + ",\"error\":\"" + throwable!!.message() + "\""
        }

        if (fields.size() > 0) {
            var i = 0
            val capacity = fields.entries.size()
            while (i < capacity) {
                var curr = fields.entries.get(i)
                while (curr != null) {
                    val k = curr!!.key
                    val v = curr!!.value
                    json = json + ",\"" + k + "\":\"" + v + "\""
                    curr = curr!!.next
                }
                i = i + 1
            }
        }

        json = json + "}"
        return json
    }
}

type StandardLogFormatter(val useColors: Bool = true) : LogFormatter + TextFormatter
type JsonLogFormatter() : LogFormatter + JsonFormatter

type Logger(
    val fields: Map<String, String> = Map<String, String>(),
    var level: LogLevel = LogLevel.INFO,
    var formatter: LogFormatter = StandardLogFormatter()
) {
    fun setLevel(newLevel: LogLevel) {
        this.level = newLevel
    }

    fun setFormatter(newFormatter: LogFormatter) {
        this.formatter = newFormatter
    }

    fun with(key: String, value: String): Logger {
        val newFields = MutableMap<String, String>()
        var i = 0
        val capacity = this.fields.entries.size()
        while (i < capacity) {
            var curr = this.fields.entries.get(i)
            while (curr != null) {
                newFields.put(curr!!.key, curr!!.value)
                curr = curr!!.next
            }
            i = i + 1
        }
        newFields.put(key, value)
        val child = Logger(newFields.freeze())
        child.level = this.level
        child.formatter = this.formatter
        return child
    }

    fun withFields(extraFields: Map<String, String>): Logger {
        val newFields = MutableMap<String, String>()
        var i = 0
        val cap1 = this.fields.entries.size()
        while (i < cap1) {
            var curr = this.fields.entries.get(i)
            while (curr != null) {
                newFields.put(curr!!.key, curr!!.value)
                curr = curr!!.next
            }
            i = i + 1
        }
        var j = 0
        val cap2 = extraFields.entries.size()
        while (j < cap2) {
            var curr2 = extraFields.entries.get(j)
            while (curr2 != null) {
                newFields.put(curr2!!.key, curr2!!.value)
                curr2 = curr2!!.next
            }
            j = j + 1
        }
        val child = Logger(newFields.freeze())
        child.level = this.level
        child.formatter = this.formatter
        return child
    }

    fun isEnabled(targetLevel: LogLevel): Bool {
        return targetLevel.ordinal >= this.level.ordinal
    }

    fun log(targetLevel: LogLevel, message: String, throwable: Throwable? = null) {
        if (this.isEnabled(targetLevel)) {
            val formatted = this.formatter.format(targetLevel, message, throwable, this.fields)
            println(formatted)
        }
    }

    fun trace(msgFn: () -> String) {
        if (this.isEnabled(LogLevel.TRACE)) {
            val msgStr = msgFn()
            this.log(LogLevel.TRACE, msgStr, null)
        }
    }

    fun debug(msgFn: () -> String) {
        if (this.isEnabled(LogLevel.DEBUG)) {
            val msgStr = msgFn()
            this.log(LogLevel.DEBUG, msgStr, null)
        }
    }

    fun info(msgFn: () -> String) {
        if (this.isEnabled(LogLevel.INFO)) {
            val msgStr = msgFn()
            this.log(LogLevel.INFO, msgStr, null)
        }
    }

    fun warn(msgFn: () -> String) {
        if (this.isEnabled(LogLevel.WARN)) {
            val msgStr = msgFn()
            this.log(LogLevel.WARN, msgStr, null)
        }
    }

    fun warn(throwable: Throwable, msgFn: () -> String) {
        if (this.isEnabled(LogLevel.WARN)) {
            val msgStr = msgFn()
            this.log(LogLevel.WARN, msgStr, throwable)
        }
    }

    fun error(msgFn: () -> String) {
        if (this.isEnabled(LogLevel.ERROR)) {
            val msgStr = msgFn()
            this.log(LogLevel.ERROR, msgStr, null)
        }
    }

    fun error(throwable: Throwable, msgFn: () -> String) {
        if (this.isEnabled(LogLevel.ERROR)) {
            val msgStr = msgFn()
            this.log(LogLevel.ERROR, msgStr, throwable)
        }
    }
}

object Log {
    val rootLogger: Logger = Logger()

    fun setLevel(level: LogLevel) {
        Log.rootLogger.setLevel(level)
    }

    fun setFormatter(formatter: LogFormatter) {
        Log.rootLogger.setFormatter(formatter)
    }

    fun with(key: String, value: String): Logger {
        return Log.rootLogger.with(key, value)
    }

    fun withFields(fields: Map<String, String>): Logger {
        return Log.rootLogger.withFields(fields)
    }

    fun trace(msgFn: () -> String) {
        Log.rootLogger.trace(msgFn)
    }

    fun debug(msgFn: () -> String) {
        Log.rootLogger.debug(msgFn)
    }

    fun info(msgFn: () -> String) {
        Log.rootLogger.info(msgFn)
    }

    fun warn(msgFn: () -> String) {
        Log.rootLogger.warn(msgFn)
    }

    fun warn(throwable: Throwable, msgFn: () -> String) {
        Log.rootLogger.warn(throwable, msgFn)
    }

    fun error(msgFn: () -> String) {
        Log.rootLogger.error(msgFn)
    }

    fun error(throwable: Throwable, msgFn: () -> String) {
        Log.rootLogger.error(throwable, msgFn)
    }
}
