import { Process } from "std.process"
import { printHelp, compilerCommand, initCommand, addCommand, removeCommand, freezeCommand, updateCommand } from "helpers"

init {
    val cmdOpt = Process.argAt(1)
    if (cmdOpt == null) {
        printHelp()
        exit(1)
    }
    val cmd = cmdOpt!!

    when (cmd) {
        "--help", "-h" -> {
            printHelp()
        }
        "build", "run", "test" -> {
            compilerCommand(cmd)
        }
        "init" -> {
            initCommand()
        }
        "add" -> {
            addCommand()
        }
        "remove" -> {
            removeCommand()
        }
        "freeze" -> {
            freezeCommand()
        }
        "update" -> {
            updateCommand()
        }
        else -> {
            println("Unknown command: " + cmd)
            printHelp()
            exit(1)
        }
    }
}
